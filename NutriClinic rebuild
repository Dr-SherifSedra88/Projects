          U.on(host, 'click', '[data-go]', function (e, el) { CN.app.go(el.getAttribute('data-go')); });
          return;
        }

        var version = activeVersion(plan);

        /* ---- generation controls ---- */
        var html = ui.card('pl.generate',
          '<div class="inline-fields">' +
          '<div class="field"><label for="g-duration">' + U.esc(CN.t('pl.duration')) + '</label>' +
