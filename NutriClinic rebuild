  };

  /* ------------------------------------------------------------ layer host */
  var openLayers = [];

  function layerHost() { return util.$('#layer'); }

  function mount(node, opts) {
    var host = layerHost();
    if (!host) return;
    host.hidden = false;
    var scrim = document.createElement('div');
    scrim.className = 'scrim';
    scrim.addEventListener('click', function () {
      if (opts && opts.dismissable === false) return;
      closeTop();
    });
    host.appendChild(scrim);
    host.appendChild(node);
    document.body.style.overflow = 'hidden';
    openLayers.push({ node: node, scrim: scrim });

    // Focus the first meaningful control for keyboard users.
    setTimeout(function () {
      var focusable = node.querySelector(
        'input:not([type=hidden]),select,textarea,button:not(.js-close)');
      if (focusable) focusable.focus();
      else { node.setAttribute('tabindex', '-1'); node.focus(); }
    }, 20);

    return { node: node, scrim: scrim };
  }

  function closeTop() {
    var top = openLayers.pop();
    if (!top) return;
    top.node.remove();
    top.scrim.remove();
    if (!openLayers.length) {
      var host = layerHost();
      if (host) host.hidden = true;
      document.body.style.overflow = '';
    }
    var prev = openLayers[openLayers.length - 1];
    if (prev) prev.node.focus();
