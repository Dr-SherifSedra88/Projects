      '" aria-valuemin="0" aria-valuemax="100"><i style="width:' + U.round(f * 100, 1) + '%"></i></div>';
  }

  /** Legend markup matching the series colours. */
  function legend(entries) {
    return '<div class="legend">' + (entries || []).map(function (e) {
      return '<span><i class="' + (e.tone || 'navy') + '"></i>' + esc(e.label) + '</span>';
    }).join('') + '</div>';
  }

  CN.charts = {
    colors: C,
    series: SERIES,
    line: line,
    bar: bar,
    donut: donut,
    sparkline: sparkline,
    barHtml: barHtml,
