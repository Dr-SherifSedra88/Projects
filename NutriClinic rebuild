        }

        function updateCompat() {
          var codes = selectedApproaches();
          var el = U.$('#g-compat');
          if (!el) return;
          if (codes.length < 2) { el.innerHTML = ''; return; }
          var ev = CN.approaches.evaluate(codes);
          el.innerHTML = ev.pairs.map(function (p) {
