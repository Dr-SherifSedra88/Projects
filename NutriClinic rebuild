            return '<tr><td>' + U.esc(L('rest.' + r.kind)) + '</td><td>' +
              U.esc(CN.foods.allergenLabel(r.substance, CN.i18n.lang)) + '</td>' +
              '<td class="right"><button class="btn btn-xs" type="button" data-r-del="' + i + '">' +
              CN.icon('trash', 13) + '</button></td></tr>';
          }).join('') + '</tbody></table></div>';
      }
      drawRestrictions();

      U.on(host, 'click', '#r-add', function () {
        var kind = U.$('#r-kind').value;
        var substance = (U.$('#r-substance').value || '').trim();
        if (!substance) return;
        restrictions.push({ kind: kind, substance: substance, diagnosed: kind === 'allergy' });
        U.$('#r-substance').value = '';
        drawRestrictions();
      });
      U.on(host, 'click', '[data-r-del]', function (e, el) {
        restrictions.splice(Number(el.getAttribute('data-r-del')), 1);
        drawRestrictions();
      });

      /* ---- live BMI ---- */
      function updateBmi() {
        var h = U.parseNum(U.$('#m-heightCm').value);
        var w = U.parseNum(U.$('#m-weightKg').value);
        var el = U.$('#live-bmi');
        if (!el) return;
        var b = CN.engine.bmi(h, w);
        if (b === null) { el.textContent = ''; return; }
        var c = CN.engine.bmiClass(b);
        el.innerHTML = 'BMI <strong>' + U.nf(b, 1) + '</strong> · ' +
          U.esc(CN.i18n.lang === 'ar' ? c.ar : c.en) +
          (h ? ' · ' + U.esc(L('bc.whr')) + ' ' + (CN.engine.whr(U.parseNum(U.$('#m-waistCm').value), U.parseNum(U.$('#m-hipCm').value)) || '—') : '');
      }
      ['m-heightCm', 'm-weightKg', 'm-waistCm', 'm-hipCm'].forEach(function (id) {
        U.on(host, 'input', '#' + id, updateBmi);
