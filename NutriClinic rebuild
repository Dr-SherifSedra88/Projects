      id: existing ? existing.id : null,
      nameEn: existing ? existing.nameEn : '',
      servings: existing ? existing.servings : 4,
      yieldG: existing ? existing.yieldG : '',
      method: existing ? existing.method : '',
      items: (existing && existing.items)
        ? existing.items.map(function (i) { return { foodId: i.foodId, grams: i.grams }; })
        : [{ foodId: '', grams: 100 }]
    };

    var allFoods = CN.foods.items.slice().sort(function (a, b) {
      return a.nameEn.localeCompare(b.nameEn);
    });

    function foodOptions(sel) {
      return '<option value="">—</option>' + allFoods.map(function (f) {
        return '<option value="' + U.esc(f.id) + '"' + (f.id === sel ? ' selected' : '') + '>' +
          U.esc(f.nameEn) + '</option>';
      }).join('');
    }

    function rowsHtml() {
      return model.items.map(function (it, i) {
        return '<tr data-ri="' + i + '">' +
          '<td><select data-f="foodId" style="min-width:200px">' + foodOptions(it.foodId) +
            '</select></td>' +
          '<td><input type="number" step="5" data-f="grams" value="' + U.esc(it.grams) +
            '" style="width:90px"/></td>' +
          '<td class="num" data-cell-kcal="' + i + '"></td>' +
          '<td class="right"><button type="button" class="btn btn-xs" data-rc-row-del="' + i +
            '">' + CN.icon('x', 12) + '</button></td></tr>';
      }).join('');
    }

    function harvest(node) {
      U.$$('#rc-rows tr', node).forEach(function (tr) {
        var i = Number(tr.getAttribute('data-ri'));
        if (!model.items[i]) return;
        U.$$('[data-f]', tr).forEach(function (inp) {
          var f = inp.getAttribute('data-f');
          model.items[i][f] = (f === 'grams') ? U.parseNum(inp.value) : inp.value;
        });
      });
    }

    function refresh(node) {
      model.items.forEach(function (it, i) {
        var cell = U.$('[data-cell-kcal="' + i + '"]', node);
        if (!cell) return;
        var n = CN.planner.ingredientNutrition(it.foodId, it.grams);
        cell.textContent = n ? U.nf(n.kcal, 0) + ' kcal' : '—';
      });

      var n = CN.planner.recipeNutrition(model);
      var out = U.$('#rc-nutrition', node);
      if (!out) return;
      out.innerHTML = '<div class="grid cols-3 mb1">' +
        '<div class="stat accent"><div class="stat-label">' + U.esc(CN.t('rc.perServing')) +
          '</div><div class="stat-value">' + U.nf(n.perServing.kcal, 0) + ' <small>kcal</small></div>' +
          '<div class="stat-foot">' + (n.servingG
            ? U.nf(n.servingG, 0) + ' g' : U.esc(CN.t('common.notSet'))) + '</div></div>' +
        '<div class="stat"><div class="stat-label">' + U.esc(CN.t('rc.total')) +
          '</div><div class="stat-value">' + U.nf(n.total.kcal, 0) + ' <small>kcal</small></div>' +
          '<div class="stat-foot">' + U.nf(n.servings, 1) + ' × ' + U.esc(CN.t('rc.servings')) +
          '</div></div>' +
        '<div class="stat"><div class="stat-label">' + U.esc(CN.t('en.macro')) +
          '</div><div class="stat-value" style="font-size:1rem">P ' + U.nf(n.perServing.protein, 1) +
          ' · C ' + U.nf(n.perServing.carb, 1) + ' · F ' + U.nf(n.perServing.fat, 1) + '</div>' +
          '<div class="stat-foot">' + U.esc(CN.t('rc.perServing')) + '</div></div></div>' +
        (n.missingFoodIds.length ? ui.notice(CN.t('fd.verify'), 'warn') : '');
    }

    var body = '<div class="inline-fields">' +
      '<div class="field"><label for="rc-name">' + U.esc(CN.t('rc.name')) + ' *</label>' +
        '<input id="rc-name" type="text" value="' + U.esc(model.nameEn) + '"/></div>' +
      '<div class="field"><label for="rc-servings">' + U.esc(CN.t('rc.servings')) + '</label>' +
        '<input id="rc-servings" type="number" min="1" step="1" value="' +
        U.esc(model.servings) + '"/></div>' +
      '<div class="field"><label for="rc-yield">' + U.esc(CN.t('rc.yield')) + ' (g)</label>' +
        '<input id="rc-yield" type="number" step="10" value="' + U.esc(model.yieldG) + '"/></div>' +
      '</div>' +
      '<div class="field"><label>' + U.esc(CN.t('rc.ingredients')) + '</label>' +
        '<div class="table-wrap"><table class="tbl compact"><thead><tr>' +
        '<th>' + U.esc(CN.t('fd.title')) + '</th><th>' + U.esc(CN.t('fd.grams')) + '</th>' +
        '<th class="num">' + U.esc(CN.t('common.kcal')) + '</th><th></th></tr></thead>' +
        '<tbody id="rc-rows">' + rowsHtml() + '</tbody></table></div>' +
        '<button type="button" class="btn btn-sm" id="rc-add-row" style="margin-top:.5rem">' +
          CN.icon('plus', 14) + ' ' + U.esc(CN.t('rc.addIngredient')) + '</button></div>' +
      '<div id="rc-nutrition"></div>' +
      '<div class="field"><label for="rc-method">' + U.esc(CN.t('rc.method')) + '</label>' +
        '<textarea id="rc-method">' + U.esc(model.method) + '</textarea></div>';

    var ref = CN.modal({
      title: isNew ? CN.t('rc.new') : CN.t('rc.name'),
      wide: true, body: body,
      actions: [
        { label: CN.t('common.cancel'), kind: 'ghost' },
        { label: CN.t('common.save'), kind: 'primary', close: false,
          onClick(node) {
            harvest(node);
            var name = (U.$('#rc-name', node).value || '').trim();
            if (!name) { CN.toast(CN.t('common.noData'), 'warn'); return false; }
            var items = model.items.filter(function (i) { return i.foodId && i.grams > 0; });
            if (!items.length) { CN.toast(CN.t('rc.needIngredients'), 'warn'); return false; }

            CN.store.put('recipes', {
              id: model.id || U.uid('rcp'),
              nameEn: name,
              servings: U.parseNum(U.$('#rc-servings', node).value) || 1,
              yieldG: U.parseNum(U.$('#rc-yield', node).value) || null,
              method: U.$('#rc-method', node).value,
              items: items,
              createdAt: (existing && existing.createdAt) || new Date().toISOString()
            }).then(function () {
              CN.toast(CN.t('rc.saved'));
              CN.bus.emit('recipe-saved');
              ref.close();
            });
            return false;
          } }
      ]
    });

    function redrawRows(node) {
      U.$('#rc-rows', node).innerHTML = rowsHtml();
      refresh(node);
    }

    U.on(ref.node, 'input', '#rc-rows input, #rc-rows select, #rc-servings, #rc-yield',
      U.debounce(function () {
        harvest(ref.node);
        model.servings = U.parseNum(U.$('#rc-servings', ref.node).value) || 1;
        model.yieldG = U.parseNum(U.$('#rc-yield', ref.node).value) || 0;
        refresh(ref.node);
      }, 150));

    U.on(ref.node, 'click', '#rc-add-row', function () {
      harvest(ref.node);
      model.items.push({ foodId: '', grams: 100 });
      redrawRows(ref.node);
    });

    U.on(ref.node, 'click', '[data-rc-row-del]', function (e, el) {
      harvest(ref.node);
      if (model.items.length <= 1) return;
      model.items.splice(Number(el.getAttribute('data-rc-row-del')), 1);
      redrawRows(ref.node);
    });

    refresh(ref.node);
  }

  CN.views = CN.views || {};
  CN.views.foods = Foods;
  CN.views.references = Refs;
})();

