  function conflicts(food, exclusions) {
    if (!food || !exclusions || !exclusions.length) return [];
    var ex = exclusions.map(function (e) { return String(e).toLowerCase(); });
    return (food.allergens || []).filter(function (a) { return ex.indexOf(a) !== -1; });
  }

  function matchesQuery(food, q) {
    if (!q) return true;
    var s = q.trim().toLowerCase();
    if (!s) return true;
    return food.nameEn.toLowerCase().indexOf(s) !== -1 ||
      (food.nameAr || '').indexOf(q.trim()) !== -1 ||
      food.category.indexOf(s) !== -1 ||
      food.id.indexOf(s) !== -1;
  }

