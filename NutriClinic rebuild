  dose            text,
  frequency       text,
  started_at      date,
  stopped_at      date,
  is_current      boolean NOT NULL DEFAULT true,
  notes           text,
  recorded_by     uuid REFERENCES app_user(id),
  recorded_at     timestamptz NOT NULL DEFAULT now()
);
CREATE INDEX ON medication (patient_id, is_current);

CREATE TABLE supplement (
  id              uuid PRIMARY KEY DEFAULT gen_random_uuid(),
  patient_id      uuid NOT NULL REFERENCES patient(id) ON DELETE CASCADE,
  name            text NOT NULL,
  dose            text,
  frequency       text,
  started_at      date,
  stopped_at      date,
  recorded_by     uuid REFERENCES app_user(id),
  recorded_at     timestamptz NOT NULL DEFAULT now()
);

-- Allergies, intolerances and preferences are distinguished, never conflated.
CREATE TABLE restriction (
  id              uuid PRIMARY KEY DEFAULT gen_random_uuid(),
  patient_id      uuid NOT NULL REFERENCES patient(id) ON DELETE CASCADE,
  kind            restriction_kind_t NOT NULL,
  substance       text NOT NULL,              -- e.g. 'milk', 'gluten', 'peanut'
  severity        text,                       -- 'mild' | 'moderate' | 'severe' | 'anaphylaxis'
  is_diagnosed    boolean NOT NULL DEFAULT false,
  reaction        text,
  notes           text,
  recorded_by     uuid REFERENCES app_user(id),
  recorded_at     timestamptz NOT NULL DEFAULT now()
);
CREATE INDEX ON restriction (patient_id, kind);

CREATE TABLE lifestyle_assessment (
  id              uuid PRIMARY KEY DEFAULT gen_random_uuid(),
  patient_id      uuid NOT NULL REFERENCES patient(id) ON DELETE CASCADE,
  assessment_date date NOT NULL DEFAULT current_date,
  activity_level  text,                       -- sedentary .. extremely_active
  exercise_freq   text,
  sleep_hours     numeric(4,1),
  smoking_status  text,
  water_intake_ml integer,
  meal_count      smallint,
  eating_habits   text,
  food_preferences text,
  disliked_foods  text,
  cultural_notes  text,
  food_budget     text,
  cooking_limits  text,
  recorded_by     uuid REFERENCES app_user(id),
  created_at      timestamptz NOT NULL DEFAULT now()
);
CREATE INDEX ON lifestyle_assessment (patient_id, assessment_date DESC);

-- ---------------------------------------------------------------------------
-- Anthropometry — one immutable row per measurement event
-- ---------------------------------------------------------------------------
CREATE TABLE measurement (
  id              uuid PRIMARY KEY DEFAULT gen_random_uuid(),
  patient_id      uuid NOT NULL REFERENCES patient(id) ON DELETE CASCADE,
  measured_at     timestamptz NOT NULL DEFAULT now(),
  height_cm       numeric(5,1),
  weight_kg       numeric(6,2),
  target_weight_kg numeric(6,2),
  bmi             numeric(5,2),               -- stored for reference; recomputed by engine
  waist_cm        numeric(5,1),
  hip_cm          numeric(5,1),
  body_fat_pct    numeric(4,1),
  muscle_mass_kg  numeric(5,2),
  visceral_fat    numeric(5,1),
  total_body_water_pct numeric(4,1),
  source          text CHECK (source IN ('clinic_scale','bioimpedance','patient_reported','device')),
  device_name     text,
  notes           text,
  recorded_by     uuid REFERENCES app_user(id),
  created_at      timestamptz NOT NULL DEFAULT now()
);
CREATE INDEX ON measurement (patient_id, measured_at DESC);

-- ---------------------------------------------------------------------------
-- Laboratory results — units and reference ranges travel with each result
-- ---------------------------------------------------------------------------
CREATE TABLE lab_panel (
  id              uuid PRIMARY KEY DEFAULT gen_random_uuid(),
  patient_id      uuid NOT NULL REFERENCES patient(id) ON DELETE CASCADE,
  collected_on    date NOT NULL,
  laboratory_name text,
  fasting         boolean,
  attachment_id   uuid,                       -- -> asset(id)
  notes           text,
  created_at      timestamptz NOT NULL DEFAULT now()
);
CREATE INDEX ON lab_panel (patient_id, collected_on DESC);

CREATE TABLE lab_result (
  id              uuid PRIMARY KEY DEFAULT gen_random_uuid(),
  panel_id        uuid NOT NULL REFERENCES lab_panel(id) ON DELETE CASCADE,
  analyte         text NOT NULL,              -- 'hba1c', 'ldl', 'egfr', 'tsh', 'vitamin_d', ...
  value_numeric   numeric,
  value_text      text,                       -- non-numeric results
  unit            text,
  ref_low         numeric,
  ref_high        numeric,
  ref_text        text,                       -- lab-specific ranges
  flag            lab_flag_t NOT NULL DEFAULT 'unknown',
  -- Deliberately NOT an interpretation. Brief §4: abnormal results must not be
  -- presented as confirmed diagnoses.
  clinician_note  text,
  created_at      timestamptz NOT NULL DEFAULT now()
);
CREATE INDEX ON lab_result (panel_id, analyte);

-- ---------------------------------------------------------------------------
-- Energy assessment — inputs and formula stored with every result
-- ---------------------------------------------------------------------------
CREATE TABLE energy_assessment (
  id              uuid PRIMARY KEY DEFAULT gen_random_uuid(),
  patient_id      uuid NOT NULL REFERENCES patient(id) ON DELETE CASCADE,
  measurement_id  uuid REFERENCES measurement(id) ON DELETE SET NULL,
  assessed_at     timestamptz NOT NULL DEFAULT now(),
  formula         formula_t NOT NULL,
  formula_version text NOT NULL DEFAULT '1',
  bmr_kcal        numeric(7,2) NOT NULL,
  bmr_is_estimated boolean NOT NULL DEFAULT true,   -- false for device-reported (§5 step 1)
  activity_factor numeric(4,3) NOT NULL,
  activity_label  text,
  tdee_kcal       numeric(7,2) NOT NULL,
  goal            goal_t NOT NULL,
  suggested_delta_kcal integer,               -- negative = deficit, positive = surplus
  target_kcal     numeric(7,2),
  delta_rationale text,
  safety_flags    jsonb NOT NULL DEFAULT '[]'::jsonb,  -- e.g. pregnancy, CKD, eating disorder
  requires_review boolean NOT NULL DEFAULT false,
  approved_by     uuid REFERENCES app_user(id),        -- NULL until clinician approves
  approved_at     timestamptz,
  superseded_by   uuid REFERENCES energy_assessment(id),
  created_at      timestamptz NOT NULL DEFAULT now(),
  -- A target is only usable once a clinician has approved it.
  CONSTRAINT target_requires_approval
    CHECK (target_kcal IS NULL OR approved_by IS NOT NULL)
);
CREATE INDEX ON energy_assessment (patient_id, assessed_at DESC);

CREATE TABLE macro_target (
  id              uuid PRIMARY KEY DEFAULT gen_random_uuid(),
  energy_assessment_id uuid NOT NULL REFERENCES energy_assessment(id) ON DELETE CASCADE,
  protein_g       numeric(6,1),
  protein_per_kg  numeric(4,2),
  carb_g          numeric(6,1),
  carb_pct        numeric(4,1),
  fat_g           numeric(6,1),
  fat_pct         numeric(4,1),
  fiber_g         numeric(6,1),
  sodium_mg       numeric(7,1),
  fluid_ml        integer,
  method          text CHECK (method IN ('percent', 'per_kg', 'hybrid')),
  notes           text,
  created_at      timestamptz NOT NULL DEFAULT now()
);

-- ---------------------------------------------------------------------------
-- Therapeutic approaches — the 20 from brief §7
-- ---------------------------------------------------------------------------
CREATE TABLE dietary_approach (
  code            text PRIMARY KEY,           -- 'mediterranean', 'dash', 'ketogenic', ...
  name_en         text NOT NULL,
  name_ar         text,
  description     text,
  evidence_tier   evidence_tier_t NOT NULL DEFAULT 'clinical_guideline',
  is_custom       boolean NOT NULL DEFAULT false,
  created_at      timestamptz NOT NULL DEFAULT now()
);

-- Pairwise compatibility, so combinations can be validated (§7).
CREATE TABLE approach_compatibility (
  approach_a      text NOT NULL REFERENCES dietary_approach(code) ON DELETE CASCADE,
  approach_b      text NOT NULL REFERENCES dietary_approach(code) ON DELETE CASCADE,
  is_compatible   boolean NOT NULL,
  rationale       text NOT NULL,              -- why compatible / why not
  PRIMARY KEY (approach_a, approach_b),
  CHECK (approach_a < approach_b)             -- store each unordered pair once
);

-- Contraindications, checked before a plan may be generated (§7 safety).
CREATE TABLE approach_contraindication (
  id              uuid PRIMARY KEY DEFAULT gen_random_uuid(),
  approach_code   text NOT NULL REFERENCES dietary_approach(code) ON DELETE CASCADE,
  condition_label text NOT NULL,
  severity        text NOT NULL CHECK (severity IN ('absolute','relative','caution')),
  rationale       text NOT NULL
);

CREATE TABLE patient_approach (
  patient_id      uuid NOT NULL REFERENCES patient(id) ON DELETE CASCADE,
  approach_code   text NOT NULL REFERENCES dietary_approach(code) ON DELETE RESTRICT,
  selected_at     timestamptz NOT NULL DEFAULT now(),
  selected_by     uuid REFERENCES app_user(id),
  is_active       boolean NOT NULL DEFAULT true,
  PRIMARY KEY (patient_id, approach_code, selected_at)
);

-- ---------------------------------------------------------------------------
-- Food composition — bilingual, with Egyptian household portions (brief §13)
-- ---------------------------------------------------------------------------
CREATE TABLE food (
  id              uuid PRIMARY KEY DEFAULT gen_random_uuid(),
  name_en         text NOT NULL,
  name_ar         text,
  category        text,
  -- Nutrients are per 100 g; household portions carry their own gram weights.
  kcal_100g       numeric(7,2) NOT NULL,
  protein_100g    numeric(6,2),
  carb_100g       numeric(6,2),
  fat_100g        numeric(6,2),
  fiber_100g      numeric(6,2),
  sugar_100g      numeric(6,2),
  sodium_mg_100g  numeric(8,2),
  micros          jsonb NOT NULL DEFAULT '{}'::jsonb,
  -- Allergen tags drive hard exclusion in plan generation (§8).
  allergens       text[] NOT NULL DEFAULT '{}',
  is_egyptian     boolean NOT NULL DEFAULT false,
  data_source     text NOT NULL,              -- provenance is mandatory
  source_ref      text,
  -- Set when ingredient composition is incomplete (composite dishes, sauces):
  -- such foods are flagged for verification, never silently declared safe.
  needs_verification boolean NOT NULL DEFAULT false,
  created_at      timestamptz NOT NULL DEFAULT now(),
  updated_at      timestamptz NOT NULL DEFAULT now()
);
CREATE INDEX ON food (name_en);
CREATE INDEX ON food USING gin (allergens);
CREATE INDEX ON food (is_egyptian) WHERE is_egyptian;

-- Household measures: tbsp, tsp, cup, piece, slice, loaf, half_loaf, g, ml.
-- Every household portion MUST document its gram assumption (brief §13).
CREATE TABLE food_portion (
  id              uuid PRIMARY KEY DEFAULT gen_random_uuid(),
  food_id         uuid NOT NULL REFERENCES food(id) ON DELETE CASCADE,
  measure         text NOT NULL,
  label_en        text NOT NULL,
  label_ar        text,
  grams           numeric(7,2) NOT NULL CHECK (grams > 0),
  assumption_note text NOT NULL,
  is_default      boolean NOT NULL DEFAULT false,
  UNIQUE (food_id, measure, grams)
);

CREATE TABLE recipe (
  id              uuid PRIMARY KEY DEFAULT gen_random_uuid(),
  name_en         text NOT NULL,
  name_ar         text,
  servings        numeric(5,2),
  yield_g         numeric(7,2),
  method          text,
  notes           text,
  created_by      uuid REFERENCES app_user(id),
  created_at      timestamptz NOT NULL DEFAULT now()
);

CREATE TABLE recipe_item (
  recipe_id       uuid NOT NULL REFERENCES recipe(id) ON DELETE CASCADE,
  food_id         uuid NOT NULL REFERENCES food(id) ON DELETE RESTRICT,
  grams           numeric(7,2) NOT NULL,
  PRIMARY KEY (recipe_id, food_id)
);

-- ---------------------------------------------------------------------------
-- Diet plans — versioned, never mutated in place (brief §14, §16)
-- ---------------------------------------------------------------------------
CREATE TABLE plan (
  id              uuid PRIMARY KEY DEFAULT gen_random_uuid(),
  patient_id      uuid NOT NULL REFERENCES patient(id) ON DELETE CASCADE,
  title           text,
  created_by      uuid REFERENCES app_user(id),
  created_at      timestamptz NOT NULL DEFAULT now()
);

CREATE TABLE plan_version (
  id              uuid PRIMARY KEY DEFAULT gen_random_uuid(),
  plan_id         uuid NOT NULL REFERENCES plan(id) ON DELETE CASCADE,
  version_no      integer NOT NULL,
  status          plan_status_t NOT NULL DEFAULT 'draft',
  energy_assessment_id uuid REFERENCES energy_assessment(id) ON DELETE SET NULL,
  duration_days   smallint NOT NULL DEFAULT 7 CHECK (duration_days > 0),
  starts_on       date,
  -- Generation provenance: which approaches were combined, and the diff vs parent.
  approach_codes  text[] NOT NULL DEFAULT '{}',
  generated_by    text NOT NULL CHECK (generated_by IN ('engine','copilot_draft','clinician','template')),
  parent_version_id uuid REFERENCES plan_version(id),
