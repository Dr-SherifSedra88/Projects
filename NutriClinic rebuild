          var approvedMacros = CN.engine.normaliseMacros(approved.macros, approved.targetKcal);
          var macro = recomputed;
          var macrosSource = 'recomputed';
          var macrosNote = null;

          if (approvedMacros && approvedMacros.complete) {
            macro = approvedMacros;
