    /* ------------------------------------------------------------ backup --- */
    /**
     * Backup. Attachment binaries ARE included, base64-encoded, so a restore is
     * lossless. Base64 inflates the payload by roughly a third; the envelope
     * reports what was carried and flags anything that could not be read.
     */
    backup() {
      var clinicalSource = remoteBackend ? remoteBackend.raw() : localBackend.raw();
      return Promise.all([clinicalSource, localBackend.raw(), loadSettings()]).then(function (r) {
        // In server mode clinical records come from the server and settings from
        // this device. Locally, one source serves everything.
        var data = {};
        STORES.forEach(function (s) {
          data[s] = (remoteBackend && s !== 'settings') ? (r[0][s] || []) : (r[1][s] || []);
        });
        var list = data.attachments || [];
        var included = 0, failed = 0, bytes = 0;

        return Promise.all(list.map(function (a) {
          var meta = Object.assign({}, a);
          delete meta.blob;
          if (!a.blob) { meta.contentIncluded = false; return meta; }
          return blobToDataUrl(a.blob).then(function (d) {
            meta.dataUrl = d;
            meta.contentIncluded = true;
            included++;
            bytes += a.blob.size || 0;
            return meta;
          }).catch(function () {
            meta.contentIncluded = false;
            failed++;
            return meta;
          });
        })).then(function (attachments) {
          data.attachments = attachments;
          return JSON.stringify({
            app: 'NutriClinic Pro',
            schema: DB_VERSION,
            exportedAt: new Date().toISOString(),
            engine: remoteBackend ? 'supabase' : engineName,
            attachments: included
              ? { count: included, bytes: bytes, encoding: 'base64' }
              : { count: 0 },
            excluded: failed ? [failed + ' attachment file(s) could not be read'] : [],
            settings: r[2],
            data: data
          }, null, 2);
        });
      });
    },

    /** Replace everything from a backup document. Validates before wiping. */
    restore(jsonText) {
      var parsed;
      try { parsed = JSON.parse(jsonText); }
      catch (e) { return Promise.reject(new Error('That file is not valid JSON.')); }

      if (!parsed || parsed.app !== 'NutriClinic Pro' || !parsed.data) {
        return Promise.reject(new Error('That file is not a NutriClinic Pro backup.'));
      }
      if (Number(parsed.schema) > DB_VERSION) {
        return Promise.reject(new Error('This backup was written by a newer version of the app.'));
      }

      var snap = {};
      STORES.forEach(function (s) {
        snap[s] = Array.isArray(parsed.data[s]) ? parsed.data[s] : [];
      });

      // Rebuild attachment binaries from the encoded payload. A record whose
      // content was absent (an older, metadata-only backup) is kept without a
      // blob so the interface can ask for the document to be re-attached.
      snap.attachments = (parsed.data.attachments || []).map(function (a) {
        var copy = Object.assign({}, a);
        if (copy.dataUrl) {
          copy.blob = dataUrlToBlob(copy.dataUrl);
          copy.contentIncluded = !!copy.blob;
          delete copy.dataUrl;
        } else {
          copy.blob = null;
          copy.contentIncluded = false;
        }
        return copy;
      });

      snap.settings = [];
      if (parsed.settings) snap.settings = [Object.assign({}, DEFAULTS, parsed.settings)];

      if (!remoteBackend) {
        return localBackend.load(snap).then(function () {
          CN.bus.emit('data', { action: 'restore' });
          return true;
        });
      }

      // Server mode: clinical data goes to the server, settings stay on device.
      var clinicalSnap = {}, settingsSnap = {};
      STORES.forEach(function (s) {
        clinicalSnap[s] = (s === 'settings') ? [] : (snap[s] || []);
        settingsSnap[s] = (s === 'settings') ? (snap.settings || []) : [];
      });
      return remoteBackend.load(clinicalSnap)
        .then(function () { return localBackend.load(settingsSnap); })
        .then(function () {
          CN.bus.emit('data', { action: 'restore' });
          return true;
        });
    },

    wipe() {
      var tasks = [localBackend.wipe()];
      if (remoteBackend) tasks.push(remoteBackend.wipe());
      return Promise.all(tasks).then(function () {
        CN.bus.emit('data', { action: 'wipe' });
        return true;
      });
