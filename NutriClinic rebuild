  /** Grams of `food` that supply `kcal` — the 100-kcal exchange portion. */
  function gramsForKcal(food, kcal) {
    if (!food || !food.kcal) return null;
    return CN.util.round((kcal || 100) * 100 / food.kcal, 1);
  }

  /** Nutrients contained in an arbitrary gram weight. */
  function nutrientsFor(food, grams) {
    var k = (Number(grams) || 0) / 100;
    return {
      kcal: CN.util.round(food.kcal * k, 1),
      protein: CN.util.round(food.protein * k, 1),
      carb: CN.util.round(food.carb * k, 1),
      fat: CN.util.round(food.fat * k, 1),
      fiber: CN.util.round(food.fiber * k, 1),
      sodium: CN.util.round(food.sodium * k, 1)
    };
  }

  /** Fractional quantity of a household measure, e.g. 1.5 cups. */
  function household(food, grams) {
    if (!food || !food.portions || !food.portions.length) return null;
    var best = null;
    food.portions.forEach(function (p) {
      if (p.measure === 'g') return;
      var qty = grams / p.grams;
      // Prefer a human-scale fraction (>= 0.5) of a familiar measure.
      if (qty >= 0.5 && (!best || qty < best.qty)) best = { portion: p, qty: CN.util.round(qty, 1) };
    });
    if (!best) return null;
    return {
      measure: best.portion.measure,
      measureAr: best.portion.measureAr,
      qty: best.qty,
      labelEn: best.qty + ' × ' + best.portion.labelEn,
      labelAr: best.qty + ' × ' + best.portion.measureAr
    };
  }

