    var stroke = C[opts.tone || 'navy'] || C.navy;
    return '<svg viewBox="0 0 ' + W + ' ' + H + '" width="' + W + '" height="' + H +
      '" aria-hidden="true"><path d="' + d + '" fill="none" stroke="' + stroke +
      '" stroke-width="1.8" stroke-linejoin="round" stroke-linecap="round"/></svg>';
