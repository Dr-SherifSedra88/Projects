    var R = size / 2, r = R * 0.62, cx = R, cy = R;
    var angle = -Math.PI / 2;

    var out = ['<svg class="chart" viewBox="0 0 ' + size + ' ' + size + '" width="' + size +
      '" height="' + size + '" role="img">'];

    segs.forEach(function (s, i) {
      var frac = Number(s.value) / total;
      var a2 = angle + frac * Math.PI * 2;
      var large = frac > 0.5 ? 1 : 0;
      var x1 = cx + R * Math.cos(angle), y1 = cy + R * Math.sin(angle);
      var x2 = cx + R * Math.cos(a2), y2 = cy + R * Math.sin(a2);
      var x3 = cx + r * Math.cos(a2), y3 = cy + r * Math.sin(a2);
      var x4 = cx + r * Math.cos(angle), y4 = cy + r * Math.sin(angle);
      var tone = s.tone || SERIES[i % SERIES.length];
      var fill = C[tone] || C.navy;

