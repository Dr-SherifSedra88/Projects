  /* --------------------------------------------------------------- public --- */
  function probeLocalStorage() {
    try {
      var k = '__cn_probe__';
      localStorage.setItem(k, '1');
      localStorage.removeItem(k);
      return true;
    } catch (e) { return false; }
  }

  function initAdapter() {
    return openIDB().then(function (db) {
      localBackend = IndexedDbAdapter(db);
      engineName = 'indexeddb';
    }).catch(function (err) {
      // IndexedDB is commonly unavailable on file:// origins. localStorage at
      // least keeps records across reloads, which is what makes a double-clicked
      // index.html usable rather than a demo that forgets everything.
      if (probeLocalStorage()) {
        localBackend = LocalStorageAdapter();
        engineName = 'localstorage';
        if (window.console) {
          console.warn('[NutriClinic] IndexedDB unavailable (' + (err && err.message) +
            ') — using localStorage so records persist.');
        }
      } else {
        localBackend = MemoryAdapter();
        engineName = 'memory';
        if (window.console) {
          console.warn('[NutriClinic] falling back to an in-memory store:', err && err.message);
        }
      }
    });
  }

  function byPatient(store, patientId) {
    return backendFor(store).all(store).then(function (rows) {
      return rows.filter(function (r) { return r.patientId === patientId; });
    });
  }

  var store = {
    /** Resolves when the storage backend is chosen and usable. */
    ready() {
      if (!readyPromise) readyPromise = initAdapter();
      return readyPromise;
    },
    get engine() { return engineName; },
    isPersistent() { return engineName !== 'memory'; },

    /**
     * What this storage tier can actually do, so the interface never promises
     * more than the environment can keep.
     */
    capabilities() {
      var eff = remoteBackend ? 'supabase' : engineName;
      return {
        engine: eff,
        persistent: eff !== 'memory',
        fullDocumentStorage: eff === 'indexeddb' || eff === 'supabase',
        // In server mode documents live in private object storage, so browser
        // quota is irrelevant.
        documentsInObjectStorage: eff === 'supabase',
        maxAttachmentBytes: (eff === 'indexeddb' || eff === 'supabase')
          ? 8 * 1024 * 1024 : 1500 * 1024,
        label: eff === 'supabase' ? 'st.storageServer'
          : (eff === 'indexeddb' ? 'st.storageIdb'
            : (eff === 'localstorage' ? 'st.storageLocal' : 'st.storageMemory'))
      };
    },

    // A failed write must be VISIBLE. Every view calls put() and most ignore
    // rejections, so failures are announced centrally here rather than relying
    // on twenty-five call sites to each remember a catch block. A clinician
    // must never believe a record was saved when it was not.
    all(s) {
      return backendFor(s).all(s).catch(function (e) {
        CN.bus.emit('store-error', { action: 'read', store: s, error: e });
        throw e;
      });
    },
    get(s, id) {
      return backendFor(s).get(s, id).catch(function (e) {
        CN.bus.emit('store-error', { action: 'read', store: s, id: id, error: e });
        throw e;
      });
    },
    put(s, obj) {
      if (!obj || typeof obj !== 'object') {
        var bad = new Error('Nothing was saved: a record must be an object.');
        CN.bus.emit('store-error', { action: 'put', store: s, error: bad });
        return Promise.reject(bad);
      }
      if (!obj.id) obj.id = U.uid(s.slice(0, 3));
      // The store name MUST be forwarded. An earlier version of this line read
      // `backend.put(obj)` — one argument — which passed the record itself as
      // the store name and left the row undefined, so every write in the
      // application either threw (IndexedDB) or silently discarded the record
      // (localStorage and memory). Nothing could ever have been saved.
      return backendFor(s).put(s, obj).catch(function (e) {
        CN.bus.emit('store-error', { action: 'put', store: s, id: obj.id, error: e });
        throw e;
      });
    },
    del(s, id) {
      return backendFor(s).del(s, id).catch(function (e) {
        CN.bus.emit('store-error', { action: 'delete', store: s, id: id, error: e });
        throw e;
      });
    },
    clear(s) {
      return backendFor(s).clear(s).catch(function (e) {
        CN.bus.emit('store-error', { action: 'clear', store: s, error: e });
        throw e;
      });
    },
    byPatient: byPatient,

    settings() { return loadSettings(); },
    saveSettings: saveSettings,

