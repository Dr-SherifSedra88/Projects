  CN.toast = function (msg, type, ms) {
    var host = util.$('#toasts');
    if (!host) return;
    var el = document.createElement('div');
    el.className = 'toast ' + (type || 'ok');
    var ic = type === 'alert' ? 'alert' : (type === 'warn' ? 'alert' : 'check');
    el.innerHTML = CN.icon(ic, 16) + '<div>' + util.esc(msg) + '</div>';
    host.appendChild(el);
    setTimeout(function () {
      el.style.transition = 'opacity .2s ease';
