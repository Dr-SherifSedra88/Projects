  /* --------------------------------------------------------- plan storage -- */
  /** The patient's plan document, or null when none exists yet. */
  function loadPlan(patientId) {
    return CN.store.byPatient('plans', patientId).then(function (rows) {
      return rows[0] || null;
    });
  }

  function activeVersion(plan) {
    if (!plan || !plan.versions || !plan.versions.length) return null;
    return plan.versions.filter(function (v) { return v.id === plan.activeVersionId; })[0] ||
      plan.versions[plan.versions.length - 1];
  }

  /** Persist a new version onto the patient's plan document. */
  function saveVersion(patientId, version) {
    return loadPlan(patientId).then(function (plan) {
      if (!plan) {
        plan = { id: U.uid('pln'), patientId: patientId, title: 'Diet plan',
          createdAt: new Date().toISOString(), versions: [], activeVersionId: null };
      }
      // Never mutate an existing version — append a new one.
      version.versionNo = (plan.versions.length ? Math.max.apply(null,
        plan.versions.map(function (v) { return v.versionNo || 0; })) + 1 : 1);
      plan.versions.push(version);
      plan.activeVersionId = version.id;
      return CN.store.put('plans', plan).then(function () { return { plan: plan, version: version }; });
    });
  }

  /* ================================================================ BUILDER  */
  var Builder = {
    title: 'nav.planner',

    render(host, ctx) {
