  /**
   * CN.modal({ title, body, actions:[{label,kind,onClick,close}], wide, dismissable })
   * `body` is trusted HTML — escape any interpolated data with CN.util.esc.
   */
  CN.modal = function (o) {
    o = o || {};
    var node = document.createElement('div');
    node.className = 'modal' + (o.wide ? ' wide' : '');
    node.setAttribute('role', 'dialog');
    node.setAttribute('aria-modal', 'true');

    var html = '<div class="modal-head"><h3>' + util.esc(o.title || '') + '</h3>' +
      '<button type="button" class="btn btn-ghost btn-icon js-close" aria-label="' +
      util.esc(CN.t('common.close')) + '">' + CN.icon('x', 18) + '</button></div>';
    html += '<div class="modal-body">' + (o.body || '') + '</div>';

    var actions = o.actions || [{ label: CN.t('common.close'), kind: 'ghost' }];
    html += '<div class="modal-foot">';
    actions.forEach(function (a, i) {
      html += '<button type="button" class="btn btn-' + (a.kind || 'ghost') +
        '" data-act="' + i + '">' + util.esc(a.label) + '</button>';
    });
    html += '</div>';
    node.innerHTML = html;

    mount(node, o);

    node.addEventListener('click', function (e) {
      var closeBtn = e.target.closest('.js-close');
      if (closeBtn) { closeTop(); return; }
      var act = e.target.closest('[data-act]');
      if (!act) return;
      var a = actions[Number(act.getAttribute('data-act'))];
      var keep = a && a.onClick ? a.onClick(node) : undefined;
      if (a && a.close === false) return;
      if (keep === false) return;
      closeTop();
    });

    return { node: node, close: closeTop };
  };

  /* --------------------------------------------------------------- drawer  */
  /** CN.drawer({ title, body, footer, actions }) — side panel, RTL-aware. */
  CN.drawer = function (o) {
    o = o || {};
    var node = document.createElement('div');
    node.className = 'drawer';
    node.setAttribute('role', 'dialog');
    node.setAttribute('aria-modal', 'true');

    var html = '<div class="drawer-head"><h3>' + util.esc(o.title || '') + '</h3>' +
      '<button type="button" class="btn btn-ghost btn-icon js-close" aria-label="' +
      util.esc(CN.t('common.close')) + '">' + CN.icon('x', 18) + '</button></div>';
    html += '<div class="drawer-body">' + (o.body || '') + '</div>';
    var actions = o.actions || [];
    if (actions.length) {
      html += '<div class="drawer-foot">';
      actions.forEach(function (a, i) {
        html += '<button type="button" class="btn btn-' + (a.kind || 'ghost') +
          '" data-act="' + i + '">' + util.esc(a.label) + '</button>';
      });
      html += '</div>';
    }
    node.innerHTML = html;
    mount(node, o);

    node.addEventListener('click', function (e) {
      if (e.target.closest('.js-close')) { closeTop(); return; }
      var act = e.target.closest('[data-act]');
      if (!act) return;
      var a = actions[Number(act.getAttribute('data-act'))];
      var keep = a && a.onClick ? a.onClick(node) : undefined;
      if (a && a.close === false) return;
      if (keep === false) return;
      closeTop();
    });

    return { node: node, close: closeTop };
  };

  /* -------------------------------------------------------------- confirm  */
  /** CN.confirm({title, message, confirmLabel, kind}) -> Promise<boolean> */
  CN.confirm = function (o) {
    o = o || {};
    return new Promise(function (resolve) {
      var settled = false;
      var finish = function (v) { if (!settled) { settled = true; resolve(v); } };
      CN.modal({
        title: o.title || CN.t('common.confirm'),
        body: '<p>' + util.esc(o.message || '') + '</p>',
        actions: [
          { label: o.cancelLabel || CN.t('common.cancel'), kind: 'ghost',
            onClick() { finish(false); } },
          { label: o.confirmLabel || CN.t('common.confirm'), kind: o.kind || 'accent',
            onClick() { finish(true); } }
        ]
      });
      // Dismissing via scrim/Esc counts as a decline.
      var host = layerHost();
      var obs = new MutationObserver(function () {
        if (!openLayers.length) { finish(false); obs.disconnect(); }
      });
      obs.observe(host, { childList: true });
    });
  };

  /* -------------------------------------------------- small render helpers */
  /** Tabular <dl> from [{k,v}] pairs. */
  CN.kv = function (pairs) {
    return '<dl class="kv">' + pairs.map(function (p) {
      return '<dt>' + util.esc(p.k) + '</dt><dd>' + (p.raw ? p.v : util.esc(p.v)) + '</dd>';
    }).join('') + '</dl>';
  };

  /** Consistent empty-state block. */
  CN.empty = function (title, msg, actionsHtml) {
    return '<div class="empty">' + CN.icon('info', 26) +
      '<h4>' + util.esc(title) + '</h4>' +
      '<p>' + util.esc(msg || '') + '</p>' + (actionsHtml || '') + '</div>';
  };

  /** Select options from [{value,label}]. */
  CN.options = function (list, selected) {
    return list.map(function (o) {
