            var pw = U.$('#sb-secret').value;
            var clinicName = U.$('#sb-clinic').value;
            if (!email || !pw) { CN.toast(CN.t('st.backendNeedsEmail'), 'warn'); return; }
            CN.backend.signUp(email, pw, clinicName)
              .then(function (r) {
                if (r.signedIn) {
                  return CN.store.enableRemote().then(function () { return { ok: true }; });
