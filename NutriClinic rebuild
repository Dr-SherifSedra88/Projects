<body>
<h1>NutriClinic Pro — engine self-test</h1>
<div class="sub">Two suites: deterministic assertions against hand-computed fixtures, and a storage suite that really writes, backs up, restores and deletes. This page is a QA artefact and must not be deployed with the site.</div>

<div class="summary" id="summary">Running…</div>
<div class="summary">
  <strong>Expected values are computed by hand, independently of the code under test.</strong>
  <p style="margin:.5rem 0 0;font-size:.85rem;color:#6B7280">
    This page loads the real modules from <code>../site/js/</code>. Any failure printed below is a
    genuine defect in the application, not an artefact of the harness.
  </p>
  <p style="margin:.5rem 0 0;font-size:.85rem;color:#800020">
    The storage suite writes temporary probe records (a patient, an attachment, a knowledge-base
    document), takes a real backup, restores it, and deletes its own probes at the end. Run it over
    <code>http://</code> to exercise IndexedDB; over <code>file://</code> it exercises the in-memory
    adapter instead, and the summary states which engine actually ran.
  </p>
</div>

<div id="out"></div>

<div class="hint">
  Open this file directly in a browser (no server required), or serve the folder over
  <code>http://</code> for a persistent-storage run. Re-run after any change to the engine, planner,
  store or knowledge base.
</div>

<!-- Real application modules, loaded in dependency order. -->
<script src="../site/js/core.js"></script>
<script src="../site/js/i18n.js"></script>
<script src="../site/js/data-foods.js"></script>
<script src="../site/js/data-approaches.js"></script>
<script src="../site/js/data-references.js"></script>
<script src="../site/js/store.js"></script>
<script src="../site/js/kb.js"></script>
<script src="../site/js/backend.js"></script>
<script src="../site/js/engine.js"></script>
<script src="../site/js/charts.js"></script>
<script src="../site/js/planner.js"></script>
<script src="../site/js/copilot.js"></script>
<!-- views-core is loaded so the harness can assert the Dashboard is registered.
     A load error here stays isolated to this tag and cannot mask other tests. -->
<script src="../site/js/views-core.js"></script>

<script>
(function () {
  'use strict';
  var results = [];

  function ok(name, pass, detail) {
    results.push({ name: name, pass: !!pass, detail: detail || '' });
  }
  function eq(name, actual, expected) {
    ok(name, actual === expected, 'expected ' + expected + ', got ' + actual);
  }
  function near(name, actual, expected, tol) {
    var t = tol === undefined ? 0.51 : tol;
    var pass = typeof actual === 'number' && Math.abs(actual - expected) <= t;
    ok(name, pass, 'expected ≈' + expected + ' (±' + t + '), got ' + actual);
  }

  var E = CN.engine;

  /* ------------------------------------------------------ BMR equations --- */
  // Mifflin-St Jeor, male 80 kg / 180 cm / 40 y:  800 + 1125 − 200 + 5 = 1730
  eq('BMR Mifflin male 80/180/40',
    E.bmr({ weightKg: 80, heightCm: 180, age: 40, sex: 'male', formula: 'mifflin_st_jeor' }).value, 1730);
  // Female 65 kg / 165 cm / 35 y: 650 + 1031.25 − 175 − 161 = 1345.25 → 1345
  eq('BMR Mifflin female 65/165/35',
    E.bmr({ weightKg: 65, heightCm: 165, age: 35, sex: 'female', formula: 'mifflin_st_jeor' }).value, 1345);
  // Harris-Benedict 1919 male: 66.5 + 1100 + 900.54 − 271 = 1796.04 → 1796
  eq('BMR Harris-Benedict male',
    E.bmr({ weightKg: 80, heightCm: 180, age: 40, sex: 'male', formula: 'harris_benedict' }).value, 1796);
  // Revised HB (Roza) male: 88.362 + 1071.76 + 863.82 − 227.08 = 1796.862 → 1797
  eq('BMR revised Harris-Benedict male',
    E.bmr({ weightKg: 80, heightCm: 180, age: 40, sex: 'male', formula: 'harris_benedict_revised' }).value, 1797);
  // A device figure is measured, never an estimate.
  var dev = E.bmr({ formula: 'device_measured', overrideValue: 1680 });
  eq('Device BMR value', dev.value, 1680);
  eq('Device BMR flagged as measured', dev.isEstimated, false);
  eq('Equation BMR flagged as estimated',
    E.bmr({ weightKg: 80, heightCm: 180, age: 40, sex: 'male' }).isEstimated, true);
  eq('BMR null without weight', E.bmr({ heightCm: 180, age: 40, sex: 'male' }), null);

  /* ------------------------------------------------------------- TDEE ----- */
  // 1730 × 1.20 = 2076 exactly
  eq('TDEE sedentary 1730 × 1.20', E.tdee(1730, 'sedentary').value, 2076);
  eq('TDEE factor reported', E.tdee(1730, 'sedentary').factor, 1.2);

  /* -------------------------------------------------------- full assess --- */
  var a = E.assess({
    weightKg: 80, heightCm: 180, age: 40, sex: 'male',
    formula: 'mifflin_st_jeor', activity: 'sedentary',
    goal: 'weight_loss', band: 'moderate', patient: {}
  });
  eq('assess ok', a.ok, true);
  eq('assess BMR', a.bmr, 1730);
  eq('assess TDEE', a.tdee, 2076);
  // moderate band midpoint is 450 → 2076 − 450 = 1626
  eq('assess deficit midpoint', a.deltaKcal, -450);
  eq('assess target', a.targetKcal, 1626);
  // −450 × 7 / 7700 = −0.409 → −0.41
  eq('assess predicted weekly rate', a.weeklyRateKg, -0.41);
  eq('assess BMI', a.bmi, 24.7);
  eq('assess BMI class', a.bmiClass.key, 'normal');
  eq('assess no review needed', a.requiresReview, false);
  ok('assess outcome is deterministic',
    JSON.stringify(a) === JSON.stringify(E.assess({
      weightKg: 80, heightCm: 180, age: 40, sex: 'male',
      formula: 'mifflin_st_jeor', activity: 'sedentary',
      goal: 'weight_loss', band: 'moderate', patient: {}
    })), 'repeated call differed');

  // The safety floor must clamp an over-aggressive larger deficit.
  var floorTest = E.assess({
    weightKg: 52, heightCm: 155, age: 30, sex: 'female',
    formula: 'mifflin_st_jeor', activity: 'sedentary',
    goal: 'weight_loss', band: 'larger', patient: {}
  });
  ok('deficit respects the 1200 kcal floor for a female patient',
    floorTest.targetKcal >= 1200, 'target ' + floorTest.targetKcal);

  // BMI below 18.5 with a weight-loss goal must raise a review flag.
  var underweight = E.assess({
    weightKg: 48, heightCm: 170, age: 25, sex: 'female',
    formula: 'mifflin_st_jeor', activity: 'light',
    goal: 'weight_loss', band: 'moderate', patient: {}
  });
  ok('underweight + weight loss raises a safety flag',
    underweight.flags.some(function (f) { return f.level === 'alert'; }),
    underweight.flags.length + ' flag(s)');
  ok('underweight case requires review', underweight.requiresReview, true);

  // Pregnancy must block a deficit recommendation.
  var pregnant = E.assess({
    weightKg: 70, heightCm: 165, age: 32, sex: 'female',
    formula: 'mifflin_st_jeor', activity: 'light',
    goal: 'weight_loss', band: 'moderate',
    patient: { pregnancy: 'Pregnant, second trimester', conditions: [], restrictions: [] }
  });
  ok('pregnancy raises an alert flag',
    pregnant.flags.some(function (f) { return f.en.indexOf('Pregnancy') === 0; }),
    JSON.stringify(pregnant.flags.map(function (f) { return f.en.slice(0, 40); })));

  /* ------------------------------------------------------------ macros ---- */
  var m = E.macros({
    targetKcal: 1626, weightKg: 80,
    profile: { proteinPct: 20, carbPct: 45, fatPct: 35 }, method: 'percent'
  });
  // 1626 × 0.20 / 4 = 81.3 → 81
  eq('macro protein grams', m.proteinG, 81);
  // 1626 × 0.45 / 4 = 182.925 → 183
  eq('macro carbohydrate grams', m.carbG, 183);
  // 1626 × 0.35 / 9 = 63.23 → 63
  eq('macro fat grams', m.fatG, 63);
  eq('macro energy reconciles with the target', m.energyFromMacros, 1626);
  eq('macro percentages sum to 100', m.proteinPct + m.carbPct + m.fatPct, 100);
  eq('macro fluid is 33 ml/kg', m.fluidMl, 2640);

  // per_kg method sets protein from body weight, not from a percentage.
  var mk = E.macros({
    targetKcal: 2000, weightKg: 80,
    profile: { proteinPct: 25, carbPct: 40, fatPct: 35 },
    method: 'per_kg', proteinPerKg: 1.5
  });
  eq('per_kg protein = 1.5 × 80', mk.proteinG, 120);
  ok('per_kg method reported', mk.method === 'per_kg', mk.method);

  /* ------------------------------------------------------------- BMI ------ */
  eq('BMI 80 kg / 180 cm', E.bmi(180, 80), 24.7);
  eq('BMI null without height', E.bmi(null, 80), null);
  eq('BMI class underweight', E.bmiClass(17).key, 'underweight');
  eq('BMI class overweight', E.bmiClass(27).key, 'overweight');
  eq('BMI class obesity I', E.bmiClass(31).key, 'obese1');
  eq('BMI class obesity III', E.bmiClass(42).key, 'obese3');
  var range = E.healthyWeightRange(180);
  eq('healthy weight low for 180 cm', range.low, 59.9);
  eq('healthy weight high for 180 cm', range.high, 80.7);

  /* ---------------------------------------------------------- progress ---- */
  var prog = E.progress([
    { measuredAt: '2026-01-01', weightKg: 90, heightCm: 175 },
    { measuredAt: '2026-01-29', weightKg: 86, heightCm: 175 }
  ], 80);
  eq('progress total change', prog.totalChange, -4);
  eq('progress days', prog.days, 28);
  eq('progress weekly change', prog.weeklyChange, -1);
  eq('progress percent change', prog.pctChange, -4.4);
  eq('progress toward target', prog.progressPct, 40);
  eq('progress returns null for a single point',
    E.progress([{ measuredAt: '2026-01-01', weightKg: 90 }], 80), null);

  /* --------------------------------------------- compare vs expectation --- */
  eq('stalled verdict', E.compareToExpected(-0.05, -0.41).verdict, 'stalled');
  eq('on-track verdict', E.compareToExpected(-0.40, -0.41).verdict, 'on_track');
  eq('faster verdict', E.compareToExpected(-0.90, -0.41).verdict, 'faster');
  eq('reversed verdict', E.compareToExpected(0.30, -0.41).verdict, 'reversed');

  /* -------------------------------------------------------- reassessment - */
  // Persistent plateau, good adherence, four weeks → reduction proposed.
  var r1 = E.reassess({
    previousTargetKcal: 1626, goal: 'weight_loss',
    expectedWeeklyKg: -0.41, actualWeeklyKg: -0.05,
    adherence: 'high', weeks: 4, weightTrendFlat: true, fluidOrMedChange: false
  });
  eq('reassess proposes a lower target', r1.suggested, 1500);
  eq('reassess marks a change', r1.changed, true);
  eq('reassess never self-applies', r1.applied, false);
  eq('reassess requires approval', r1.requiresApproval, true);

  // Short plateau → no calorie reduction, by design.
  var r2 = E.reassess({
    previousTargetKcal: 1626, goal: 'weight_loss',
    expectedWeeklyKg: -0.41, actualWeeklyKg: -0.05,
    adherence: 'high', weeks: 2, weightTrendFlat: true, fluidOrMedChange: false
  });
  eq('short plateau proposes no change', r2.suggested, 1626);

  // Poor adherence → no calorie reduction either.
  var r3 = E.reassess({
    previousTargetKcal: 1626, goal: 'weight_loss',
    expectedWeeklyKg: -0.41, actualWeeklyKg: -0.05,
    adherence: 'low', weeks: 6, weightTrendFlat: true, fluidOrMedChange: false
  });
  eq('poor adherence proposes no change', r3.suggested, 1626);

  /* ------------------------------------------------- approaches / safety - */
  eq('ketogenic and DASH are incompatible',
    CN.approaches.evaluate(['ketogenic', 'dash']).ok, false);
  eq('DASH and Mediterranean are compatible',
    CN.approaches.evaluate(['dash', 'mediterranean']).ok, true);
  eq('ketogenic and low-fat are incompatible',
    CN.approaches.evaluate(['ketogenic', 'low_fat']).ok, false);
  eq('high protein conflicts with a renal plan',
    CN.approaches.evaluate(['high_protein', 'renal']).ok, false);
  ok('there are exactly 20 therapeutic approaches',
    CN.approaches.all.length === 20, 'found ' + CN.approaches.all.length);
  eq('ketogenic requires no dairy exclusion beyond its own rules',
    CN.approaches.requiredExclusions(['ketogenic']).length, 0);
  ok('vegan imposes dairy and egg exclusions',
    CN.approaches.requiredExclusions(['vegan']).indexOf('milk') !== -1,
    JSON.stringify(CN.approaches.requiredExclusions(['vegan'])));

  /* ---------------------------------------------------------- food data -- */
  ok('food table is populated', CN.foods.items.length >= 100,
    CN.foods.items.length + ' foods');
  var chicken = CN.foods.byId('chicken_breast');
  ok('chicken breast present', !!chicken);
  // 100 kcal of a 165 kcal/100 g food = 60.6 g
  near('100 kcal exchange portion for chicken breast',
    CN.foods.gramsForKcal(chicken, 100), 60.6, 0.1);
  var n100 = CN.foods.nutrientsFor(chicken, 100);
  eq('per-100 g protein for chicken breast', n100.protein, 31);
  ok('peanut butter carries the peanut allergen',
    CN.foods.conflicts(CN.foods.byId('peanut_butter'), ['peanut']).length > 0);
  ok('every food documents its portion assumptions',
    CN.foods.items.every(function (f) {
      return f.portions.every(function (p) { return p.grams > 0 && !!p.assumptionNote; });
    }), 'a portion lacked a gram assumption');

  /* ------------------------------------------------- plan determinism ---- */
  var patient = {
    id: 'test_1', name: 'Test Patient', sex: 'female', dob: '1985-05-05',
    goal: 'weight_loss',
    conditions: ['Type 2 diabetes'],
    restrictions: [{ kind: 'allergy', substance: 'peanut', diagnosed: true }]
  };
  var genInput = {
    patient: patient, targetKcal: 1600,
    macros: { proteinG: 100, carbG: 160, fatG: 62, fiberG: 28, sodiumMaxMg: 2300 },
    approachCodes: ['mediterranean'], durationDays: 7, startDate: '2026-10-15',
    patternKey: '3_meals_1_snack', assessmentId: 'a1'
  };
  var p1 = CN.planner.generate(genInput);
  var p2 = CN.planner.generate(genInput);
  eq('plan generation succeeds', p1.ok, true);
  eq('plan has the requested duration', p1.days.length, 7);
  ok('plan generation is deterministic',
    JSON.stringify(p1.days) === JSON.stringify(p2.days), 'repeated generation differed');
  ok('every planned day has meals',
    p1.days.every(function (d) { return d.meals.length === 4; }),
    p1.days.map(function (d) { return d.meals.length; }).join(','));
  ok('every planned item has positive grams and energy',
    p1.days.every(function (d) {
      return d.meals.every(function (m) {
        return m.items.every(function (i) { return i.grams > 0 && i.kcal > 0; });
      });
    }), 'an item had zero grams or energy');

  // The critical exclusion rule: a diagnosed allergy must never appear.
  var peanutHit = [];
  p1.days.forEach(function (d) {
    d.meals.forEach(function (m) {
      m.items.forEach(function (i) {
        var f = CN.foods.byId(i.foodId);
        if (f && f.allergens.indexOf('peanut') !== -1) peanutHit.push(f.nameEn);
      });
    });
  });
  eq('peanut never appears for a peanut-allergic patient', peanutHit.length, 0);

  // Gluten-free must exclude every gluten-bearing food.
  var gf = CN.planner.generate(Object.assign({}, genInput, {
    approachCodes: ['gluten_free'], patternKey: '3_meals_1_snack'
  }));
  var glutenHit = [];
  gf.days.forEach(function (d) {
    d.meals.forEach(function (m) {
      m.items.forEach(function (i) {
        var f = CN.foods.byId(i.foodId);
        if (f && f.allergens.indexOf('gluten') !== -1) glutenHit.push(f.nameEn);
      });
    });
  });
  eq('gluten-free plan contains no gluten', glutenHit.length, 0);

  /* ----------------------------------------------------- smart exchange -- */
  var item = p1.days[0].meals[0].items[0];
  var swaps = CN.planner.suggestSwaps(item, {
    patient: patient, approachCodes: ['mediterranean'], limit: 5
  });
  ok('smart exchange returns candidates', swaps.length > 0, swaps.length + ' options');
  ok('exchange candidates are ranked by similarity',
    swaps.every(function (s, i) { return i === 0 || swaps[i - 1].similarity >= s.similarity; }),
    'ranking order violated');
  ok('exchange candidates never include an excluded allergen',
    swaps.every(function (s) { return s.food.allergens.indexOf('peanut') === -1; }),
    'a peanut-containing food was offered');

  /* --------------------------------------------------------------- diff -- */
  var modified = JSON.parse(JSON.stringify(p1));
  modified.days[0].meals[0].items[0].grams += 40;
  CN.planner.recalc(modified);
  var d = CN.planner.diff(p1, modified);
  ok('diff detects the altered portion', d.changed.length >= 1, JSON.stringify(d.changed));
  eq('identical versions report no differences', CN.planner.diff(p1, p1).identical, true);

  /* ------------------------------------------------------------ copilot -- */
  var i1 = CN.copilot.interpret('Generate a seven-day Mediterranean plan for this patient');
  eq('copilot intent: generate plan', i1.intent, 'generate_plan');
  eq('copilot language: english', i1.lang, 'en');
  eq('copilot duration: 7 days', i1.params.durationDays, 7);
  ok('copilot extracts the Mediterranean approach',
    i1.params.approachCodes.indexOf('mediterranean') !== -1,
    JSON.stringify(i1.params.approachCodes));

  var i2 = CN.copilot.interpret('أنشئ خطة منخفضة المؤشر الجلايسيمي لمريض سكري');
  eq('copilot language: arabic', i2.lang, 'ar');
  eq('copilot intent from Arabic input', i2.intent, 'generate_plan');
  ok('copilot extracts low-GI from Arabic',
    i2.params.approachCodes.indexOf('low_gi') !== -1,
    JSON.stringify(i2.params.approachCodes));

  var i3 = CN.copilot.interpret('Exclude all dairy products and peanuts');
  ok('copilot detects exclusions',
    (i3.params.exclusions || []).indexOf('peanut') !== -1,
    JSON.stringify(i3.params.exclusions));

  var i4 = CN.copilot.interpret('استبعد كل منتجات الألبان');
  ok('copilot detects Arabic exclusions',
    (i4.params.exclusions || []).indexOf('milk') !== -1,
    JSON.stringify(i4.params.exclusions));

  eq('copilot detects a mixed-language instruction',
    CN.copilot.interpret('Generate plan نظام كيتوني').lang, 'mixed');

  // The de-identification guard must refuse to leak a name.
  var payload = CN.copilot.deidentifiedPayload('hello', { patient: { name: 'Mona Abdelrahman', sex: 'female', conditions: [] } });
  ok('de-identified payload carries no patient name',
    JSON.stringify(payload).indexOf('Mona') === -1,
    JSON.stringify(payload));

  /* --------------------------------------------------------- references -- */
  ok('clinical briefs are present', CN.refs.all.length >= 20, CN.refs.all.length + ' briefs');
  ok('every brief cites at least one source',
    CN.refs.all.every(function (b) { return b.sources && b.sources.length > 0; }),
    'a brief had no source');
  ok('no source claims an unverified access date',
    CN.refs.all.every(function (b) {
      return b.sources.every(function (s) { return s.verified === false; });
    }), 'a source claimed verification');
  ok('evidence tiers are ordered with patient-specific first',
    CN.refs.hierarchy[0].key === 'patient_specific');

  /* ------------------------------------------------------------- report -- */
  var html = CN.pdf.buildReport({
    patient: patient, measurements: [{ measuredAt: '2026-10-01', weightKg: 78, heightCm: 165 }],
    assessment: { bmr: 1400, tdee: 2100, deltaKcal: -450, targetKcal: 1650, activityFactor: 1.5,
      bmrFormulaLabel: 'Mifflin-St Jeor (1990)' },
    macros: m, plan: p1, settings: { clinicName: 'Test Clinic', physicianName: 'Dr Test' },
    mode: 'branded', showNutrients: true, showSignature: true
  });
  ok('report renders without throwing', typeof html === 'string' && html.length > 500);
  ok('report contains the patient name', html.indexOf('Test Patient') !== -1);
  ok('report escapes the patient name', html.indexOf('<script') === -1);

  /* ==================================================================== */
  /* ASYNC SUITE — storage, binaries, recipes, persistence                 */
  /*                                                                       */
  /* These have to actually run. A static claim about binary round-tripping */
  /* would be worthless, so the suite writes real probe records, exercises  */
  /* a real backup, and deletes its own probe records at the end.           */
  /* ==================================================================== */

  var ASYNC = [];
  function test(name, fn) { ASYNC.push({ name: name, fn: fn }); }

  test('store initialises and reports its engine', function () {
    return CN.store.ready().then(function () {
      ok('store reports an engine',
        CN.store.engine === 'indexeddb' || CN.store.engine === 'memory', String(CN.store.engine));
      ok('storage engine under test: ' + CN.store.engine, true, '');
    });
  });

  test('patient registration persists and reads back', function () {
    return CN.store.put('patients', {
      id: 'test_pat_1', name: 'Persistence Probe', code: 'TP-1', sex: 'female',
      dob: '1990-02-02', registeredAt: '2026-10-15', restrictions: [], conditions: []
    }).then(function () {
      return CN.store.get('patients', 'test_pat_1');
    }).then(function (back) {
      ok('patient round-trips through storage', !!back && back.name === 'Persistence Probe',
        JSON.stringify(back));
    });
  });

  var PROBE_BYTES = 'NutriClinicPro-binary-probe-0123456789-\u2713-\u0627\u0644\u0639\u0631\u0628\u064a\u0629';

  test('attachment binary survives a storage round-trip', function () {
    var blob = new Blob([PROBE_BYTES], { type: 'text/plain;charset=utf-8' });
    return CN.store.put('attachments', {
      id: 'test_att_1', patientId: 'test_pat_1', kind: 'document',
      filename: 'probe.txt', mime: 'text/plain', byteSize: blob.size,
      blob: blob, createdAt: new Date().toISOString()
    }).then(function () {
      return CN.store.get('attachments', 'test_att_1');
    }).then(function (a) {
      ok('attachment metadata round-trips', !!a && a.filename === 'probe.txt',
        JSON.stringify(a && { f: a.filename }));
      ok('stored attachment is still a Blob', !!a && a.blob instanceof Blob, typeof (a && a.blob));
      if (!a || !a.blob) return null;
      return a.blob.text().then(function (txt) {
        ok('attachment BYTES are identical after storage', txt === PROBE_BYTES,
          JSON.stringify(String(txt).slice(0, 40)));
      });
    });
  });

  test('base64 encode and decode are lossless', function () {
    var blob = new Blob([PROBE_BYTES], { type: 'text/plain;charset=utf-8' });
    return CN.store.blobToDataUrl(blob).then(function (d) {
      ok('data URL is produced', typeof d === 'string' && d.indexOf('base64,') !== -1, '');
      var back = CN.store.dataUrlToBlob(d);
      ok('data URL decodes to a Blob', back instanceof Blob, typeof back);
      return back.text();
    }).then(function (txt) {
      ok('base64 round-trip preserves multi-byte text exactly', txt === PROBE_BYTES,
        JSON.stringify(String(txt).slice(0, 40)));
    });
  });

  test('backup carries the binary, and restore returns it byte-for-byte', function () {
    var snapshot = null;
    return CN.store.backup().then(function (json) {
      snapshot = json;
      var parsed = JSON.parse(json);
