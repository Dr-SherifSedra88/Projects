-- ---------------------------------------------------------------------------
-- Triggers
-- ---------------------------------------------------------------------------
CREATE OR REPLACE FUNCTION touch_updated_at() RETURNS trigger LANGUAGE plpgsql AS $$
BEGIN
  NEW.updated_at := now();
  RETURN NEW;
END $$;

CREATE TRIGGER clinic_touch      BEFORE UPDATE ON clinic      FOR EACH ROW EXECUTE FUNCTION touch_updated_at();
CREATE TRIGGER app_user_touch    BEFORE UPDATE ON app_user    FOR EACH ROW EXECUTE FUNCTION touch_updated_at();
CREATE TRIGGER patient_touch     BEFORE UPDATE ON patient     FOR EACH ROW EXECUTE FUNCTION touch_updated_at();
CREATE TRIGGER food_touch        BEFORE UPDATE ON food        FOR EACH ROW EXECUTE FUNCTION touch_updated_at();

-- Clinical facts are append-only: block silent edits to recorded observations.
CREATE OR REPLACE FUNCTION block_mutation() RETURNS trigger LANGUAGE plpgsql AS $$
BEGIN
  RAISE EXCEPTION 'Append-only table: % records cannot be % (record a new row instead)',
    TG_TABLE_NAME, lower(TG_OP);
END $$;

CREATE TRIGGER measurement_append_only
  BEFORE UPDATE OR DELETE ON measurement
  FOR EACH ROW EXECUTE FUNCTION block_mutation();

CREATE TRIGGER lab_result_append_only
  BEFORE UPDATE OR DELETE ON lab_result
  FOR EACH ROW EXECUTE FUNCTION block_mutation();

CREATE TRIGGER audit_log_append_only
  BEFORE UPDATE OR DELETE ON audit_log
  FOR EACH ROW EXECUTE FUNCTION block_mutation();

-- ---------------------------------------------------------------------------
-- Row-level security sketch
-- Application connects as nutriclinic_app; never as the owner.
-- ---------------------------------------------------------------------------
ALTER TABLE patient      ENABLE ROW LEVEL SECURITY;
ALTER TABLE measurement  ENABLE ROW LEVEL SECURITY;
ALTER TABLE lab_panel    ENABLE ROW LEVEL SECURITY;
ALTER TABLE lab_result   ENABLE ROW LEVEL SECURITY;
ALTER TABLE plan         ENABLE ROW LEVEL SECURITY;
ALTER TABLE plan_version ENABLE ROW LEVEL SECURITY;
ALTER TABLE kb_document  ENABLE ROW LEVEL SECURITY;

-- The request sets:  SET LOCAL app.current_user_id = '<uuid>';
CREATE POLICY patient_read ON patient FOR SELECT USING (
  clinic_id = current_setting('app.current_clinic_id', true)::uuid
  AND (
    EXISTS (SELECT 1 FROM patient_access pa
            WHERE pa.patient_id = patient.id
              AND pa.user_id = current_setting('app.current_user_id', true)::uuid
              AND pa.revoked_at IS NULL)
    OR EXISTS (SELECT 1 FROM app_user u
               WHERE u.id = current_setting('app.current_user_id', true)::uuid
                 AND u.role IN ('admin','auditor'))
  )
);

CREATE POLICY patient_write ON patient FOR UPDATE USING (
  EXISTS (SELECT 1 FROM patient_access pa
          WHERE pa.patient_id = patient.id
            AND pa.user_id = current_setting('app.current_user_id', true)::uuid
            AND pa.revoked_at IS NULL)
);

