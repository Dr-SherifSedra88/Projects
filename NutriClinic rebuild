        });

        U.on(host, 'click', '[data-diff-v]', function (e, el) {
          var other = plan.versions.filter(function (v) { return v.id === el.getAttribute('data-diff-v'); })[0];
          openDiff(version, other);
        });

        U.on(host, 'click', '[data-go]', function (e, el) { CN.app.go(el.getAttribute('data-go')); });

        wirePlanEditing(host, patient, plan, version);
      });
    }
  };

  /* ------------------------------------------------------- plan rendering -- */
  function planMarkup(version) {
    var lang = CN.i18n.lang;
    var html = '<div class="row mb1"><strong>' + U.esc(CN.t('pl.weekTotals')) + '</strong>' +
      '<div class="grow"></div>' +
      '<span class="muted">' + U.nf(version.targetKcal, 0) + ' kcal ' + U.esc(CN.t('pl.perDay')) + '</span></div>';

    html += version.days.map(function (day) {
      var status = '';
      var dev = Math.abs(day.totals.kcal - version.targetKcal) / version.targetKcal;
      if (dev > 0.08) {
        status = '<span class="chip ' + (day.totals.kcal > version.targetKcal ? 'alert' : 'gold') + '">' +
          (day.totals.kcal > version.targetKcal ? U.esc(CN.t('pl.over')) : U.esc(CN.t('pl.under'))) +
          ' ' + (day.totals.kcal > version.targetKcal ? '+' : '') +
          U.nf(day.totals.kcal - version.targetKcal, 0) + '</span>';
      }
      return '<div class="plan-day"><div class="plan-day-head">' +
        '<h4>' + U.esc((lang === 'ar' ? 'اليوم ' : 'Day ') + (day.dayIndex + 1)) +
        ' · ' + U.esc(U.fmtDate(day.date)) + '</h4>' +
        status +
        '<span class="muted mono">' + U.nf(day.totals.kcal, 0) + ' kcal · P ' + U.nf(day.totals.protein, 0) +
        ' · C ' + U.nf(day.totals.carb, 0) + ' · F ' + U.nf(day.totals.fat, 0) + '</span>' +
        '<button class="btn btn-xs" data-add-meal="' + day.dayIndex + '">' + CN.icon('plus', 12) + ' ' +
          U.esc(CN.t('pl.addMeal')) + '</button>' +
        '</div>' +
        day.meals.map(function (meal, mi) {
          return '<div class="meal"><div class="meal-head">' +
            '<strong>' + U.esc(lang === 'ar' ? (meal.labelAr || meal.labelEn) : meal.labelEn) + '</strong>' +
            (meal.time ? '<span class="chip">' + U.esc(meal.time) + '</span>' : '') +
            '<div class="grow"></div>' +
            '<button class="btn btn-xs" data-add-item="' + day.dayIndex + ':' + mi + '">' + CN.icon('plus', 12) + '</button> ' +
            '<button class="btn btn-xs" data-del-meal="' + day.dayIndex + ':' + mi + '">' + CN.icon('trash', 12) + '</button>' +
            '</div>' +
            meal.items.map(function (item) {
              var food = CN.planner.resolveFood(item.foodId);
              var name = CN.planner.itemName(item, lang);
              var portion = food ? CN.pdf.portionText(food, item.grams, lang) : '';
              return '<div class="item-row">' +
                '<div class="food-name"><span>' + U.esc(name) +
                  (item.isRecipe ? ' <span class="chip navy" style="font-size:.68rem">' +
                    U.esc(CN.t('rc.title')) + '</span>' : '') +
                  (item.needsVerify ? ' <span class="chip gold" style="font-size:.68rem">' +
                    U.esc(CN.t('fd.verify')) + '</span>' : '') +
                  (item.approximate ? ' <span class="chip" style="font-size:.68rem">≈</span>' : '') +
                  '</span>' +
                  (portion ? '<small>' + U.esc(portion) + '</small>' : '') + '</div>' +
                '<input type="number" step="5" value="' + U.esc(item.grams) + '" data-grams="' +
                  U.esc(item.id) + '" data-loc="' + day.dayIndex + ':' + mi + '" style="width:80px"/>' +
                '<span class="qty">' + U.nf(item.kcal, 0) + ' kcal</span>' +
                '<span class="nowrap">' +
                  '<button class="btn btn-xs" data-swap="' + U.esc(item.id) + ':' + day.dayIndex + ':' + mi +
                    '" title="' + U.esc(CN.t('pl.smartReplace')) + '">' + CN.icon('swap', 12) + '</button> ' +
                  '<button class="btn btn-xs" data-del-item="' + U.esc(item.id) + ':' + day.dayIndex + ':' + mi +
                    '">' + CN.icon('x', 12) + '</button>' +
                '</span>' +
                '</div>';
            }).join('') +
            (meal.instructions ? '<p class="muted" style="font-size:.8rem;margin:.3rem 0 0">' +
              U.esc(meal.instructions) + '</p>' : '') +
            '<div class="meal-totals">' +
            '<span>' + U.esc(CN.t('pl.mealTotals')) + ': <b>' + U.nf(meal.totals.kcal, 0) + ' kcal</b></span>' +
            '<span>P <b>' + U.nf(meal.totals.protein, 0) + ' g</b></span>' +
            '<span>C <b>' + U.nf(meal.totals.carb, 0) + ' g</b></span>' +
            '<span>F <b>' + U.nf(meal.totals.fat, 0) + ' g</b></span>' +
            '</div></div>';
        }).join('') + '</div>';
    }).join('');
    return html;
  }

  /* --------------------------------------------------------- plan editing -- */
  function wirePlanEditing(host, patient, plan, version) {
    if (!version) return;

    function persist() {
      return loadPlan(patient.id).then(function (p) {
        p.versions = p.versions.map(function (v) { return v.id === version.id ? version : v; });
        return CN.store.put('plans', p);
      });
    }

    // Gram edits recalculate everything downstream.
    U.on(host, 'change', '[data-grams]', function (e, el) {
      var loc = el.getAttribute('data-loc').split(':');
      var id = el.getAttribute('data-grams');
      CN.planner.setItemGrams(version, Number(loc[0]), Number(loc[1]), id, U.parseNum(el.value));
      var violations = CN.planner.restrictionViolations(version, patient);
      persist().then(function () {
        if (violations.length) CN.toast(CN.t('pl.restrictionViolation'), 'alert', 5000);
        else CN.toast(CN.t('pl.edited'));
        CN.app.refresh();
      });
    });

    U.on(host, 'click', '[data-del-item]', function (e, el) {
      var parts = el.getAttribute('data-del-item').split(':');
      CN.planner.removeItem(version, Number(parts[1]), Number(parts[2]), parts[0]);
      persist().then(function () { CN.app.refresh(); });
    });

    U.on(host, 'click', '[data-add-meal]', function (e, el) {
      CN.planner.addMeal(version, Number(el.getAttribute('data-add-meal')));
      persist().then(function () { CN.app.refresh(); });
    });

    U.on(host, 'click', '[data-del-meal]', function (e, el) {
      var parts = el.getAttribute('data-del-meal').split(':');
      CN.confirm({ title: CN.t('pl.removeMeal'), message: CN.t('common.irreversible') }).then(function (ok) {
        if (!ok) return;
        CN.planner.removeMeal(version, Number(parts[0]), Number(parts[1]));
        persist().then(function () { CN.app.refresh(); });
      });
    });

    U.on(host, 'click', '[data-add-item]', function (e, el) {
      var parts = el.getAttribute('data-add-item').split(':');
      openFoodPicker(patient, version, Number(parts[0]), Number(parts[1]), function () {
        persist().then(function () { CN.app.refresh(); });
      });
    });

    // Smart replace drawer.
    U.on(host, 'click', '[data-swap]', function (e, el) {
      var parts = el.getAttribute('data-swap').split(':');
      var itemId = parts[0], dayI = Number(parts[1]), mealI = Number(parts[2]);
      var meal = version.days[dayI].meals[mealI];
      var item = meal.items.filter(function (i) { return i.id === itemId; })[0];
      if (!item) return;
      openSwapDrawer(patient, version, dayI, mealI, item, function () {
        persist().then(function () { CN.app.refresh(); });
      });
    });
  }

  /** Drawer listing ranked alternatives for one item. */
  function openSwapDrawer(patient, version, dayI, mealI, item, onDone) {
    // Resolve through the planner so a recipe item shows its real name.
    var food = CN.planner.resolveFood(item.foodId);
    var objective = 'kcal';
    var drawerRef = null;

    function results() {
      return CN.planner.suggestSwaps(item, {
        patient: patient, approachCodes: version.approachCodes,
        objective: objective, limit: 10
      });
    }

    function listHtml() {
      var opts = results();
      if (!opts.length) return CN.empty(CN.t('pl.noSwap'), '');
      return '<div class="table-wrap"><table class="tbl compact"><thead><tr>' +
        '<th>' + U.esc(CN.t('fd.title')) + '</th><th class="num">' + U.esc(CN.t('fd.grams')) + '</th>' +
        '<th class="num">' + U.esc(CN.t('common.kcal')) + '</th><th>' + U.esc(CN.t('fd.protein')) + '</th>' +
        '<th></th></tr></thead><tbody>' +
        opts.map(function (o, i) {
          return '<tr><td>' + U.esc(CN.i18n.lang === 'ar' ? (o.food.nameAr || o.food.nameEn) : o.food.nameEn) +
            (o.approximate ? '<div class="muted" style="font-size:.74rem">' + U.esc(CN.t('pl.approx')) + '</div>' : '') +
            (o.penalty ? '<div class="muted" style="font-size:.74rem">' + U.esc(o.penalty) + '</div>' : '') +
            '</td><td class="num">' + U.nf(o.grams, 0) + ' g</td>' +
            '<td class="num">' + U.nf(o.nutrients.kcal, 0) + '</td>' +
            '<td class="num">' + U.nf(o.nutrients.protein, 1) + ' g</td>' +
            '<td class="right"><span class="chip">' + U.nf(o.similarity * 100, 0) + '%</span> ' +
            '<button class="btn btn-xs btn-primary" data-pick="' + i + '">' + U.esc(CN.t('common.apply')) +
            '</button></td></tr>';
        }).join('') + '</tbody></table></div>';
    }

    var body = '<p class="muted" style="font-size:.85rem">' + U.esc(CN.t('pl.swapHint')) + '</p>' +
      '<div class="row mb1"><label class="label" style="margin:0">' + U.esc(CN.t('pl.swapObj')) + '</label>' +
      '<select id="swap-obj">' + CN.options([
        { value: 'kcal', label: CN.t('pl.objKcal') },
        { value: 'protein', label: CN.t('pl.objProtein') },
        { value: 'carb', label: CN.t('pl.objCarb') },
        { value: 'fat', label: CN.t('pl.objFat') }
      ], objective) + '</select></div>' +
      '<div id="swap-list">' + listHtml() + '</div>';

    drawerRef = CN.drawer({
      title: CN.t('pl.swapTitle', { food: food ? (CN.i18n.lang === 'ar' ? food.nameAr : food.nameEn) : item.foodId }),
      body: body
    });

    U.on(drawerRef.node, 'change', '#swap-obj', function (e, el) {
      objective = el.value;
      U.$('#swap-list', drawerRef.node).innerHTML = listHtml();
    });

    U.on(drawerRef.node, 'click', '[data-pick]', function (e, el) {
      var opts = results();
      var pick = opts[Number(el.getAttribute('data-pick'))];
      if (!pick) return;
      CN.planner.applySwap(version, dayI, mealI, item.id, pick.food.id, pick.grams, true);
      var violations = CN.planner.restrictionViolations(version, patient);
      if (violations.length) CN.toast(CN.t('pl.restrictionViolation'), 'alert', 5000);
      else CN.toast(pick.approximate ? CN.t('pl.approx') : CN.t('common.saved'),
        pick.approximate ? 'warn' : 'ok');
      drawerRef.close();
      onDone();
    });
  }

  /** Searchable food picker for adding an item to a meal. */
  function openFoodPicker(patient, version, dayI, mealI, onDone) {
    var rstr = CN.planner.buildRestrictions(patient.restrictions);
    var body = '<div class="field"><input type="search" id="pick-q" placeholder="' +
      U.esc(CN.t('fd.search')) + '"/></div>' +
      '<div id="pick-list" class="scroll-y"></div>';

    var ref = CN.modal({
      title: CN.t('pl.addItem'), wide: true, body: body,
      actions: [{ label: CN.t('common.close'), kind: 'ghost' }]
    });

    function draw(q) {
      var s = (q || '').trim().toLowerCase();
      // Recipes are selectable items on exactly the same footing as foods.
      var list = CN.foods.search(q).slice();
      CN.planner.recipes().forEach(function (r) {
        var rf = CN.planner.recipeAsFood(r);
        if (!rf) return;
        if (!s || (rf.nameEn + ' ' + (rf.nameAr || '')).toLowerCase().indexOf(s) !== -1) list.push(rf);
      });
      list.sort(function (a, b) {
        return String(a.nameEn).localeCompare(String(b.nameEn));
      });

      var rows = list.slice(0, 40);
      var el = U.$('#pick-list', ref.node);
      if (!rows.length) { el.innerHTML = CN.empty(CN.t('fd.none'), CN.t('fd.noneMsg')); return; }
      el.innerHTML = '<div class="table-wrap"><table class="tbl compact"><tbody>' +
        rows.map(function (f) {
          var blocked = CN.planner.buildRestrictions(patient.restrictions).hard
            .some(function (fn) { return fn(f); });
          var defaultG = (f.isRecipe && f.servingG) ? f.servingG : 100;
          return '<tr' + (blocked ? ' style="opacity:.45"' : '') + '><td>' +
            U.esc(CN.i18n.lang === 'ar' ? (f.nameAr || f.nameEn) : f.nameEn) +
            (f.isRecipe ? ' <span class="chip navy" style="font-size:.68rem">' +
              U.esc(CN.t('rc.title')) + '</span>' : '') +
            '<div class="muted" style="font-size:.75rem">' + U.nf(f.kcal, 0) + ' kcal/100 g · ' +
            U.esc(CN.foods.categoryLabel(f.category)) +
            (f.isRecipe && f.servingG ? ' · ' + U.esc(CN.t('rc.perServing')) + ' ' +
              U.nf((f.servingG / 100) * f.kcal, 0) + ' kcal' : '') + '</div></td>' +
            '<td class="right">' + (blocked
              ? '<span class="chip alert">' + U.esc(CN.t('pl.restrictionViolation')) + '</span>'
              : '<input type="number" step="5" value="' + defaultG + '" style="width:70px" data-g="' +
                U.esc(f.id) + '"/> ' +
                '<button class="btn btn-xs btn-primary" data-add="' + U.esc(f.id) + '">' +
                U.esc(CN.t('common.add')) + '</button>') + '</td></tr>';
        }).join('') + '</tbody></table></div>';
    }
    draw('');

    U.on(ref.node, 'input', '#pick-q', U.debounce(function (e, el) { draw(el.value); }, 180));
    U.on(ref.node, 'click', '[data-add]', function (e, el) {
      var id = el.getAttribute('data-add');
      var gEl = U.$('[data-g="' + id + '"]', ref.node);
      CN.planner.addItem(version, dayI, mealI, id, U.parseNum(gEl && gEl.value) || 100);
      ref.close();
      onDone();
    });
  }

  /** Version comparison modal. */
  function openDiff(a, b) {
    var d = CN.planner.diff(a, b);
    if (!d) return;
    var body = '<div class="grid cols-3 mb2">' +
      '<div class="stat"><div class="stat-label">' + U.esc(CN.t('common.version')) + ' ' + U.esc(a.versionNo) +
        '</div><div class="stat-value">' + U.nf(d.totals.avgKcalA, 0) + ' <small>kcal</small></div></div>' +
      '<div class="stat"><div class="stat-label">' + U.esc(CN.t('common.version')) + ' ' + U.esc(b.versionNo) +
        '</div><div class="stat-value">' + U.nf(d.totals.avgKcalB, 0) + ' <small>kcal</small></div></div>' +
      '<div class="stat' + (d.totals.deltaKcal ? ' accent' : '') + '"><div class="stat-label">' +
        U.esc(CN.t('common.difference')) + '</div><div class="stat-value">' +
        (d.totals.deltaKcal > 0 ? '+' : '') + U.nf(d.totals.deltaKcal, 0) + ' <small>kcal</small></div></div>' +
      '</div>';

    if (d.identical) {
      body += ui.notice(CN.t('pl.noChanges'), 'info');
    } else {
      function section(labelKey, rows, render) {
        if (!rows.length) return '';
        return '<h4>' + U.esc(CN.t(labelKey)) + ' (' + rows.length + ')</h4>' +
          '<div class="table-wrap mb2"><table class="tbl compact"><tbody>' +
          rows.slice(0, 40).map(render).join('') + '</tbody></table></div>';
      }
      function foodName(id) {
        var f = CN.planner.resolveFood(id);
        return f ? (CN.i18n.lang === 'ar' ? (f.nameAr || f.nameEn) : f.nameEn) : id;
      }
      body += section('common.add', d.added, function (r) {
        return '<tr><td>' + U.esc('Day ' + (r.day + 1) + ' · ' + r.meal) + '</td><td>' +
          U.esc(foodName(r.food)) +
          '</td><td class="num">' + U.nf(r.grams, 0) + ' g</td></tr>';
      });
      body += section('common.remove', d.removed, function (r) {
        return '<tr><td>' + U.esc('Day ' + (r.day + 1) + ' · ' + r.meal) + '</td><td>' +
          U.esc(foodName(r.food)) + '</td><td class="num">' + U.nf(r.grams, 0) + ' g</td></tr>';
      });
      body += section('common.change', d.changed, function (r) {
        return '<tr><td>' + U.esc('Day ' + (r.day + 1) + ' · ' + r.meal) + '</td><td>' +
          U.esc(foodName(r.food)) + '</td><td class="num">' + U.nf(r.from, 0) + ' → ' + U.nf(r.to, 0) +
          ' g</td><td class="num">' + (r.deltaKcal > 0 ? '+' : '') + U.nf(r.deltaKcal, 0) + ' kcal</td></tr>';
      });
    }

    CN.modal({ title: CN.t('pl.diff'), wide: true, body: body,
      actions: [{ label: CN.t('common.close'), kind: 'ghost' }] });
  }

  /* ============================================================== FOLLOW-UP  */
  var FollowUp = {
    title: 'nav.followup',

    render(host, ctx) {
      var patient = ctx.patient;
      if (!patient) { ui.needPatient(host); return; }

      host.innerHTML = ui.pageHead('fu.title', 'fu.subtitle',
        '<button class="btn btn-primary" id="fu-new">' + CN.icon('plus', 16) + ' ' +
        U.esc(CN.t('fu.new')) + '</button>');

      Promise.all([
        CN.store.byPatient('followups', patient.id),
        CN.store.byPatient('measurements', patient.id),
        CN.store.byPatient('assessments', patient.id),
        loadPlan(patient.id),
        CN.store.all('recipes')
      ]).then(function (r) {
        CN.planner.setRecipeIndex(r[4] || []);
        var followups = U.sortBy(r[0], 'attendedAt', 'desc');
        var ms = U.sortBy(r[1], 'measuredAt', 'asc');
        var assessments = r[2];
        var plan = r[3];
        var version = activeVersion(plan);
        var approved = ui.approvedAssessment(assessments, patient.id);

        var html = '';

        /* ---- progress analysis ---- */
        var prog = CN.engine.progress(ms, ms.length ? ms[ms.length - 1].targetWeightKg : null);
        if (prog) {
          var expected = approved ? approved.weeklyRateKg : null;
          var cmp = expected !== null && expected !== undefined
            ? CN.engine.compareToExpected(prog.weeklyChange, expected) : null;

          html += '<div class="grid cols-4 mb2">' +
            ui.stat('fu.totalChange', (prog.totalChange > 0 ? '+' : '') + U.nf(prog.totalChange, 1) +
              ' <small>kg</small>', U.fmtDate(prog.firstDate) + ' → ' + U.fmtDate(prog.lastDate), 'accent') +
            ui.stat('fu.pctChange', (prog.pctChange > 0 ? '+' : '') + U.nf(prog.pctChange, 1) + ' <small>%</small>',
              prog.days + ' ' + CN.t('common.days')) +
            ui.stat('fu.weeklyChange', U.nf(prog.weeklyChange, 2) + ' <small>kg/wk</small>',
              expected !== null && expected !== undefined
                ? CN.t('fu.expected') + ': ' + U.nf(expected, 2) : null) +
            ui.stat('bc.delta', prog.leanChange !== null
                ? (prog.leanChange > 0 ? '+' : '') + U.nf(prog.leanChange, 1) + ' <small>kg</small>'
                : '<span class="muted">—</span>',
              prog.fatChange !== null
                ? (CN.i18n.lang === 'ar' ? 'الدهون ' : 'fat ') + (prog.fatChange > 0 ? '+' : '') +
                  U.nf(prog.fatChange, 1) + ' %' : null) +
            '</div>';

          if (cmp) html += ui.notice(cmp.en, cmp.verdict === 'on_track' ? 'ok' :
            (cmp.verdict === 'stalled' || cmp.verdict === 'reversed' ? 'warn' : 'info'));
        }

        /* ---- reassessment ---- */
        if (approved && prog) {
          var lastWeights = ms.filter(function (m) { return m.weightKg; });
          var recent = lastWeights.slice(-3);
          var actualWeekly = null;
          if (recent.length >= 2) {
            var span = U.daysBetween(recent[0].measuredAt, recent[recent.length - 1].measuredAt);
            if (span > 0) actualWeekly = U.round((recent[recent.length - 1].weightKg - recent[0].weightKg) / (span / 7), 2);
          }
          var latestFu = followups[0];
          var result = CN.engine.reassess({
            previousTargetKcal: approved.targetKcal,
            goal: approved.goal,
            expectedWeeklyKg: approved.weeklyRateKg,
            actualWeeklyKg: actualWeekly,
            adherence: latestFu ? latestFu.adherence : 'none',
            atTarget: !!(prog.targetWeightKg && prog.toTarget !== null && prog.toTarget <= 0.5),
            weeks: recent.length >= 2 ? U.round(U.daysBetween(recent[0].measuredAt, recent[recent.length - 1].measuredAt) / 7, 1) : 0,
            weightTrendFlat: actualWeekly !== null && Math.abs(actualWeekly) < 0.1,
            fluidOrMedChange: !!(latestFu && latestFu.medicationChanges)
          });

          var reassessHtml = '';
          if (result.ok) {
            reassessHtml =
              '<div class="grid cols-3 mb1">' +
              '<div class="stat"><div class="stat-label">' + U.esc(CN.t('en.prevTarget')) + '</div>' +
                '<div class="stat-value">' + U.nf(result.previous, 0) + ' <small>kcal</small></div></div>' +
              '<div class="stat accent"><div class="stat-label">' + U.esc(CN.t('en.newTarget')) + '</div>' +
                '<div class="stat-value">' + U.nf(result.suggested, 0) + ' <small>kcal</small></div>' +
                '<div class="stat-foot">' + (result.changed
                  ? (result.suggested - result.previous > 0 ? '+' : '') + U.nf(result.suggested - result.previous, 0) + ' kcal'
                  : CN.t('pl.noChanges')) + '</div></div>' +
              '<div class="stat"><div class="stat-label">' + U.esc(CN.t('fu.actualTrend')) + '</div>' +
                '<div class="stat-value">' + (actualWeekly === null ? '—' : U.nf(actualWeekly, 2) +
                  ' <small>kg/wk</small>') + '</div></div>' +
              '</div>' +
              '<ul style="margin:0 0 .9rem 1.1rem;font-size:.88rem">' +
              result.rationale.map(function (x) { return '<li>' + U.esc(x) + '</li>'; }).join('') +
              (result.factors.map(function (x) { return '<li class="muted">' + U.esc(x) + '</li>'; }).join('')) +
              '</ul>' +
              ui.notice(CN.t('fu.plateauNote'), 'info') +
              (result.changed
                ? '<div class="btn-row"><button class="btn btn-primary" id="fu-apply">' +
                  CN.icon('check', 16) + ' ' + U.esc(CN.t('fu.applyChange')) + '</button>' +
                  '<button class="btn" id="fu-keep">' + U.esc(CN.t('fu.keepTarget')) + '</button></div>'
                : '');

            html += ui.card('fu.reassess', reassessHtml);
          }
        }

        /* ---- follow-up records ---- */
        if (!followups.length) {
