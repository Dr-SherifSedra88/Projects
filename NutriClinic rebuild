  margin-inline-start:auto; background:var(--burgundy); color:#fff;
  font-size:.68rem; padding:.05rem .4rem; border-radius:999px;
}

.topbar{
  height:var(--topbar-h); flex:none; background:var(--white);
  border-bottom:1px solid var(--gray-line);
  display:flex; align-items:center; gap:1rem; padding:0 1.3rem;
  position:sticky; top:0; z-index:20;
}
.topbar-title{display:flex; flex-direction:column; min-width:0;}
.topbar-title strong{color:var(--navy); font-size:1rem; white-space:nowrap; overflow:hidden;
  text-overflow:ellipsis;}
.topbar-title span{font-size:.76rem; color:var(--gray-500);}
.topbar-spacer{flex:1;}
.patient-pill{
  display:flex; align-items:center; gap:.5rem; background:var(--gold-100);
  border:1px solid var(--gold); border-radius:999px; padding:.28rem .75rem;
  font-size:.82rem; color:var(--navy); cursor:pointer;
}
.patient-pill.is-empty{background:var(--gray-bg); border-color:var(--gray-line); color:var(--gray-500);
  cursor:default;}

.view{padding:1.4rem 1.5rem 3.5rem; max-width:1500px; width:100%; margin:0 auto;}

/* --- page header ------------------------------------------------------- */
.page-head{display:flex; align-items:flex-start; gap:1rem; margin-bottom:1.1rem; flex-wrap:wrap;}
.page-head .grow{flex:1; min-width:220px;}
.page-head p{color:var(--gray-500); margin:.2rem 0 0; font-size:.88rem; max-width:78ch;}

/* --- cards ------------------------------------------------------------- */
.card{
  background:var(--white); border:1px solid var(--gray-line); border-radius:var(--radius);
  box-shadow:var(--shadow-1); padding:1.1rem 1.2rem; margin-bottom:1rem;
}
.card-head{display:flex; align-items:center; gap:.7rem; margin-bottom:.9rem;}
.card-head h3,.card-head h4{margin:0;}
.card-head .grow{flex:1;}
.card-sub{color:var(--gray-500); font-size:.83rem; margin:-.5rem 0 .9rem;}
.card.flush{padding:0; overflow:hidden;}
.card.flush .card-head{padding:1rem 1.2rem 0;}

.grid{display:grid; gap:1rem;}
.grid.cols-2{grid-template-columns:repeat(2,minmax(0,1fr));}
.grid.cols-3{grid-template-columns:repeat(3,minmax(0,1fr));}
.grid.cols-4{grid-template-columns:repeat(4,minmax(0,1fr));}
.grid.split{grid-template-columns:minmax(0,2fr) minmax(0,1fr);}
@media (max-width:1150px){.grid.cols-4{grid-template-columns:repeat(2,minmax(0,1fr));}
  .grid.split{grid-template-columns:1fr;}}
@media (max-width:860px){.grid.cols-2,.grid.cols-3{grid-template-columns:1fr;}}

/* --- stat tiles -------------------------------------------------------- */
.stat{
  background:var(--white); border:1px solid var(--gray-line); border-radius:var(--radius);
  padding:.95rem 1.05rem; box-shadow:var(--shadow-1);
}
.stat-label{font-size:.76rem; text-transform:uppercase; letter-spacing:.07em; color:var(--gray-500);}
.stat-value{font-size:1.65rem; font-weight:680; color:var(--navy); line-height:1.15; margin-top:.2rem;}
.stat-value small{font-size:.8rem; font-weight:500; color:var(--gray-500);}
.stat-foot{font-size:.78rem; color:var(--gray-500); margin-top:.25rem;}
.stat.accent{border-top:3px solid var(--gold);}
.stat.alert{border-top:3px solid var(--burgundy);}

/* --- buttons ----------------------------------------------------------- */
.btn{
  display:inline-flex; align-items:center; justify-content:center; gap:.45rem;
  padding:.5rem .9rem; border-radius:var(--radius-sm); border:1px solid var(--gray-line);
  background:var(--white); color:var(--navy); font:inherit; font-size:.87rem; font-weight:600;
  cursor:pointer; transition:background var(--dur), border-color var(--dur), box-shadow var(--dur);
  white-space:nowrap;
}
.btn:hover{background:var(--gray-bg);}
.btn:disabled{opacity:.5; cursor:not-allowed;}
.btn-primary{background:var(--navy); border-color:var(--navy); color:#fff;}
.btn-primary:hover{background:var(--navy-700);}
.btn-accent{background:var(--burgundy); border-color:var(--burgundy); color:#fff;}
.btn-accent:hover{background:var(--burgundy-600);}
.btn-gold{background:var(--gold); border-color:var(--gold); color:var(--navy);}
.btn-ghost{background:transparent; border-color:transparent; color:var(--navy-500);}
.btn-ghost:hover{background:var(--gray-bg);}
.btn-sm{padding:.3rem .6rem; font-size:.8rem;}
.btn-xs{padding:.16rem .45rem; font-size:.74rem; border-radius:4px;}
.btn-icon{padding:.4rem; width:32px; height:32px;}
.btn-block{width:100%;}
.btn-row{display:flex; gap:.55rem; flex-wrap:wrap; align-items:center;}

/* --- forms ------------------------------------------------------------- */
.field{margin-bottom:.85rem;}
.field label,.label{
  display:block; font-size:.79rem; font-weight:650; color:var(--navy);
  margin-bottom:.28rem; letter-spacing:.01em;
}
.field .hint{font-size:.76rem; color:var(--gray-500); margin-top:.25rem;}
.field .err{font-size:.78rem; color:var(--burgundy); margin-top:.25rem;}
input[type=text],input[type=number],input[type=date],input[type=email],input[type=tel],
input[type=search],input[type=time],select,textarea{
  width:100%; padding:.5rem .65rem; font:inherit; font-size:.88rem; color:var(--charcoal);
  background:var(--white); border:1px solid var(--gray-line); border-radius:var(--radius-sm);
  transition:border-color var(--dur), box-shadow var(--dur);
}
input:focus,select:focus,textarea:focus{
  outline:none; border-color:var(--navy-500); box-shadow:0 0 0 3px rgba(44,66,112,.14);
}
input[readonly]{background:var(--gray-bg); color:var(--gray-500);}
textarea{min-height:78px; resize:vertical;}
select{cursor:pointer;}
.check{display:flex; align-items:flex-start; gap:.5rem; font-size:.86rem; margin-bottom:.4rem;}
.check input{margin-top:.18rem; flex:none;}
.inline-fields{display:grid; grid-template-columns:repeat(auto-fit,minmax(140px,1fr)); gap:.75rem;}
.fieldset{border:1px solid var(--gray-line); border-radius:var(--radius); padding:1rem; margin-bottom:1rem;}
.fieldset>legend{padding:0 .4rem; font-size:.8rem; font-weight:680; color:var(--navy);
  text-transform:uppercase; letter-spacing:.06em;}

/* --- tables ------------------------------------------------------------ */
.table-wrap{overflow-x:auto; border-radius:var(--radius); border:1px solid var(--gray-line);
  background:var(--white);}
table.tbl{width:100%; border-collapse:collapse; font-size:.86rem;}
table.tbl th{
  text-align:start; padding:.6rem .8rem; background:var(--gray-bg); color:var(--navy);
  font-size:.75rem; text-transform:uppercase; letter-spacing:.06em; font-weight:680;
  border-bottom:1px solid var(--gray-line); white-space:nowrap;
}
table.tbl td{padding:.6rem .8rem; border-bottom:1px solid var(--gray-line); vertical-align:middle;}
table.tbl tbody tr:hover{background:#FAFBFC;}
table.tbl tbody tr:last-child td{border-bottom:0;}
table.tbl td.num,table.tbl th.num{text-align:end; font-variant-numeric:tabular-nums;}
table.tbl.compact td,table.tbl.compact th{padding:.4rem .55rem;}
.row-click{cursor:pointer;}

/* --- chips / badges ---------------------------------------------------- */
.chip{
  display:inline-flex; align-items:center; gap:.3rem; padding:.14rem .55rem;
  border-radius:999px; font-size:.76rem; font-weight:600;
  background:var(--gray-bg); color:var(--navy); border:1px solid var(--gray-line);
}
.chip.gold{background:var(--gold-100); border-color:var(--gold);}
.chip.alert{background:var(--burgundy-200); border-color:var(--burgundy); color:var(--burgundy-600);}
.chip.navy{background:var(--navy); border-color:var(--navy); color:#fff;}
.chip-row{display:flex; gap:.35rem; flex-wrap:wrap;}
.tag-src{font-size:.72rem; color:var(--gray-500);}

/* --- progress ---------------------------------------------------------- */
.bar{height:8px; background:var(--gray-line); border-radius:999px; overflow:hidden;}
.bar>i{display:block; height:100%; background:var(--navy); border-radius:999px;
  transition:width .35s ease;}
.bar.gold>i{background:var(--gold);}
.bar.alert>i{background:var(--burgundy);}

/* --- tabs -------------------------------------------------------------- */
.tabs{display:flex; gap:.2rem; border-bottom:1px solid var(--gray-line); margin-bottom:1rem;
  overflow-x:auto;}
.tab{
  padding:.5rem .85rem; border:0; background:transparent; font:inherit; font-size:.87rem;
  font-weight:600; color:var(--gray-500); cursor:pointer; border-bottom:2px solid transparent;
  white-space:nowrap;
}
.tab:hover{color:var(--navy);}
.tab.is-active{color:var(--navy); border-bottom-color:var(--gold);}

/* --- notices ----------------------------------------------------------- */
.notice{
  border:1px solid var(--gray-line); border-inline-start-width:3px; border-radius:var(--radius-sm);
  padding:.7rem .9rem; font-size:.85rem; background:var(--white); margin-bottom:.8rem;
}
.notice strong{color:var(--navy);}
.notice.info{border-inline-start-color:var(--navy-500); background:#F8FAFD;}
.notice.warn{border-inline-start-color:var(--gold); background:var(--gold-100);}
.notice.alert{border-inline-start-color:var(--burgundy); background:var(--burgundy-200);}
.notice.ok{border-inline-start-color:var(--navy); background:#F8FAFD;}

/* --- empty states ------------------------------------------------------ */
.empty{
  text-align:center; padding:2.6rem 1rem; color:var(--gray-500);
  border:1px dashed var(--gray-line); border-radius:var(--radius); background:var(--white);
}
.empty h4{color:var(--navy); margin-bottom:.3rem;}
.empty p{max-width:46ch; margin:0 auto .9rem;}

/* --- toasts ------------------------------------------------------------ */
.toasts{position:fixed; inset-block-end:1rem; inset-inline-end:1rem; z-index:60;
  display:flex; flex-direction:column; gap:.5rem; max-width:min(92vw,380px);}
.toast{
  background:var(--navy); color:#fff; padding:.65rem .9rem; border-radius:var(--radius-sm);
  box-shadow:var(--shadow-2); font-size:.86rem; display:flex; gap:.55rem; align-items:flex-start;
  animation:toast-in .2s ease;
}
.toast.warn{background:var(--gold); color:var(--navy);}
.toast.alert{background:var(--burgundy);}
.toast.ok{background:var(--navy);}
@keyframes toast-in{from{opacity:0; transform:translateY(6px);} to{opacity:1; transform:none;}}

/* --- modal / drawer ---------------------------------------------------- */
.layer{position:relative; z-index:50;}
.layer[hidden]{display:none;}
.scrim{position:fixed; inset:0; background:rgba(20,33,61,.44); animation:fade .16s ease;}
@keyframes fade{from{opacity:0;} to{opacity:1;}}
.modal{
  position:fixed; inset-block-start:50%; inset-inline-start:50%; transform:translate(-50%,-50%);
  width:min(94vw,660px); max-height:88vh; overflow:auto; background:var(--white);
  border-radius:var(--radius-lg); box-shadow:var(--shadow-3); animation:pop .18s ease;
}
.modal.wide{width:min(96vw,960px);}
@keyframes pop{from{opacity:0; transform:translate(-50%,-46%);} to{opacity:1; transform:translate(-50%,-50%);}}
.modal-head{display:flex; align-items:center; gap:.7rem; padding:1rem 1.2rem;
  border-bottom:1px solid var(--gray-line); position:sticky; top:0; background:var(--white); z-index:2;}
.modal-head h3{flex:1;}
.modal-body{padding:1.2rem;}
.modal-foot{display:flex; gap:.55rem; justify-content:flex-end; padding:.85rem 1.2rem;
  border-top:1px solid var(--gray-line); background:var(--gray-bg);
  position:sticky; bottom:0;}

.drawer{
  position:fixed; inset-block:0; inset-inline-end:0; width:min(94vw,520px);
  background:var(--white); box-shadow:var(--shadow-3); display:flex; flex-direction:column;
  animation:slide-in .2s ease;
}
@keyframes slide-in{from{transform:translateX(var(--drawer-from,100%));} to{transform:none;}}
.drawer-head{display:flex; align-items:center; gap:.7rem; padding:1rem 1.2rem;
  border-bottom:1px solid var(--gray-line);}
.drawer-head h3{flex:1;}
.drawer-body{padding:1.1rem 1.2rem; overflow:auto; flex:1;}
.drawer-foot{padding:.85rem 1.2rem; border-top:1px solid var(--gray-line); background:var(--gray-bg);
  display:flex; gap:.55rem; justify-content:flex-end;}

/* --- charts ------------------------------------------------------------ */
.chart{width:100%; height:auto; display:block; overflow:visible;}
.chart .grid-line{stroke:var(--gray-line); stroke-width:1;}
.chart .axis-label{fill:var(--gray-500); font-size:11px; font-family:var(--sans);}
.chart .series-line{fill:none; stroke:var(--navy); stroke-width:2.4; stroke-linejoin:round;
  stroke-linecap:round;}
.chart .series-line.alt{stroke:var(--gold); stroke-dasharray:5 4;}
.chart .series-area{fill:rgba(20,33,61,.08);}
.chart .point{fill:var(--navy); stroke:#fff; stroke-width:2;}
.chart .point.alt{fill:var(--gold);}
.chart .bar-rect{fill:var(--navy);}
.chart .bar-rect.alt{fill:var(--gold);}
.chart .bar-rect.alert{fill:var(--burgundy);}
.chart .donut-seg{stroke:#fff; stroke-width:2;}
.chart .target-line{stroke:var(--burgundy); stroke-width:1.6; stroke-dasharray:6 4;}
.legend{display:flex; gap:1rem; flex-wrap:wrap; font-size:.8rem; color:var(--gray-500);
  margin-top:.5rem;}
.legend i{display:inline-block; width:10px; height:10px; border-radius:2px; margin-inline-end:.35rem;
  vertical-align:middle;}
.legend i.navy{background:var(--navy);} .legend i.gold{background:var(--gold);}
.legend i.burgundy{background:var(--burgundy);}

/* --- plan builder ------------------------------------------------------ */
.plan-day{background:var(--white); border:1px solid var(--gray-line); border-radius:var(--radius);
  margin-bottom:.9rem; overflow:hidden;}
.plan-day-head{display:flex; align-items:center; gap:.6rem; padding:.7rem 1rem;
  background:var(--gray-bg); border-bottom:1px solid var(--gray-line);}
.plan-day-head h4{flex:1; margin:0;}
.meal{border-bottom:1px solid var(--gray-line); padding:.85rem 1rem;}
.meal:last-child{border-bottom:0;}
.meal-head{display:flex; align-items:center; gap:.6rem; margin-bottom:.55rem;}
.meal-head strong{color:var(--navy); font-size:.9rem;}
.meal-head .grow{flex:1;}
.item-row{display:grid; grid-template-columns:1fr 96px 82px 40px; gap:.5rem; align-items:center;
  padding:.3rem 0; font-size:.86rem;}
.item-row .food-name{display:flex; flex-direction:column; min-width:0;}
.item-row .food-name small{color:var(--gray-500); font-size:.75rem;}
.item-row .qty{text-align:end; font-variant-numeric:tabular-nums; color:var(--gray-500);}
.meal-totals{display:flex; gap:.9rem; flex-wrap:wrap; font-size:.79rem; color:var(--gray-500);
  margin-top:.45rem; padding-top:.45rem; border-top:1px dashed var(--gray-line);}
.meal-totals b{color:var(--navy); font-variant-numeric:tabular-nums;}

/* --- misc -------------------------------------------------------------- */
.kv{display:grid; grid-template-columns:auto 1fr; gap:.3rem 1rem; font-size:.86rem;}
.kv dt{color:var(--gray-500);} .kv dd{margin:0; color:var(--charcoal); font-weight:500;}
.mono{font-variant-numeric:tabular-nums;}
.muted{color:var(--gray-500);}
.center{text-align:center;}
.right{text-align:end;}
.nowrap{white-space:nowrap;}
.mt0{margin-top:0;} .mb0{margin-bottom:0;} .mb1{margin-bottom:.6rem;} .mb2{margin-bottom:1rem;}
.row{display:flex; align-items:center; gap:.6rem; flex-wrap:wrap;}
.row.tight{gap:.35rem;}
.scroll-y{max-height:340px; overflow-y:auto;}
.sr-only{position:absolute; width:1px; height:1px; padding:0; margin:-1px; overflow:hidden;
  clip:rect(0 0 0 0); white-space:nowrap; border:0;}

/* --- RTL --------------------------------------------------------------- */
[dir="rtl"] body{font-family:var(--sans);}
[dir="rtl"] .nav-item.is-active{box-shadow:inset -3px 0 0 var(--gold);}
[dir="rtl"] .drawer{
  --drawer-from:-100%;
  box-shadow:var(--shadow-3);
}
[dir="rtl"] .modal{transform:translate(50%,-50%);}
@keyframes pop-rtl{from{opacity:0; transform:translate(50%,-46%);} to{opacity:1; transform:translate(50%,-50%);}}
[dir="rtl"] .modal{animation:pop-rtl .18s ease;}

/* --- responsive -------------------------------------------------------- */
@media (max-width:900px){
  :root{--sidebar-w:100%;}
  .app{grid-template-columns:1fr;}
  .sidebar{position:fixed; inset-block:0; inset-inline-start:0; width:270px; z-index:40;
    transform:translateX(-100%); transition:transform .2s ease;}
  [dir="rtl"] .sidebar{transform:translateX(100%);}
  .sidebar.is-open{transform:none;}
  .view{padding:1rem .9rem 3rem;}
  .topbar{padding:0 .9rem; gap:.5rem;}
  body.nav-open .scrim{display:block;}
}
@media (min-width:901px){.nav-toggle{display:none;}}

/* ==========================================================================
   NutriClinic Pro — print / A4 stylesheet
   Loaded with media="print". The app renders the report into #print-root and
   calls window.print(); everything else is hidden here. PDF export is
   browser print-to-PDF — no external rendering library is permitted by CSP.
   ========================================================================== */

@page{ size:A4; margin:14mm 14mm 16mm; }

/* Off-screen on display; becomes the only visible thing on paper. */
.print-root{ display:none; }

@media print{
  html,body{ background:#fff !important; }
  body{ font-size:10.5pt; color:#333; }

  /* Hide the entire application chrome. */
  .app,.toasts,.layer,.skip-link,.boot,.scrim,.modal,.drawer{ display:none !important; }

  .print-root{ display:block !important; }

  /* --- report structure --- */
  .rpt{ font-family:"Segoe UI",system-ui,Arial,"Noto Sans Arabic",Tahoma,sans-serif; color:#333; }
  .rpt-head{
    display:flex; align-items:flex-start; gap:10pt;
    border-bottom:2pt solid #14213D; padding-bottom:7pt; margin-bottom:12pt;
  }
  .rpt-head .brand{ flex:1; }
  .rpt-head h1{ font-size:16pt; color:#14213D; margin:0 0 2pt; }
  .rpt-head .sub{ font-size:9pt; color:#6B7280; }
  .rpt-logo{ width:48pt; height:48pt; flex:none; }
  .rpt-meta{
    display:grid; grid-template-columns:repeat(4,1fr); gap:5pt 10pt;
    font-size:9pt; margin-bottom:11pt;
  }
  .rpt-meta .k{ color:#6B7280; font-size:8pt; text-transform:uppercase; letter-spacing:.04em; }
  .rpt-meta .v{ color:#14213D; font-weight:600; }

  .rpt h2{
    font-size:12pt; color:#14213D; margin:13pt 0 6pt;
    border-bottom:1pt solid #E2E5EA; padding-bottom:3pt;
    break-after:avoid; page-break-after:avoid;
  }
  .rpt h3{
    font-size:10.5pt; color:#14213D; margin:9pt 0 4pt;
    break-after:avoid; page-break-after:avoid;
  }

  .rpt table{ width:100%; border-collapse:collapse; font-size:9.5pt; }
  .rpt th{
    text-align:left; background:#F4F5F7; color:#14213D; font-size:8.5pt;
    text-transform:uppercase; letter-spacing:.04em;
    padding:4pt 6pt; border-bottom:1pt solid #E2E5EA;
  }
  .rpt td{ padding:4pt 6pt; border-bottom:.5pt solid #E2E5EA; vertical-align:top; }
  .rpt td.num,.rpt th.num{ text-align:right; font-variant-numeric:tabular-nums; }
  /* Never split a meal row across pages. */
  .rpt tr{ break-inside:avoid; page-break-inside:avoid; }

  .rpt .meal{
    border:.5pt solid #E2E5EA; border-left:2.5pt solid #C6A667;
    border-radius:3pt; padding:6pt 8pt; margin-bottom:7pt;
    break-inside:avoid; page-break-inside:avoid;
  }
  .rpt .meal h3{ margin:0 0 3pt; font-size:10pt; }
  .rpt .totals{
    display:flex; gap:12pt; flex-wrap:wrap; font-size:9pt; color:#6B7280;
    margin-top:5pt; padding-top:4pt; border-top:.5pt dashed #E2E5EA;
  }
  .rpt .totals b{ color:#14213D; }

  .rpt .notice{
    border:.5pt solid #E2E5EA; border-left:2.5pt solid #800020;
    padding:5pt 7pt; font-size:9pt; margin:6pt 0; background:#FCFAFB;
  }
  .rpt .sig{
    margin-top:22pt; display:flex; justify-content:space-between; gap:20pt;
    font-size:9pt; break-inside:avoid;
  }
  .rpt .sig .line{ border-top:.5pt solid #333; padding-top:3pt; min-width:150pt; }
  .rpt-foot{
    margin-top:14pt; padding-top:5pt; border-top:.5pt solid #E2E5EA;
    font-size:8pt; color:#6B7280; display:flex; justify-content:space-between;
  }

  /* Plain mode: externally branded stationery, so strip clinic identity. */
  .rpt.plain .rpt-head{ border-bottom:1pt solid #999; }
  .rpt.plain .rpt-logo,.rpt.plain .rpt-foot .clinic-name{ display:none; }

  /* Arabic: mirror alignment when the document is RTL. */
  [dir="rtl"] .rpt th,[dir="rtl"] .rpt td{ text-align:right; }
  [dir="rtl"] .rpt td.num,[dir="rtl"] .rpt th.num{ text-align:left; }
  [dir="rtl"] .rpt .meal{ border-left:.5pt solid #E2E5EA; border-right:2.5pt solid #C6A667; }

  .page-break{ break-before:page; page-break-before:always; }
  .no-print{ display:none !important; }
}

/* ==========================================================================
   Editable template tokens.
   Declared after the block above so these win, and typed in `em` so a single
   inline font-size on .rpt rescales the whole report. --rpt-accent lets the
   clinic choose the heading colour without touching this file.
   ========================================================================== */
@media print{
  .rpt{ font-size:10.5pt; }
  .rpt-head{ border-bottom-color:var(--rpt-accent, #14213D); }
  .rpt-head h1{ font-size:1.52em; color:var(--rpt-accent, #14213D); }
  .rpt-head .sub{ font-size:.86em; }
  .rpt-logo{ width:4.6em; height:4.6em; }
  .rpt-meta{ font-size:.86em; }
  .rpt-meta .k{ font-size:.89em; }
  .rpt h2{ font-size:1.14em; border-bottom-color:var(--rpt-accent, #14213D); }
  .rpt h3{ font-size:1em; }
  .rpt table{ font-size:.9em; }
  .rpt th{ font-size:.94em; }
  .rpt .meal{ border-left-color:var(--rpt-accent, #14213D); }
  .rpt .totals{ font-size:.86em; }
  .rpt .notice{ font-size:.86em; }
  .rpt .sig{ font-size:.86em; }
  .rpt-foot{ font-size:.76em; }
}

/* ==========================================================================
   NutriClinic Pro — app.js
   Shell, routing, patient context, first-run setup, Copilot view.
   Loads last; may depend on every module above it.
   ========================================================================== */
(function () {
  'use strict';
  var CN = window.CN = window.CN || {};
  var U = CN.util;
  var ui = CN.ui;

  /* ------------------------------------------------------------- routing --- */
  var ROUTES = [
    { section: 'nav.sec.overview', items: [
      { name: 'dashboard', icon: 'grid', title: 'nav.dashboard' }
    ] },
    { section: 'nav.sec.clinical', items: [
      { name: 'patients', icon: 'users', title: 'nav.patients' },
      { name: 'newPatient', icon: 'user-plus', title: 'nav.newPatient' },
      { name: 'assessment', icon: 'clipboard', title: 'nav.assessment', needsPatient: true },
      { name: 'energy', icon: 'flame', title: 'nav.energy', needsPatient: true },
      { name: 'bodyComp', icon: 'activity', title: 'nav.bodyComp', needsPatient: true },
      { name: 'planner', icon: 'utensils', title: 'nav.planner', needsPatient: true },
      { name: 'copilot', icon: 'sparkles', title: 'nav.copilot', needsPatient: true },
      { name: 'followup', icon: 'calendar', title: 'nav.followup', needsPatient: true }
    ] },
    { section: 'nav.sec.library', items: [
      { name: 'foods', icon: 'apple', title: 'nav.foods' },
      { name: 'references', icon: 'book', title: 'nav.references' },
      { name: 'reports', icon: 'file-text', title: 'nav.reports', needsPatient: true }
    ] },
    { section: 'nav.sec.system', items: [
      { name: 'settings', icon: 'sliders', title: 'nav.settings' }
    ] }
  ];

  var state = {
    route: 'dashboard',
    patientId: null,
    patient: null,
    busy: false
  };

  function findRoute(name) {
    var out = null;
    ROUTES.forEach(function (sec) {
      sec.items.forEach(function (it) { if (it.name === name) out = it; });
    });
    return out;
  }

  /* ------------------------------------------------------------- sidebar --- */
  function renderSidebar() {
    var el = U.$('#sidebar');
    if (!el) return;
    var html = '<div class="side-brand">' +
      '<svg viewBox="0 0 64 64" width="34" height="34" aria-hidden="true">' +
      '<rect width="64" height="64" rx="14" fill="#1D2E52"/>' +
      '<path d="M14 42h10l6-16 6 22 5-14h9" fill="none" stroke="#C6A667" stroke-width="4" ' +
      'stroke-linecap="round" stroke-linejoin="round"/></svg>' +
      '<div class="side-brand-txt"><strong>' + U.esc(CN.t('app.name')) + '</strong>' +
      '<span>' + U.esc(CN.t('app.tagline')) + '</span></div></div>' +
      '<nav class="side-nav">';

    ROUTES.forEach(function (sec) {
      html += '<div class="side-sec">' + U.esc(CN.t(sec.section)) + '</div>';
      sec.items.forEach(function (it) {
        html += '<button class="nav-item' + (state.route === it.name ? ' is-active' : '') +
          '" data-route="' + it.name + '">' + CN.icon(it.icon, 17) +
          '<span>' + U.esc(CN.t(it.title)) + '</span>' +
          (it.needsPatient && !state.patientId ? '<span class="nav-badge">·</span>' : '') +
          '</button>';
      });
    });

    html += '</nav>';
    el.innerHTML = html;
  }

  /* -------------------------------------------------------------- topbar --- */
  function renderTopbar() {
    var el = U.$('#topbar');
    if (!el) return;
    var route = findRoute(state.route) || { title: 'nav.dashboard' };
    var p = state.patient;

    el.innerHTML =
      '<button class="btn btn-ghost btn-icon nav-toggle" id="nav-toggle" aria-label="' +
        U.esc(CN.t('topbar.menu')) + '">' + CN.icon('menu', 18) + '</button>' +
      '<div class="topbar-title"><strong>' + U.esc(CN.t(route.title)) + '</strong>' +
        '<span>' + U.esc(CN.t('app.name')) + (p ? ' · ' + U.esc(p.name) : '') + '</span></div>' +
      '<div class="topbar-spacer"></div>' +
      (p
        ? '<button class="patient-pill" id="patient-pill" title="' + U.esc(CN.t('topbar.switch')) + '">' +
          CN.icon('users', 15) + '<span>' + U.esc(p.name) + '</span></button>'
        : '<span class="patient-pill is-empty">' + CN.icon('users', 15) + '<span>' +
          U.esc(CN.t('topbar.noPatient')) + '</span></span>') +
      '<button class="btn btn-ghost btn-sm" id="lang-toggle" title="' + U.esc(CN.t('common.language')) + '">' +
        (CN.i18n.lang === 'ar' ? 'EN' : 'ع') + '</button>';
  }

  /* ----------------------------------------------------------- patient list */
  function openPatientPicker() {
    CN.store.all('patients').then(function (patients) {
      if (!patients.length) {
        CN.toast(CN.t('dash.noPatientsMsg'), 'warn');
        CN.app.go('newPatient');
        return;
      }
      patients = U.sortBy(patients, 'name', 'asc');
      var body = '<div class="field"><input type="search" id="pp-q" placeholder="' +
        U.esc(CN.t('pat.search')) + '"/></div><div id="pp-list" class="scroll-y"></div>';

      var ref = CN.modal({
        title: CN.t('topbar.switch'), body: body,
        actions: [
          { label: CN.t('common.none'), kind: 'ghost', onClick() { CN.app.setPatient(null); } },
          { label: CN.t('common.close'), kind: 'ghost' }
        ]
      });

      function draw(q) {
        var s = (q || '').trim().toLowerCase();
        var rows = patients.filter(function (p) {
          return !s || (p.name || '').toLowerCase().indexOf(s) !== -1 ||
            (p.code || '').toLowerCase().indexOf(s) !== -1;
        });
        var el = U.$('#pp-list', ref.node);
        if (!rows.length) { el.innerHTML = CN.empty(CN.t('pat.none'), ''); return; }
        el.innerHTML = rows.map(function (p) {
          return '<button class="btn btn-block" style="justify-content:flex-start;margin-bottom:.4rem" ' +
            'data-pick="' + U.esc(p.id) + '">' + CN.icon('users', 15) +
            ' <strong>' + U.esc(p.name) + '</strong> <span class="muted">' +
            U.esc(p.code || '') + '</span></button>';
        }).join('');
      }
      draw('');

      U.on(ref.node, 'input', '#pp-q', U.debounce(function (e, el) { draw(el.value); }, 150));
      U.on(ref.node, 'click', '[data-pick]', function (e, el) {
        CN.app.setPatient(el.getAttribute('data-pick'));
        ref.close();
      });
    });
  }

  /* -------------------------------------------------------------- copilot -- */
  var chat = [];   // conversation blocks for the current session

  var CopilotView = {
    title: 'nav.copilot',
    render(host, ctx) {
      var patient = ctx.patient;
      if (!patient) { ui.needPatient(host); return; }

      Promise.all([
        CN.store.byPatient('assessments', patient.id),
        CN.store.byPatient('measurements', patient.id),
        CN.store.settings(),
        CN.planHelpers.loadPlan(patient.id),
        CN.store.byPatient('followups', patient.id),
        CN.store.all('recipes')
      ]).then(function (r) {
        var approved = ui.approvedAssessment(r[0], patient.id);
        var settings = r[2];
        var plan = CN.planHelpers.activeVersion(r[3]);
        var followups = U.sortBy(r[4] || [], 'attendedAt', 'desc');
        // Recipes are referenceable in whatever the copilot drafts.
        CN.planner.setRecipeIndex(r[5] || []);
        var displayName = patient.name.split(' ')[0];

        var html = ui.pageHead('cp.title', 'cp.subtitle');

        // Context banner: exactly what the copilot can see.
        html += ui.card('cp.context',
          '<div class="chip-row mb1">' +
            ui.tag(patient.name) +
            (patient.goal ? ui.tag(CN.t('goal.' + patient.goal)) : '') +
            (patient.conditions || []).slice(0, 4).map(function (c) { return ui.tag(c); }).join('') +
            (patient.restrictions || []).map(function (x) {
              return ui.tag(CN.foods.allergenLabel(x.substance, CN.i18n.lang), x.kind === 'allergy' ? 'alert' : '');
            }).join('') +
            (approved ? ui.tag(CN.t('en.target') + ' ' + U.nf(approved.targetKcal, 0) + ' kcal', 'navy')
              : ui.tag(CN.t('en.notApproved'), 'gold')) +
            (plan ? ui.tag(CN.t('pl.versions') + ' ' + plan.versionNo) : '') +
          '</div>' +
          ui.notice(CN.t('cp.externalOff'), 'info'));

        // Examples
        html += ui.card('cp.examples',
          '<div class="chip-row">' + CN.copilot.examples(CN.i18n.lang).map(function (ex, i) {
            return '<button class="btn btn-sm" data-example="' + i + '">' + U.esc(ex) + '</button>';
          }).join('') + '</div>');

        html += '<div class="card"><div id="cp-log" class="scroll-y" style="max-height:52vh;min-height:120px">' +
          (chat.length ? chat.map(renderBlocks).join('')
            : '<p class="muted">' + U.esc(CN.t('cp.placeholder')) + '</p>') +
          '</div>' +
          '<div class="row" style="margin-top:.8rem">' +
          '<input type="text" id="cp-input" placeholder="' + U.esc(CN.t('cp.placeholder')) + '"/>' +
          '<button class="btn btn-primary" id="cp-send">' + CN.icon('sparkles', 16) + ' ' +
            U.esc(CN.t('cp.send')) + '</button>' +
          '<button class="btn btn-ghost btn-sm" id="cp-clear">' + CN.icon('trash', 15) + '</button>' +
          '</div></div>';

        host.innerHTML += html;

        function renderBlocks(res) {
          if (!res || !res.blocks) return '';
          return res.blocks.map(function (b) {
            if (b.kind === 'p') return '<p>' + U.esc(b.text) + '</p>';
            if (b.kind === 'ul') {
              return '<ul style="margin:0 0 .7rem 1.1rem;font-size:.87rem">' +
                b.items.map(function (i) { return '<li>' + U.esc(i) + '</li>'; }).join('') + '</ul>';
            }
            if (b.kind === 'notice') return ui.notice(b.text, b.tone);
            if (b.kind === 'external') {
              return '<div class="notice info"><strong>External model:</strong><br>' +
                U.esc(b.text) + '</div>';
            }
            if (b.kind === 'brief') {
              var t = CN.i18n.lang === 'ar' ? (b.brief.titleAr || b.brief.titleEn) : b.brief.titleEn;
              return '<div class="notice info"><strong>' + U.esc(t) + '</strong><br>' +
                U.esc(b.brief.summary) + '</div>';
            }
            return '';
          }).join('');
        }

        function appendQuestion(text) {
          var log = U.$('#cp-log');
          if (!log) return;
          if (log.querySelector('.muted') && !chat.length) log.innerHTML = '';
          log.insertAdjacentHTML('beforeend',
            '<div class="notice" style="border-inline-start-color:#14213D"><strong>' +
            U.esc(CN.t('common.clinician')) + ':</strong> ' + U.esc(text) + '</div>');
          log.scrollTop = log.scrollHeight;
        }

        function send() {
          var input = U.$('#cp-input');
          var text = (input.value || '').trim();
          if (!text) return;
          appendQuestion(text);
          input.value = '';

          var log = U.$('#cp-log');
          var id = 'pend_' + Date.now();
          log.insertAdjacentHTML('beforeend', '<div id="' + id + '" class="muted">' +
            U.esc(CN.t('cp.thinking')) + '</div>');
          log.scrollTop = log.scrollHeight;

          CN.copilot.respond(text, {
            patient: patient,
            assessment: approved,
            macros: approved ? approved.macros : null,
            settings: settings,
            plan: plan,
            followups: followups,
            history: chat
          }).then(function (res) {
            var pend = U.$('#' + id);
            if (pend) pend.remove();

            chat.push({ q: text, res: res });

            var htmlOut = renderBlocks(res);
            // Offer to carry the draft into the builder.
            if (res.draft && res.draft.ok) {
              htmlOut += '<div class="btn-row"><button class="btn btn-primary btn-sm" id="cp-open-planner">' +
                U.esc(CN.t('cp.openPlanner')) + '</button></div>';
              CopilotView._pendingDraft = res.draft;
            }
            log.insertAdjacentHTML('beforeend', htmlOut);
            log.scrollTop = log.scrollHeight;

            U.on(log, 'click', '#cp-open-planner', function () {
              var draft = CopilotView._pendingDraft;
              if (!draft) return;
              draft.status = 'pending_approval';
              CN.planHelpers.saveVersion(patient.id, draft).then(function () {
                chat = [];
                CN.toast(CN.t('cp.draftReady'));
                CN.app.go('planner');
              });
            });
          });
        }

        U.on(host, 'click', '#cp-send', send);
        U.on(host, 'keydown', '#cp-input', function (e) {
          if (e.key === 'Enter') { e.preventDefault(); send(); }
        });
        U.on(host, 'click', '[data-example]', function (e, el) {
          var list = CN.copilot.examples(CN.i18n.lang);
          var v = list[Number(el.getAttribute('data-example'))];
          if (v) { U.$('#cp-input').value = v; U.$('#cp-input').focus(); }
        });
        U.on(host, 'click', '#cp-clear', function () {
          chat = [];
          U.$('#cp-log').innerHTML = '<p class="muted">' + U.esc(CN.t('cp.placeholder')) + '</p>';
        });

        if (patient) {
          var greet = CN.i18n.lang === 'ar'
            ? 'اختر تعليمًا من الأمثلة أو اكتب تعليمًا إكلينيكيًا.'
            : 'Pick an example instruction, or type a clinical instruction.';
          var logEl = U.$('#cp-log');
          if (logEl && !chat.length) logEl.innerHTML = '<p class="muted">' + U.esc(greet) + '</p>';
        }
      });
    }
  };

  /* ---------------------------------------------------------- first run ---- */
  /**
   * The application ALWAYS opens on the Dashboard. Nothing is demanded of the
   * user up front — no setup wizard, no forced patient registration, no modal
   * blocking the interface. When the clinic identity is still unset the
   * Dashboard shows a dismissible prompt instead, and Settings holds the full
   * form for anyone who wants to complete it.
   *
   * This replaced a non-dismissable first-run modal, which meant a new user (or
   * anyone opening the link on a phone) met a form before ever seeing the app.
   */
  function needsClinicIdentity() {
    return CN.store.settings().then(function (s) {
      if (!s) return true;
      var name = String(s.clinicName || '').trim();
      return !name || name === 'NutriClinic Pro';
    });
  }

  /* ------------------------------------------------------------------ app -- */
  var app = {
    get patientId() { return state.patientId; },
    get patient() { return state.patient; },

    /**
     * Navigate to a module by name.
     * `focus` is an optional CSS selector to scroll to and highlight once the
     * view has rendered — used by the Dashboard's quick-access tiles to reach
     * a section that lives inside a larger module.
     */
    go(name, focus) {
      var r = findRoute(name);
      if (!r || r.needsPatient && !state.patientId) {
        if (r && r.needsPatient && !state.patientId) {
          ui.needPatient(U.$('#view'));
          openPatientPicker();
          return;
        }
      }
      state.route = name;
      state.focus = focus || null;
      try { localStorage.setItem('cn.route', name); } catch (e) { /* ignore */ }
      renderSidebar();
      renderTopbar();
      app.renderCurrent();
      app.applyFocus();
    },

    /**
     * Scroll to and briefly highlight a target.
     * Views render asynchronously, so this retries until the element appears
     * rather than silently doing nothing.
     */
    applyFocus() {
      var sel = state.focus;
      if (!sel) return;
      state.focus = null;
      var tries = 0;
      (function attempt() {
        var el = U.$(sel);
        if (el) {
          try { el.scrollIntoView({ behavior: 'smooth', block: 'start' }); }
          catch (e) { el.scrollIntoView(); }
          el.style.transition = 'box-shadow .4s ease';
          el.style.boxShadow = '0 0 0 3px rgba(198,166,103,.6)';
          setTimeout(function () { el.style.boxShadow = ''; }, 1800);
          return;
        }
        if (++tries < 12) setTimeout(attempt, 120);
      })();
    },

    /** Re-render the active route, keeping scroll position where possible. */
    refresh() {
      var y = window.scrollY;
      app.renderCurrent();
      window.scrollTo(0, y);
    },

    renderCurrent() {
      var view = CN.views[state.route];
      var host = U.$('#view');
      if (!host) return;
      if (!view) { host.innerHTML = CN.empty('Module not found: ' + state.route, ''); return; }

      var ctx = { patient: state.patient, patientId: state.patientId };
      try {
        view.render(host, ctx);
      } catch (e) {
        host.innerHTML = ui.pageHead(view.title || state.route) +
          ui.notice('This screen failed to render: ' + (e && e.message ? e.message : e), 'alert');
        if (window.console) console.error(e);
      }
    },

    setPatient(id) {
      if (!id) {
        state.patientId = null;
        state.patient = null;
        try { localStorage.removeItem('cn.patientId'); } catch (e) { /* ignore */ }
        renderSidebar(); renderTopbar(); app.refresh();
        return Promise.resolve();
      }

      // In server mode the read goes through the audited function, so the access
      // and its audit entry are one transaction and cannot be separated by a
      // client. If that call fails the clinic still needs to work, so it falls
      // back to a plain read AND says so rather than failing quietly.
      var load;
      if (CN.store.isRemote() && CN.backend) {
        // Calls the security-definer function directly. The server returns the
        // whole row as jsonb ({ id, clinic_id, patient_id, storage_path, data }),
        // which is mapped here exactly as the REST adapter would map it.
        load = CN.backend.rpc('patient_read', { p_id: String(id) }).then(function (row) {
          if (!row) return null;
          var obj = Object.assign({}, row.data || {});
          obj.id = row.id;
          if (row.patient_id) obj.patientId = row.patient_id;
          if (row.storage_path) obj.storagePath = row.storage_path;
          if (row.created_at) obj.createdAt = obj.createdAt || row.created_at;
          return obj;
        }).catch(function (e) {
          if (window.console) {
            console.warn('[NutriClinic] audited read unavailable, falling back:', e && e.message);
          }
          CN.toast('Record opened without the audit log — ' +
            ((e && e.message) || 'server unavailable'), 'warn', 8000);
          return CN.store.get('patients', id);
        });
      } else {
        load = CN.store.get('patients', id);
      }

      return load.then(function (p) {
        if (!p) return;
        state.patientId = p.id;
        state.patient = p;
        try { localStorage.setItem('cn.patientId', p.id); } catch (e) { /* ignore */ }
        renderSidebar(); renderTopbar(); app.refresh();
      });
    },

    openPatient(id, route) {
      app.setPatient(id).then(function () {
        if (route) app.go(route);
      });
    },

    /** Restore the last patient if it still exists. */
    restorePatient() {
      var id = null;
      try { id = localStorage.getItem('cn.patientId'); } catch (e) { /* ignore */ }
      if (!id) return Promise.resolve();
      return CN.store.get('patients', id).then(function (p) {
        if (p) { state.patientId = p.id; state.patient = p; }
      });
    }
  };
  CN.app = app;
  CN.app.needsClinicIdentity = needsClinicIdentity;
  // Exported so the test harness can assert route coverage without a DOM.
  CN.app.ROUTES = ROUTES;
  CN.app.findRoute = findRoute;
  CN.views.copilot = CopilotView;

  /* ----------------------------------------------------------------- boot -- */
  function boot() {
    CN.i18n.restore();

    CN.store.ready().then(function () {
      // Connect the optional server backend before the first render, so the
      // Dashboard reflects shared records when a session already exists.
      return CN.store.initBackend();
    }).then(function () {
      return app.restorePatient();
    }).then(function () {
      var bootEl = U.$('#boot');
      if (bootEl) bootEl.remove();
      var appEl = U.$('#app');
      if (appEl) appEl.removeAttribute('hidden');

      var saved = null;
      try { saved = localStorage.getItem('cn.route'); } catch (e) { /* ignore */ }
      state.route = (saved && findRoute(saved)) ? saved : 'dashboard';

      renderSidebar();
      renderTopbar();
      app.renderCurrent();

      CN.bus.on('lang', function () {
        renderSidebar(); renderTopbar(); app.renderCurrent();
      });
      CN.bus.on('data', function () {
        renderSidebar(); renderTopbar();
      });

      /* --- failure visibility ------------------------------------------------
         Views call store.put() and mostly ignore the returned promise, so a
         failed save would otherwise be completely silent. Announcing failures
         centrally means a clinician can never believe a record was saved when
         it was not. */
      CN.bus.on('store-error', function (info) {
        var verb = info.action === 'read' ? 'read'
          : (info.action === 'delete' ? 'delete' : 'save');
        var why = (info.error && info.error.message) || 'unknown error';
        CN.toast('Could not ' + verb + ' in "' + info.store + '": ' + why, 'alert', 9000);
      });

      // Backstop for any rejection that is not routed through the store.
      window.addEventListener('unhandledrejection', function (ev) {
        var r = ev.reason;
        var msg = (r && r.message) ? r.message : String(r);
        if (window.console) console.error('[NutriClinic] unhandled rejection:', r);
        CN.toast('An operation failed: ' + msg, 'alert', 9000);
      });

      return null;
    }).catch(function (e) {
      var bootEl = U.$('#boot');
      if (bootEl) {
        bootEl.innerHTML = '<div class="boot-txt" style="color:#800020">' +
          U.esc('The application failed to start: ' + (e && e.message ? e.message : e)) + '</div>';
      }
      if (window.console) console.error(e);
    });
  }

  /* Delegated shell handlers — attached once, outside the re-rendered markup. */
  document.addEventListener('click', function (e) {
    var navBtn = e.target.closest('[data-route]');
    if (navBtn) {
      CN.app.go(navBtn.getAttribute('data-route'));
      var sb = U.$('#sidebar');
      if (sb) sb.classList.remove('is-open');
      document.body.classList.remove('nav-open');
      return;
    }
    if (e.target.closest('#nav-toggle')) {
      var sb2 = U.$('#sidebar');
      if (sb2) {
        sb2.classList.toggle('is-open');
        document.body.classList.toggle('nav-open', sb2.classList.contains('is-open'));
      }
      return;
    }
    // On a phone the sidebar is an overlay. Tapping the content behind it
    // should dismiss it, or there is no way back.
    if (e.target.closest('#view')) {
      var sbOpen = U.$('#sidebar');
      if (sbOpen && sbOpen.classList.contains('is-open')) {
        sbOpen.classList.remove('is-open');
        document.body.classList.remove('nav-open');
        return;
      }
    }
    if (e.target.closest('#patient-pill')) { openPatientPicker(); return; }
    if (e.target.closest('#lang-toggle')) {
      CN.i18n.setLang(CN.i18n.lang === 'ar' ? 'en' : 'ar');
      return;
    }
    // A click on the scrim behind the mobile sidebar closes it.
    if (e.target.classList && e.target.classList.contains('scrim')) {
      var sb3 = U.$('#sidebar');
      if (sb3) sb3.classList.remove('is-open');
      document.body.classList.remove('nav-open');
    }
  });

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', boot);
  } else {
    boot();
  }
})();

/* ==========================================================================
   NutriClinic Pro — backend.js
   Optional server backend: Supabase (PostgreSQL + Auth + Object Storage).

   WHY THIS FILE EXISTS
   Browser storage cannot hold real clinical records safely: it has no login, no
   audit trail and no shared record set. This module supplies those, while
   leaving the local tier intact so the app still runs with no server at all.

   SECRETS POLICY (brief §19)
   Only the Supabase ANON key ever reaches this file. It is designed to be
   public — every table is protected by Row Level Security, so the key alone
   grants nothing. The service_role key bypasses RLS and must NEVER appear here,
   in config.js, or anywhere the browser can read. AI provider keys stay behind
   the proxy described in README.

   TRANSPORT
   Plain fetch against Supabase's REST, Auth and Storage HTTP APIs. No SDK
   script is loaded, so the strict no-external-assets CSP still holds.
   ========================================================================== */
(function () {
  'use strict';
  var CN = window.CN = window.CN || {};
  var U = CN.util;

  var BUCKET = 'clinical-documents';
  var SESSION_KEY = 'cn.backend.session';
  var CLINICAL_TABLES = ['patients', 'measurements', 'labs', 'assessments',
    'plans', 'followups', 'attachments', 'recipes', 'kb'];

  var cfg = { url: '', anonKey: '' };
  var session = null;
  var clinicCache = null;

  /* --------------------------------------------------------------- config -- */
  function loadConfig() {
    var w = window.NUTRICLINIC_CONFIG || {};
    cfg.url = String(w.supabaseUrl || '').trim().replace(/\/+$/, '');
    cfg.anonKey = String(w.supabaseAnonKey || '').trim();
    // A device-level override is allowed for the anon key only.
    try {
      var local = JSON.parse(localStorage.getItem('cn.backend.cfg') || 'null');
      if (local && local.url) cfg.url = String(local.url).replace(/\/+$/, '');
      if (local && local.anonKey) cfg.anonKey = String(local.anonKey);
    } catch (e) { /* ignore */ }
    return cfg;
  }

  /** Persist a device-level override for a deployment without config.js. */
  function saveConfig(url, anonKey) {
    cfg.url = String(url || '').trim().replace(/\/+$/, '');
    cfg.anonKey = String(anonKey || '').trim();
    try {
      localStorage.setItem('cn.backend.cfg', JSON.stringify({ url: cfg.url, anonKey: cfg.anonKey }));
    } catch (e) { /* ignore */ }
    return cfg;
  }

  function configured() { return !!(cfg.url && cfg.anonKey); }

  /* ---------------------------------------------------------------- session */
  function loadSession() {
    if (session) return session;
    try { session = JSON.parse(localStorage.getItem(SESSION_KEY) || 'null'); }
    catch (e) { session = null; }
    return session;
  }

  function saveSession() {
    try {
      if (session) localStorage.setItem(SESSION_KEY, JSON.stringify(session));
      else localStorage.removeItem(SESSION_KEY);
    } catch (e) { /* ignore */ }
  }

  function hasSession() {
    var s = loadSession();
    return !!(s && s.access_token);
  }

  function currentUser() {
    var s = loadSession();
    return s ? (s.user || null) : null;
  }

  function currentRole() {
    var s = loadSession();
    return s ? (s.role || null) : null;
  }

  function normaliseSession(j) {
    if (!j || !j.access_token) return null;
    var prev = loadSession() || {};
    return {
      access_token: j.access_token,
      refresh_token: j.refresh_token || prev.refresh_token || null,
      // Refresh a minute early so a token never expires mid-request.
      expires_at: Date.now() + ((Number(j.expires_in) || 3600) * 1000) - 60000,
      user: j.user || prev.user || null,
      role: (j.user && j.user.role) || prev.role || null
    };
  }

  /* ------------------------------------------------------------ http layer - */
  function parse(r) {
    if (r.status === 204) return Promise.resolve(null);
    return r.text().then(function (t) {
      var j = null;
      if (t) { try { j = JSON.parse(t); } catch (e) { j = null; } }
      if (!r.ok) {
        var msg = (j && (j.error_description || j.msg || j.message || j.error || j.hint)) ||
          ('HTTP ' + r.status);
        var err = new Error(msg);
        err.status = r.status;
        err.body = j;
        throw err;
      }
      return j;
    });
  }

  function authHeaders(token, extra) {
    var h = { apikey: cfg.anonKey };
    if (token) h.Authorization = 'Bearer ' + token;
    return Object.assign(h, extra || {});
  }

  /** Access token, refreshed when close to expiry. */
  function token() {
    var s = loadSession();
    if (!s || !s.access_token) return Promise.reject(new Error('Not signed in.'));
    if (s.expires_at && Date.now() > s.expires_at && s.refresh_token) {
      return refresh().then(function (n) { return n.access_token; })
        .catch(function () { return s.access_token; });   // let the server refuse if stale
    }
    return Promise.resolve(s.access_token);
  }

  /* ------------------------------------------------------------------- auth */
  function signIn(email, password) {
    if (!configured()) return Promise.reject(new Error('No backend is configured.'));
    return fetch(cfg.url + '/auth/v1/token?grant_type=password', {
      method: 'POST',
      headers: authHeaders(null, { 'Content-Type': 'application/json' }),
      body: JSON.stringify({ email: email, password: password })
    }).then(parse).then(function (j) {
      session = normaliseSession(j);
      saveSession();
      clinicCache = null;
      CN.bus.emit('auth', { action: 'signin', user: session.user });
      return session.user;
    });
  }

  function signUp(email, password, clinicName) {
    if (!configured()) return Promise.reject(new Error('No backend is configured.'));
    return fetch(cfg.url + '/auth/v1/signup', {
      method: 'POST',
      headers: authHeaders(null, { 'Content-Type': 'application/json' }),
      body: JSON.stringify({ email: email, password: password })
    }).then(parse).then(function (j) {
      // With email confirmation enabled there is no session yet, and that is
      // reported honestly rather than looking like a failure.
      var s = j && j.access_token ? normaliseSession(j) : null;
      if (s) {
        session = s;
        saveSession();
        return bootstrapClinic(clinicName).then(function () {
          CN.bus.emit('auth', { action: 'signin', user: s.user });
          return { signedIn: true, user: s.user };
        });
      }
      return { signedIn: false, needsEmailConfirmation: true };
    });
  }

  function signOut() {
    var s = loadSession();
    var t = s && s.access_token;
    session = null;
    clinicCache = null;
    saveSession();
    CN.bus.emit('auth', { action: 'signout' });
    if (!t || !configured()) return Promise.resolve(true);
    return fetch(cfg.url + '/auth/v1/logout', { method: 'POST', headers: authHeaders(t) })
      .catch(function () { return null; })   // a local sign-out must always succeed
      .then(function () { return true; });
  }

  function refresh() {
    var s = loadSession();
    if (!s || !s.refresh_token) return Promise.reject(new Error('No refresh token available.'));
    return fetch(cfg.url + '/auth/v1/token?grant_type=refresh_token', {
      method: 'POST',
      headers: authHeaders(null, { 'Content-Type': 'application/json' }),
      body: JSON.stringify({ refresh_token: s.refresh_token })
    }).then(parse).then(function (j) {
      session = normaliseSession(j);
      saveSession();
      return session;
    });
  }

  /* -------------------------------------------------------------- rest/rpc - */
  function rest(path, opts) {
    opts = opts || {};
    return token().then(function (t) {
      var headers = authHeaders(t, { 'Content-Type': 'application/json' });
      if (opts.prefer) headers.Prefer = opts.prefer;
      return fetch(cfg.url + '/rest/v1/' + path, {
        method: opts.method || 'GET',
        headers: headers,
        body: opts.body === undefined ? undefined : JSON.stringify(opts.body)
      });
    }).then(parse);
  }

  function rpc(name, args) {
    return rest('rpc/' + name, { method: 'POST', body: args || {} });
  }

  /** Which clinic, and with what role, this account belongs to. */
  function clinic() {
    if (clinicCache) return Promise.resolve(clinicCache);
    return rest('clinic_members?select=clinic_id,role&limit=1').then(function (rows) {
      if (!rows || !rows.length) {
        var e = new Error('This account is not a member of a clinic yet.');
        e.code = 'no_clinic';
        throw e;
      }
      clinicCache = { id: rows[0].clinic_id, role: rows[0].role };
      var s = loadSession();
      if (s && s.role !== clinicCache.role) { s.role = clinicCache.role; session = s; saveSession(); }
      return clinicCache;
    });
  }

  function bootstrapClinic(name) {
    return rpc('bootstrap_clinic', { clinic_name: name || 'My Clinic' }).then(function () {
      clinicCache = null;
      return true;
    });
  }

  function inviteMember(email, role) {
    return rpc('add_clinic_member', { member_email: email, member_role: role || 'clinician' });
  }

  /* ---------------------------------------------------------------- storage */
  function uploadObject(path, blob, contentType) {
    return token().then(function (t) {
      return fetch(cfg.url + '/storage/v1/object/' + BUCKET + '/' + path, {
        method: 'POST',
        headers: authHeaders(t, {
          'Content-Type': contentType || 'application/octet-stream',
          'x-upsert': 'true'
        }),
        body: blob
      });
    }).then(parse).then(function () { return true; });
  }

  function signedUrl(path, seconds) {
    return token().then(function (t) {
      return fetch(cfg.url + '/storage/v1/object/sign/' + BUCKET + '/' + path, {
        method: 'POST',
        headers: authHeaders(t, { 'Content-Type': 'application/json' }),
        body: JSON.stringify({ expiresIn: seconds || 300 })
      });
    }).then(parse).then(function (j) {
      if (!j || !j.signedURL) throw new Error('The storage service did not return a signed URL.');
      return cfg.url + '/storage/v1' + j.signedURL;
    });
  }

  function removeObject(path) {
    return token().then(function (t) {
      return fetch(cfg.url + '/storage/v1/object/' + BUCKET + '/' + path, {
        method: 'DELETE', headers: authHeaders(t)
      });
    }).then(function () { return true; });
  }

  /* ------------------------------------------------------- remote adapter --- */
  function rowToObject(row) {
    var obj = Object.assign({}, row.data || {});
    obj.id = row.id;
    if (row.patient_id) obj.patientId = row.patient_id;
    if (row.storage_path) obj.storagePath = row.storage_path;
    if (row.created_at) obj.createdAt = obj.createdAt || row.created_at;
    return obj;
  }

  /**
   * Implements the same interface as the local storage tiers, so views are
   * unaware of which one is in use.
   */
  function RemoteAdapter() {
    return {
      name: 'supabase',

      all(table) {
        return clinic().then(function () { return rest(table + '?select=*'); })
          .then(function (rows) { return (rows || []).map(rowToObject); });
      },

      get(table, id) {
        return clinic()
          .then(function () { return rest(table + '?select=*&id=eq.' + encodeURIComponent(id)); })
          .then(function (rows) { return (rows && rows.length) ? rowToObject(rows[0]) : null; });
      },

      put(table, obj) {
        return clinic().then(function (c) {
          var payload = Object.assign({}, obj);
          var blob = payload.blob || null;
          var patientId = payload.patientId || null;
          var existingPath = payload.storagePath || null;
          delete payload.blob;
          delete payload.storagePath;

          var prep = Promise.resolve(existingPath);
          if (blob) {
            // Documents go to private object storage, never into the database
            // row and never into a public bucket.
            var safe = String(payload.filename || 'document')
              .replace(/[^A-Za-z0-9._-]+/g, '_').slice(0, 80);
            var path = c.id + '/' + (patientId || 'unassigned') + '/' + obj.id + '-' + safe;
            prep = uploadObject(path, blob, payload.mime).then(function () { return path; });
          }

          return prep.then(function (path) {
            return rest(table + '?on_conflict=id', {
              method: 'POST',
              prefer: 'resolution=merge-duplicates,return=minimal',
              body: {
                id: String(obj.id),
                clinic_id: c.id,
                patient_id: patientId,
                storage_path: path || null,
                data: payload,
                updated_at: new Date().toISOString()
              }
            });
          }).then(function () { return obj; });
        });
      },

      del(table, id) {
        return clinic()
          .then(function () { return rest(table + '?id=eq.' + encodeURIComponent(id), { method: 'DELETE' }); })
          .then(function () { return true; });
      },

      clear(table) {
        // RLS confines this to the signed-in clinic.
        return clinic()
          .then(function () { return rest(table + '?id=not.is.null', { method: 'DELETE' }); })
          .then(function () { return true; });
      },

      wipe() {
        return CLINICAL_TABLES.reduce(function (chain, t) {
          return chain.then(function () { return this.clear(t); }.bind(this));
        }.bind(this), Promise.resolve());
      },

      raw() {
        var out = {};
        return CLINICAL_TABLES.reduce(function (chain, t) {
          return chain.then(function () {
            return this.all(t).then(function (rows) { out[t] = rows; });
          }.bind(this));
        }.bind(this), Promise.resolve()).then(function () { return out; });
      },

      load(snapshot) {
        return CLINICAL_TABLES.reduce(function (chain, t) {
          return chain.then(function () {
            var rows = snapshot[t] || [];
            return rows.reduce(function (c2, row) {
              return c2.then(function () { return this.put(t, row); }.bind(this));
            }.bind(this), Promise.resolve());
          }.bind(this));
        }.bind(this), Promise.resolve()).then(function () { return true; });
      }
    };
  }

  /* --------------------------------------------------------------- probing - */
  /** A real round-trip, so "connected" means connected. */
  function testConnection() {
    if (!configured()) {
      return Promise.resolve({ ok: false, reason: 'No backend URL or anon key is set.' });
    }
    return rest('patients?select=id&limit=1').then(function () {
      return clinic().then(function (c) {
        return { ok: true, clinicId: c.id, role: c.role };
      }).catch(function (e) {
        if (e.code === 'no_clinic') {
          return { ok: true, signedIn: true, clinicId: null,
            reason: 'Signed in, but this account has no clinic yet.' };
        }
        throw e;
      });
    }).catch(function (e) {
      return { ok: false, reason: e.message || String(e), status: e.status || null };
    });
  }

  CN.backend = {
    TABLES: CLINICAL_TABLES,
    BUCKET: BUCKET,
    loadConfig: loadConfig,
    saveConfig: saveConfig,
    configured: configured,
    hasSession: hasSession,
    currentUser: currentUser,
    currentRole: currentRole,
    signIn: signIn,
    signUp: signUp,
    signOut: signOut,
    refresh: refresh,
    clinic: clinic,
    bootstrapClinic: bootstrapClinic,
    inviteMember: inviteMember,
    rest: rest,
    rpc: rpc,
    uploadObject: uploadObject,
    signedUrl: signedUrl,
    removeObject: removeObject,
    createAdapter: function () { return RemoteAdapter(); },
    testConnection: testConnection
  };
})();

/* ==========================================================================
   NutriClinic Pro — charts.js
   Dependency-free SVG charts. No charting library is loaded, per the strict
   CSP (no CDN, no external assets).

   PALETTE INVARIANT: series colours are drawn only from navy #14213D,
   soft gold #C6A667 and burgundy #800020. No green is reachable from this
   module — not for a series, a marker or a threshold band.
   ========================================================================== */
(function () {
  'use strict';
  var CN = window.CN = window.CN || {};
  var U = CN.util;

  var C = { navy: '#14213D', gold: '#C6A667', burgundy: '#800020', gray: '#6B7280', line: '#E2E5EA' };
  var SERIES = ['navy', 'gold', 'burgundy'];

  function esc(s) { return U.esc(s); }
  function attr(v) { return U.round(v, 2); }

  /** Pick a "nice" axis step so ticks land on readable values. */
  function niceStep(range, ticks) {
    var raw = range / Math.max(1, ticks);
    var mag = Math.pow(10, Math.floor(Math.log(raw) / Math.LN10));
    var norm = raw / mag;
    var step;
    if (norm <= 1) step = 1; else if (norm <= 2) step = 2;
    else if (norm <= 2.5) step = 2.5; else if (norm <= 5) step = 5; else step = 10;
    return step * mag;
  }

  function extent(values) {
    var vals = values.filter(function (v) { return typeof v === 'number' && isFinite(v); });
    if (!vals.length) return { lo: 0, hi: 1 };
    return { lo: Math.min.apply(null, vals), hi: Math.max.apply(null, vals) };
  }

  /* ----------------------------------------------------------------- line -- */
  /**
   * line({
   *   width, height, series: [{ name, color, points: [{ x, y }], dashed }],
   *   yTicks, xLabels: [..], yUnit, targetLines: [{ value, label }],
   *   yPadTop, yPadBottom, emptyText
   * })
   */
  function line(cfg) {
    cfg = cfg || {};
    var W = cfg.width || 680, H = cfg.height || 280;
    var pad = { l: 56, r: 18, t: 18, b: 38 };
    var series = (cfg.series || []).filter(function (s) { return s.points && s.points.length; });

    if (!series.length) {
      return '<div class="empty" style="padding:1.6rem">' + esc(cfg.emptyText || 'No data to plot') + '</div>';
    }

    var allY = [], allX = [];
    series.forEach(function (s) {
      s.points.forEach(function (p) {
        if (typeof p.y === 'number' && isFinite(p.y)) allY.push(p.y);
        allX.push(p.x);
      });
    });

    var ex = extent(allY);
    var span = Math.max(0.0001, ex.hi - ex.lo);
    var padTop = ex.hi + (cfg.yPadTop === undefined ? span * 0.12 : cfg.yPadTop);
    var padBot = ex.lo - (cfg.yPadBottom === undefined ? span * 0.12 : cfg.yPadBottom);
    var step = niceStep(padTop - padBot, cfg.yTicks || 4);
    var yLo = Math.floor(padBot / step) * step;
    var yHi = Math.ceil(padTop / step) * step;
    if (yHi === yLo) yHi = yLo + step;

    var n = Math.max.apply(null, series.map(function (s) { return s.points.length; }));
    var xAt = function (i) {
      if (n === 1) return pad.l + (W - pad.l - pad.r) / 2;
      return pad.l + (i / (n - 1)) * (W - pad.l - pad.r);
    };
    var yAt = function (v) {
      return pad.t + (1 - (v - yLo) / (yHi - yLo)) * (H - pad.t - pad.b);
    };

    var out = ['<svg class="chart" viewBox="0 0 ' + W + ' ' + H + '" role="img" preserveAspectRatio="xMidYMid meet">'];

    // horizontal gridlines + y labels
    for (var v = yLo; v <= yHi + 1e-9; v += step) {
      var yy = attr(yAt(v));
      out.push('<line class="grid-line" x1="' + pad.l + '" y1="' + yy + '" x2="' + (W - pad.r) + '" y2="' + yy + '"/>');
      out.push('<text class="axis-label" x="' + (pad.l - 8) + '" y="' + (yAt(v) + 4) +
        '" text-anchor="end">' + esc(U.nf(v, step < 1 ? 1 : 0)) + '</text>');
    }

    // target / threshold lines
    (cfg.targetLines || []).forEach(function (tl) {
      if (typeof tl.value !== 'number') return;
      var ty = yAt(tl.value);
      if (ty < pad.t || ty > H - pad.b) return;
      out.push('<line class="target-line" x1="' + pad.l + '" y1="' + attr(ty) + '" x2="' + (W - pad.r) + '" y2="' + attr(ty) + '"/>');
      if (tl.label) {
        out.push('<text class="axis-label" x="' + (W - pad.r) + '" y="' + attr(ty - 5) +
          '" text-anchor="end">' + esc(tl.label) + '</text>');
      }
    });

    // series
    series.forEach(function (s, si) {
      var tone = s.color || SERIES[si % SERIES.length];
      var pts = s.points.filter(function (p) { return typeof p.y === 'number' && isFinite(p.y); });
      if (!pts.length) return;

      var d = pts.map(function (p, i) { return (i ? 'L' : 'M') + attr(xAt(i)) + ' ' + attr(yAt(p.y)); }).join(' ');
      out.push('<path class="series-line' + (s.dashed || si === 1 ? ' alt' : '') + '" d="' + d +
        '"' + (tone === 'burgundy' ? ' style="stroke:#800020"' : '') + '/>');

      pts.forEach(function (p, i) {
        out.push('<circle class="point' + (si === 1 ? ' alt' : '') + '" cx="' + attr(xAt(i)) + '" cy="' +
          attr(yAt(p.y)) + '" r="3.4"><title>' + esc(p.tip || (p.y + ' ' + (cfg.yUnit || ''))) + '</title></circle>');
      });
    });

    // x labels
    var labels = cfg.xLabels || [];
    labels.forEach(function (lb, i) {
      if (!lb) return;
      out.push('<text class="axis-label" x="' + attr(xAt(i)) + '" y="' + (H - 14) +
        '" text-anchor="middle">' + esc(lb) + '</text>');
    });

    out.push('</svg>');
    return out.join('');
  }

  /* ------------------------------------------------------------------ bars -- */
  /**
   * bar({ width, height, bars: [{ label, value, tone, tip }], yUnit,
   *       target: number, emptyText })
   * tone: 'navy' | 'gold' | 'alert'  (never green)
   */
  function bar(cfg) {
    cfg = cfg || {};
    var W = cfg.width || 680, H = cfg.height || 260;
    var pad = { l: 56, r: 18, t: 18, b: 46 };
    var bars = cfg.bars || [];
    if (!bars.length) {
      return '<div class="empty" style="padding:1.6rem">' + esc(cfg.emptyText || 'No data to plot') + '</div>';
    }

    var vals = bars.map(function (b) { return Number(b.value) || 0; });
    var hi = Math.max.apply(null, vals.concat([cfg.target || 0]));
    var step = niceStep(hi || 1, 4);
    var yHi = Math.ceil((hi || 1) * 1.1 / step) * step;
    var yAt = function (v) { return pad.t + (1 - v / yHi) * (H - pad.t - pad.b); };

    var innerW = W - pad.l - pad.r;
    var slot = innerW / bars.length;
    var bw = Math.max(4, Math.min(cfg.maxBarWidth || 64, slot * 0.62));

    var out = ['<svg class="chart" viewBox="0 0 ' + W + ' ' + H + '" role="img" preserveAspectRatio="xMidYMid meet">'];

    for (var v = 0; v <= yHi + 1e-9; v += step) {
      out.push('<line class="grid-line" x1="' + pad.l + '" y1="' + attr(yAt(v)) + '" x2="' + (W - pad.r) +
        '" y2="' + attr(yAt(v)) + '"/>');
      out.push('<text class="axis-label" x="' + (pad.l - 8) + '" y="' + attr(yAt(v) + 4) +
        '" text-anchor="end">' + esc(U.nf(v, 0)) + '</text>');
    }

    bars.forEach(function (b, i) {
      var cx = pad.l + slot * (i + 0.5);
      var hgt = Math.max(0, yAt(0) - yAt(Number(b.value) || 0));
      var cls = b.tone === 'alert' ? 'bar-rect alert' : (b.tone === 'gold' ? 'bar-rect alt' : 'bar-rect');
      out.push('<rect class="' + cls + '" x="' + attr(cx - bw / 2) + '" y="' + attr(yAt(Number(b.value) || 0)) +
        '" width="' + attr(bw) + '" height="' + attr(hgt) + '" rx="3"><title>' +
        esc(b.tip || (b.label + ': ' + (b.value === null || b.value === undefined ? '—' : b.value) + ' ' + (cfg.yUnit || ''))) +
        '</title></rect>');
      // Value above the bar when there is room.
      if (b.showValue !== false && bw >= 20) {
        out.push('<text class="axis-label" x="' + attr(cx) + '" y="' + attr(yAt(Number(b.value) || 0) - 6) +
          '" text-anchor="middle">' + esc(U.nf(Number(b.value) || 0, 0)) + '</text>');
      }
      // x label, wrapped to two lines
      var parts = String(b.label || '').split(/\s+/);
      var l1 = parts.slice(0, Math.ceil(parts.length / 2)).join(' ');
      var l2 = parts.slice(Math.ceil(parts.length / 2)).join(' ');
      out.push('<text class="axis-label" x="' + attr(cx) + '" y="' + (H - 26) +
        '" text-anchor="middle">' + esc(l1) + '</text>');
      if (l2) {
        out.push('<text class="axis-label" x="' + attr(cx) + '" y="' + (H - 13) +
          '" text-anchor="middle">' + esc(l2) + '</text>');
      }
    });

    out.push('</svg>');
    return out.join('');
  }

  /* ----------------------------------------------------------------- donut -- */
  /**
   * donut({ size, segments: [{ label, value, tone }], centerLabel, centerValue })
   */
  function donut(cfg) {
    cfg = cfg || {};
    var size = cfg.size || 200;
    var segs = (cfg.segments || []).filter(function (s) { return Number(s.value) > 0; });
    if (!segs.length) {
