      Promise.all([
        CN.store.settings(),
        CN.store.byPatient('measurements', patient.id),
        CN.store.byPatient('assessments', patient.id),
        CN.planHelpers.loadPlan(patient.id)
      ]).then(function (r) {
        var settings = r[0];
        var ms = U.sortBy(r[1], 'measuredAt', 'desc');
        var assessments = r[2];
        var planVersion = CN.planHelpers.activeVersion(r[3]);
        var latest = ms[0] || null;

        if (!latest || !latest.weightKg || !latest.heightCm) {
          host.innerHTML += CN.empty(CN.t('en.needMeasure'), '',
            '<button class="btn btn-primary" data-go="bodyComp">' + U.esc(CN.t('nav.bodyComp')) + '</button>');
          U.on(host, 'click', '[data-go]', function (e, el) { CN.app.go(el.getAttribute('data-go')); });
          return;
        }

        var age = U.ageFrom(patient.dob);

        var html = '';

        /* --- the calculation chain, at a glance ---------------------------
           BMR → TDEE → deficit/surplus → approved target → diet plan.
           Each stage states whether it is complete, so a clinician can see
           exactly where the workflow currently stands. */
        var approvedNow = ui.approvedAssessment(assessments, patient.id);
        var haveInputs = !!(latest && latest.weightKg && latest.heightCm);
        var chain = [
          { key: 'en.step1', done: haveInputs },
          { key: 'en.step2', done: haveInputs },
          { key: 'en.step3', done: !!approvedNow },
          { key: 'en.target', done: !!approvedNow },
          { key: 'pl.title', done: !!planVersion }
        ];
        html += ui.card('common.summary',
          '<div class="row tight">' + chain.map(function (c, i) {
            return '<span class="chip' + (c.done ? ' navy' : '') + '">' +
              (c.done ? CN.icon('check', 12) : (i + 1) + '.') + ' ' +
              U.esc(CN.t(c.key)) + '</span>' +
              (i < chain.length - 1 ? ' <span class="muted">→</span> ' : '');
          }).join('') + '</div>' +
          (haveInputs && !approvedNow
            ? ui.notice(CN.t('en.approvalNote'), 'warn') : ''));

        // ---- Step 1: BMR -------------------------------------------------
        html += ui.card('en.step1',
          '<div class="inline-fields">' +
          '<div class="field"><label for="e-formula">' + U.esc(CN.t('en.formula')) + '</label>' +
            '<select id="e-formula">' + CN.options([
              { value: 'mifflin_st_jeor', label: CN.engine.FORMULAS.mifflin_st_jeor.en },
              { value: 'harris_benedict', label: CN.engine.FORMULAS.harris_benedict.en },
              { value: 'harris_benedict_revised', label: CN.engine.FORMULAS.harris_benedict_revised.en },
              { value: 'device_measured', label: CN.engine.FORMULAS.device_measured.en },
              { value: 'manual', label: CN.engine.FORMULAS.manual.en }
            ], settings.defaultFormula) + '</select></div>' +
          '<div class="field"><label for="e-weight">' + U.esc(CN.t('pat.weight')) + ' (kg)</label>' +
            '<input id="e-weight" type="number" step="0.1" value="' + U.esc(latest.weightKg) + '"/></div>' +
          '<div class="field"><label for="e-height">' + U.esc(CN.t('new.height')) + ' (cm)</label>' +
            '<input id="e-height" type="number" step="0.5" value="' + U.esc(latest.heightCm) + '"/></div>' +
          '<div class="field"><label for="e-age">' + U.esc(CN.t('pat.age')) + '</label>' +
            '<input id="e-age" type="number" value="' + U.esc(age === null ? '' : age) + '"/></div>' +
          '<div class="field" id="e-override-wrap" style="display:none">' +
            '<label for="e-override">' + U.esc(CN.t('en.bmrManual')) + ' (kcal)</label>' +
            '<input id="e-override" type="number" step="1"/></div>' +
          '</div>' +
          '<div id="e-bmr-out"></div>') ;

        // ---- Step 2: TDEE ------------------------------------------------
        html += ui.card('en.step2',
          '<div class="inline-fields">' +
          '<div class="field"><label for="e-activity">' + U.esc(CN.t('en.activity')) + '</label>' +
            '<select id="e-activity">' + CN.options(Object.keys(CN.engine.ACTIVITY).map(function (k) {
              return { value: k, label: CN.engine.ACTIVITY[k].en };
            }), settings.defaultActivity) + '</select></div>' +
          '<div class="field"><label for="e-factor">' + U.esc(CN.t('en.multiplier')) + '</label>' +
            '<input id="e-factor" type="number" step="0.005"/></div>' +
          '</div>' +
          '<div id="e-tdee-out"></div>' +
          '<p class="muted" style="font-size:.83rem">' + U.esc(CN.t('en.tdeeHint')) + '</p>');

        // ---- Step 3: target ---------------------------------------------
        html += ui.card('en.step3',
          '<div class="inline-fields">' +
          '<div class="field"><label for="e-goal">' + U.esc(CN.t('en.goal')) + '</label>' +
            '<select id="e-goal">' + CN.options([
              { value: 'weight_loss', label: CN.t('goal.weight_loss') },
              { value: 'maintenance', label: CN.t('goal.maintenance') },
              { value: 'weight_gain', label: CN.t('goal.weight_gain') },
              { value: 'therapeutic', label: CN.t('goal.therapeutic') }
            ], patient.goal || 'weight_loss') + '</select></div>' +
          '<div class="field"><label for="e-band">' + U.esc(CN.t('en.deficit')) + ' / ' + U.esc(CN.t('en.surplus')) + '</label>' +
            '<select id="e-band">' +
            '<optgroup label="' + U.esc(CN.t('en.deficit')) + '">' +
            CN.options([
              { value: 'mild', label: CN.engine.DEFICIT_BANDS.mild.en },
              { value: 'moderate', label: CN.engine.DEFICIT_BANDS.moderate.en },
              { value: 'larger', label: CN.engine.DEFICIT_BANDS.larger.en }
            ], settings.defaultDeficit) + '</optgroup>' +
            '<optgroup label="' + U.esc(CN.t('en.surplus')) + '">' +
            CN.options([
              { value: 'mild', label: CN.engine.SURPLUS_BANDS.mild.en },
              { value: 'moderate', label: CN.engine.SURPLUS_BANDS.moderate.en },
              { value: 'larger', label: CN.engine.SURPLUS_BANDS.larger.en }
            ], settings.defaultSurplus) + '</optgroup>' +
            '</select></div>' +
          '</div>' +
          '<div id="e-target-out"></div>');

        // ---- Step 4: macros ---------------------------------------------
        html += ui.card('en.step4',
          '<div class="inline-fields">' +
          '<div class="field"><label for="e-method">' + U.esc(CN.t('en.method')) + '</label>' +
            '<select id="e-method">' + CN.options([
              { value: 'percent', label: CN.t('en.methodPercent') },
              { value: 'per_kg', label: CN.t('en.methodPerKg') },
              { value: 'hybrid', label: CN.t('en.methodHybrid') }
            ], 'hybrid') + '</select></div>' +
          '<div class="field"><label for="e-profile">' + U.esc(CN.t('pl.approaches')) + '</label>' +
            '<select id="e-profile">' + CN.options(
              [{ value: '', label: CN.t('common.none') }].concat(CN.approaches.all.map(function (a) {
                return { value: a.code, label: a.nameEn };
              })), 'mediterranean') + '</select></div>' +
          '</div>' +
          '<div id="e-macro-out"></div>');

        // ---- history + approval -----------------------------------------
        var approved = ui.approvedAssessment(assessments, patient.id);
        if (approved) {
          html += ui.card('en.approvedBy',
            '<p>' + U.esc(CN.t('en.target')) + ': <strong>' + U.nf(approved.targetKcal, 0) + ' kcal</strong> · ' +
            U.esc(U.fmtDate(approved.assessedAt)) + '</p>' +
            '<p class="muted" style="font-size:.83rem">' + U.esc(CN.t('en.approvalNote')) + '</p>');
        }

        if (assessments.length) {
          var hist = U.sortBy(assessments, 'assessedAt', 'desc');
          html += ui.card('bc.history',
            '<div class="table-wrap"><table class="tbl compact"><thead><tr>' +
            '<th>' + U.esc(CN.t('common.date')) + '</th>' +
            '<th class="num">' + U.esc(CN.t('en.bmr')) + '</th>' +
            '<th class="num">' + U.esc(CN.t('en.tdee')) + '</th>' +
            '<th class="num">' + U.esc(CN.t('en.target')) + '</th>' +
            '<th>' + U.esc(CN.t('common.status')) + '</th></tr></thead><tbody>' +
            hist.map(function (a) {
              return '<tr><td>' + U.esc(U.fmtDate(a.assessedAt)) + '</td>' +
                '<td class="num">' + ui.num(a.bmr, 0) + '</td>' +
                '<td class="num">' + ui.num(a.tdee, 0) + '</td>' +
                '<td class="num"><strong>' + ui.num(a.targetKcal, 0) + '</strong></td>' +
                '<td>' + (a.approvedAt
                  ? ui.tag(CN.t('en.approvedBy'), 'navy')
                  : ui.tag(CN.t('en.notApproved'), 'gold')) + '</td></tr>';
            }).join('') + '</tbody></table></div>');
        }

        host.innerHTML += html;

        /* ---- computation, run on every change ---- */
        function compute() {
          var formula = U.$('#e-formula').value;
          U.$('#e-override-wrap').style.display =
            (formula === 'device_measured' || formula === 'manual') ? '' : 'none';

          var input = {
            weightKg: U.parseNum(U.$('#e-weight').value),
            heightCm: U.parseNum(U.$('#e-height').value),
            age: U.parseNum(U.$('#e-age').value),
            sex: patient.sex,
            formula: formula,
            overrideValue: U.parseNum(U.$('#e-override').value),
            activity: U.$('#e-activity').value,
            activityOverride: U.parseNum(U.$('#e-factor').value),
            goal: U.$('#e-goal').value,
            band: U.$('#e-band').value,
            patient: patient
          };

          var b = CN.engine.bmr(input);
          var bmrOut = U.$('#e-bmr-out');
          if (!b) {
            bmrOut.innerHTML = ui.notice(CN.t('en.needMeasure'), 'warn');
            U.$('#e-tdee-out').innerHTML = '';
            U.$('#e-target-out').innerHTML = '';
            U.$('#e-macro-out').innerHTML = '';
            return;
          }
          bmrOut.innerHTML = '<div class="row">' +
            '<div class="stat" style="flex:1"><div class="stat-label">' + U.esc(CN.t('en.bmr')) + '</div>' +
            '<div class="stat-value">' + U.nf(b.value, 0) + ' <small>kcal</small></div>' +
            '<div class="stat-foot">' + U.esc(b.isEstimated ? CN.t('en.bmrEst') : CN.t('en.bmrDevice')) +
            ' · ' + U.esc(b.formulaLabel) + '</div></div></div>' +
            ui.notice(CN.t('en.bmrHint'), 'info');

          var result = CN.engine.assess(input);
          if (!result.ok) return;

          U.$('#e-tdee-out').innerHTML = '<div class="stat"><div class="stat-label">' +
            U.esc(CN.t('en.tdee')) + '</div><div class="stat-value">' + U.nf(result.tdee, 0) +
            ' <small>kcal</small></div><div class="stat-foot">' +
            U.esc(CN.t('en.multiplier')) + ' × ' + U.nf(result.activityFactor, 3) + '</div></div>';

          // Target panel, including every safety flag the engine raised.
          var flagHtml = '';
          if (result.flags.length) {
            flagHtml = '<h4>' + U.esc(CN.t('en.safety')) + '</h4>' + result.flags.map(function (f) {
              var tone = f.level === 'alert' ? 'alert' : (f.level === 'warn' ? 'warn' : 'info');
              return ui.notice(CN.i18n.lang === 'ar' ? (f.ar || f.en) : f.en, tone);
            }).join('');
          } else {
            flagHtml = ui.notice(CN.t('en.noFlags'), 'ok');
          }

          var rate = result.weeklyRateKg;
          var rateHtml = (rate && result.goal !== 'maintenance')
            ? '<div class="stat"><div class="stat-label">' + U.esc(CN.t('en.rate')) + '</div>' +
              '<div class="stat-value">' + (rate > 0 ? '+' : '') + U.nf(rate, 2) +
              ' <small>kg/week</small></div>' +
              '<div class="stat-foot">≈ ' + U.nf(Math.abs(result.monthlyRateKg), 1) +
              ' kg/month at this rate</div></div>'
            : '';

          U.$('#e-target-out').innerHTML =
            '<div class="grid cols-3 mb2">' +
            '<div class="stat accent"><div class="stat-label">' + U.esc(CN.t('en.target')) + '</div>' +
              '<div class="stat-value">' + U.nf(result.targetKcal, 0) + ' <small>kcal</small></div>' +
              '<div class="stat-foot">' + (result.goal === 'maintenance' ? U.esc(CN.t('en.maintenance'))
                : (result.band ? U.esc(result.band.en) : '') + ' · ' +
                  (result.deltaKcal > 0 ? '+' : '') + U.nf(result.deltaKcal, 0) + ' kcal') + '</div></div>' +
            rateHtml +
            '<div class="stat' + (result.requiresReview ? ' alert' : '') + '"><div class="stat-label">' +
              U.esc(CN.t('en.safety')) + '</div><div class="stat-value">' +
              (result.requiresReview ? '!' : '✓') + '</div><div class="stat-foot">' +
              U.esc(result.requiresReview
                ? (CN.i18n.lang === 'ar' ? 'يتطلب مراجعة' : 'Requires review')
                : CN.t('en.noFlags')) + '</div></div>' +
            '</div>' +
            '<h4>' + U.esc(CN.t('en.explain')) + '</h4>' +
            '<ul style="margin:0 0 1rem 1.1rem;font-size:.88rem">' +
            result.rationale.map(function (x) { return '<li>' + U.esc(x) + '</li>'; }).join('') + '</ul>' +
            flagHtml +
            '<div class="btn-row"><button class="btn btn-primary" id="e-approve">' +
              CN.icon('check', 16) + ' ' + U.esc(CN.t('en.approve')) + '</button></div>';

          // Macros
          var code = U.$('#e-profile').value;
          var profile = code && CN.approaches.byCode(code)
            ? CN.approaches.byCode(code).macros
            : { proteinPct: 20, carbPct: 45, fatPct: 35 };
          profile = profile || { proteinPct: 20, carbPct: 45, fatPct: 35 };
          var limits = code ? CN.approaches.mergedLimits([code]) : {};
          var macros = CN.engine.macros({
            targetKcal: result.targetKcal,
            weightKg: input.weightKg,
            profile: profile,
            method: U.$('#e-method').value,
            proteinPerKg: limits.proteinPerKg || 0.8,
            fiberMin: limits.fiberMin,
            sodiumMaxMg: limits.sodiumMaxMg
          });

          U.$('#e-macro-out').innerHTML =
            '<div class="grid cols-3">' +
            '<div class="stat"><div class="stat-label">' + U.esc(CN.t('en.protein')) + '</div>' +
              '<div class="stat-value">' + U.nf(macros.proteinG, 0) + ' <small>g</small></div>' +
              '<div class="stat-foot">' + U.nf(macros.proteinPct, 0) + '% · ' +
              U.nf(macros.proteinPerKg, 1) + ' g/kg</div></div>' +
            '<div class="stat"><div class="stat-label">' + U.esc(CN.t('en.carb')) + '</div>' +
              '<div class="stat-value">' + U.nf(macros.carbG, 0) + ' <small>g</small></div>' +
              '<div class="stat-foot">' + U.nf(macros.carbPct, 0) + '%</div></div>' +
            '<div class="stat"><div class="stat-label">' + U.esc(CN.t('en.fat')) + '</div>' +
              '<div class="stat-value">' + U.nf(macros.fatG, 0) + ' <small>g</small></div>' +
              '<div class="stat-foot">' + U.nf(macros.fatPct, 0) + '%</div></div>' +
            '</div>' +
            '<div class="row tight" style="margin-top:.8rem">' +
              ui.tag(CN.t('en.fiber') + ' ' + macros.fiberG + ' g') +
              ui.tag(CN.t('en.sodium') + ' ≤ ' + U.nf(macros.sodiumMaxMg, 0) + ' mg') +
              ui.tag(CN.t('en.fluid') + ' ≈ ' + U.nf(macros.fluidMl, 0) + ' ml') +
            '</div>';

          // Approval records the assessment; nothing downstream uses an
          // unapproved target.
          U.on(U.$('#e-target-out'), 'click', '#e-approve', function () {
            CN.store.put('assessments', {
              id: U.uid('asm'),
              patientId: patient.id,
              assessedAt: new Date().toISOString(),
              measurementId: latest.id,
              formula: result.bmrFormula,
              bmr: result.bmr, bmrIsEstimated: result.bmrIsEstimated,
              tdee: result.tdee,
              activityFactor: result.activityFactor,
              activityKey: result.activityKey,
              goal: result.goal,
              bandKey: result.bandKey,
              deltaKcal: result.deltaKcal,
              targetKcal: result.targetKcal,
              weeklyRateKg: result.weeklyRateKg,
              bmi: result.bmi,
              weightKg: input.weightKg,
              heightCm: input.heightCm,
              age: input.age,
              macros: macros,
              profileCode: code,
              rationale: result.rationale,
              flags: result.flags,
              requiresReview: result.requiresReview,
              approvedAt: new Date().toISOString(),
              approvedBy: 'clinician'
            }).then(function () {
              CN.toast(CN.t('en.approved'));
              CN.app.refresh();
            });
          });
        }

        // The activity factor field mirrors the selected activity level.
        function syncFactor() {
          var a = CN.engine.ACTIVITY[U.$('#e-activity').value] || CN.engine.ACTIVITY.moderate;
          U.$('#e-factor').value = a.factor;
        }
        syncFactor();

        ['#e-formula', '#e-weight', '#e-height', '#e-age', '#e-override', '#e-activity',
         '#e-goal', '#e-band', '#e-method', '#e-profile'].forEach(function (sel) {
          U.on(host, 'input', sel, compute);
          U.on(host, 'change', sel, function () {
            if (sel === '#e-activity') syncFactor();
            compute();
          });
        });
        U.on(host, 'input', '#e-factor', compute);

        compute();
      });
    }
  };

  /* ------------------------------------------------------- Body Composition */
  var BodyComp = {
    title: 'nav.bodyComp',

    render(host, ctx) {
      var patient = ctx.patient;
      if (!patient) { ui.needPatient(host); return; }

      host.innerHTML = ui.pageHead('bc.title', 'bc.subtitle',
        '<button class="btn btn-primary" id="bc-new">' + CN.icon('plus', 16) + ' ' +
        U.esc(CN.t('bc.newMeasurement')) + '</button>' +
        '<button class="btn" id="bc-chart">' + CN.icon('activity', 16) + ' ' + U.esc(CN.t('bc.trend')) + '</button>');

      CN.store.byPatient('measurements', patient.id).then(function (rows) {
        var ms = U.sortBy(rows, 'measuredAt', 'asc');
        if (!ms.length) {
          host.innerHTML += CN.empty(CN.t('bc.none'), CN.t('bc.noneMsg'),
            '<button class="btn btn-primary" data-new="1">' + U.esc(CN.t('bc.newMeasurement')) + '</button>');
          U.on(host, 'click', '#bc-new, [data-new]', function () { BodyComp.openNew(patient); });
          return;
        }

        var target = ms[ms.length - 1].targetWeightKg;
        var prog = CN.engine.progress(ms, target);
        var html = '';

        if (prog) {
          html += '<div class="grid cols-4 mb2">' +
            ui.stat('pat.weight', U.nf(prog.lastWeight, 1) + ' <small>kg</small>', U.fmtDate(prog.lastDate), 'accent') +
            ui.stat('bc.delta', (prog.totalChange > 0 ? '+' : '') + U.nf(prog.totalChange, 1) + ' <small>kg</small>',
              prog.days + ' ' + CN.t('common.days') + ' · ' + U.nf(prog.weeklyChange, 2) + ' kg/wk') +
            ui.stat('pat.bmi', U.nf(prog.bmiLast, 1) + ' <small>' + U.esc(CN.t('sex.' + (patient.sex || 'undisclosed'))) + '</small>',
              CN.i18n.lang === 'ar' ? CN.engine.bmiClass(prog.bmiLast).ar : CN.engine.bmiClass(prog.bmiLast).en,
              CN.engine.bmiClass(prog.bmiLast).level === 'alert' ? 'alert' : '') +
            (prog.fatChange !== null
              ? ui.stat('new.bodyFat', (prog.fatChange > 0 ? '+' : '') + U.nf(prog.fatChange, 1) + ' <small>%</small>',
                  prog.leanChange !== null ? (CN.i18n.lang === 'ar' ? 'تغير الكتلة العضلية ' : 'lean mass ') +
                    (prog.leanChange > 0 ? '+' : '') + U.nf(prog.leanChange, 1) + ' kg' : '')
              : ui.stat('new.bodyFat', '<span class="muted">—</span>')) +
            '</div>';
        }

        // Weight chart with the target line where one is set.
        var labels = ms.map(function (m) { return U.fmtDate(m.measuredAt, { day: '2-digit', month: 'short' }); });
        html += ui.card('bc.trend',
          CN.charts.line({
            height: 280,
            series: [{ name: CN.t('pat.weight'), color: 'navy',
              points: ms.map(function (m, i) { return { x: i, y: m.weightKg, tip: U.fmtDate(m.measuredAt) + ': ' + m.weightKg + ' kg' }; }) }],
            xLabels: labels,
            targetLines: prog && prog.targetWeightKg ? [{ value: prog.targetWeightKg, label: CN.t('common.target') + ' ' + prog.targetWeightKg + ' kg' }] : [],
            yUnit: 'kg'
          }) +
          CN.charts.legend([
            { label: CN.t('pat.weight'), tone: 'navy' },
            (prog && prog.targetWeightKg ? { label: CN.t('common.target'), tone: 'burgundy' } : null)
          ].filter(Boolean)));

        // BMI and body-fat series, when enough points exist.
        var bmiPts = ms.map(function (m, i) {
          return { x: i, y: CN.engine.bmi(m.heightCm, m.weightKg), tip: U.fmtDate(m.measuredAt) };
        }).filter(function (p) { return p.y !== null; });
        if (bmiPts.length > 1) {
          html += ui.card('bc.bmiTrend', CN.charts.line({ height: 220, series: [{ name: 'BMI', color: 'navy', points: bmiPts }], xLabels: labels }));
        }
        var fatPts = ms.map(function (m, i) {
          return { x: i, y: m.bodyFatPct, tip: U.fmtDate(m.measuredAt) };
        }).filter(function (p) { return p.y !== null && p.y !== undefined; });
        if (fatPts.length > 1) {
          html += ui.card('bc.fatTrend',
            CN.charts.line({ height: 220, series: [{ name: 'Body fat %', color: 'gold', points: fatPts }], xLabels: labels }));
        }

        // History table, newest first.
        var desc = ms.slice().reverse();
        html += ui.card('bc.history',
          '<div class="table-wrap"><table class="tbl compact"><thead><tr>' +
          '<th>' + U.esc(CN.t('common.date')) + '</th>' +
          '<th class="num">' + U.esc(CN.t('pat.weight')) + '</th>' +
          '<th class="num">' + U.esc(CN.t('pat.bmi')) + '</th>' +
          '<th class="num">' + U.esc(CN.t('new.waist')) + '</th>' +
          '<th class="num">' + U.esc(CN.t('new.bodyFat')) + '</th>' +
          '<th class="num">' + U.esc(CN.t('new.muscle')) + '</th>' +
          '<th>' + U.esc(CN.t('bc.source')) + '</th>' +
          '<th></th></tr></thead><tbody>' +
          desc.map(function (m) {
            return '<tr><td>' + U.esc(U.fmtDate(m.measuredAt)) + '</td>' +
              '<td class="num">' + ui.num(m.weightKg, 1) + '</td>' +
              '<td class="num">' + ui.num(CN.engine.bmi(m.heightCm, m.weightKg), 1) + '</td>' +
              '<td class="num">' + ui.num(m.waistCm, 1) + '</td>' +
              '<td class="num">' + ui.num(m.bodyFatPct, 1) + '</td>' +
              '<td class="num">' + ui.num(m.muscleMassKg, 1) + '</td>' +
              '<td>' + U.esc(CN.t('src.' + (m.source || 'clinic_scale'))) + '</td>' +
