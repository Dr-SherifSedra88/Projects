            '<input id="g-start" type="date" value="' + U.todayISO() + '"/></div>' +
          '<div class="field"><label for="g-template">' + U.esc(CN.t('pl.templates')) + '</label>' +
            '<select id="g-template">' + CN.options(
              [{ value: '', label: CN.t('common.none') }].concat(
                (templates || []).map(function (t) { return { value: t.id, label: t.name }; }))
            ) + '</select></div>' +
          '</div>' +
          '<div class="field"><label>' + U.esc(CN.t('pl.approaches')) + '</label>' +
            '<div class="chip-row" id="g-approaches">' + CN.approaches.all.map(function (a) {
              var checked = (version && version.approachCodes || ['mediterranean']).indexOf(a.code) !== -1;
              return '<label class="check" style="margin:0"><input type="checkbox" value="' + a.code + '"' +
                (checked ? ' checked' : '') + '/> <span>' + U.esc(a.nameEn) + '</span></label>';
            }).join('') + '</div></div>' +
          '<div id="g-compat"></div>' +
          '<div class="btn-row">' +
            '<button class="btn btn-primary" id="g-generate">' + CN.icon('sparkles', 16) + ' ' +
              U.esc(CN.t('pl.generate')) + '</button>' +
            (version ? '<button class="btn" id="g-save-template">' + CN.icon('save', 16) + ' ' +
              U.esc(CN.t('pl.saveTemplate')) + '</button>' : '') +
          '</div>');

        /* ---- current plan ---- */
        if (version) {
          var adherence = CN.planner.adherenceToTarget(version);
          html += '<div class="grid cols-4 mb2">' +
            ui.stat('en.target', U.nf(version.targetKcal, 0) + ' <small>kcal</small>',
              version.approachCodes.map(function (c) {
                var a = CN.approaches.byCode(c); return a ? a.nameEn : c;
              }).join(' + '), 'accent') +
            ui.stat('pl.weekTotals', U.nf(adherence.average.kcal, 0) + ' <small>kcal</small>',
              (adherence.deviation.kcal > 0 ? '+' : '') + U.nf(adherence.deviation.kcal, 0) + ' vs target') +
            ui.stat('en.protein', U.nf(adherence.average.protein, 0) + ' <small>g</small>',
              version.macros && version.macros.proteinG
                ? (adherence.deviation.protein > 0 ? '+' : '') + U.nf(adherence.deviation.protein, 0) + ' g' : '') +
            ui.stat('common.status', ui.planStatus(version.status),
              CN.t('common.version') + ' ' + version.versionNo) +
            '</div>';

          // Deviation warnings — the plan must stay on its approved targets.
          var devHtml = '';
          if (adherence.kcalStatus !== 'on' && adherence.kcalStatus !== 'na') {
            var tone = adherence.kcalStatus === 'over' ? 'alert' : 'warn';
            devHtml += ui.notice(CN.t('pl.needApproval2') + ' ' +
              (adherence.kcalStatus === 'over' ? CN.t('pl.over') : CN.t('pl.under')) + ' — ' +
              (adherence.deviation.kcal > 0 ? '+' : '') + U.nf(adherence.deviation.kcal, 0) + ' kcal/day', tone);
          }
          if (adherence.sodiumOver > 0) {
            devHtml += ui.notice(CN.t('en.sodium') + ': +' + U.nf(adherence.sodiumOver, 0) + ' mg over the ceiling', 'warn');
          }
          (version.warnings || []).forEach(function (w) { devHtml += ui.notice(w, 'warn'); });
          if (devHtml) html += devHtml;

          html += ui.card(null, planMarkup(version),
            null, { flush: false });

          html += '<div class="btn-row mb2">' +
            (version.status !== 'approved'
              ? '<button class="btn btn-primary" id="g-approve">' + CN.icon('check', 16) + ' ' +
                U.esc(CN.t('pl.approve')) + '</button>' : '') +
            '<button class="btn" data-go="reports">' + CN.icon('printer', 16) + ' ' +
              U.esc(CN.t('nav.reports')) + '</button>' +
            '<button class="btn" data-go="followup">' + CN.icon('calendar', 16) + ' ' +
              U.esc(CN.t('nav.followup')) + '</button>' +
            '</div>';

          // Version history + diff
          if (plan.versions.length > 1) {
            html += ui.card('pl.versions',
              '<div class="table-wrap"><table class="tbl compact"><thead><tr>' +
              '<th>' + U.esc(CN.t('common.version')) + '</th>' +
              '<th>' + U.esc(CN.t('common.date')) + '</th>' +
              '<th class="num">' + U.esc(CN.t('en.target')) + '</th>' +
              '<th>' + U.esc(CN.t('common.status')) + '</th>' +
              '<th></th></tr></thead><tbody>' +
              U.sortBy(plan.versions, 'versionNo', 'desc').map(function (v) {
                return '<tr' + (v.id === version.id ? ' style="background:#F8FAFD"' : '') + '>' +
                  '<td>v' + U.esc(v.versionNo) + '</td>' +
                  '<td>' + U.esc(U.fmtDate(v.createdAt)) + '</td>' +
                  '<td class="num">' + ui.num(v.targetKcal, 0) + '</td>' +
                  '<td>' + ui.planStatus(v.status) + '</td>' +
                  '<td class="right"><button class="btn btn-xs" data-view-v="' + U.esc(v.id) + '">' +
                    U.esc(CN.t('common.view')) + '</button> ' +
                    '<button class="btn btn-xs" data-diff-v="' + U.esc(v.id) + '">' +
