    var W = opts.width || 120, H = opts.height || 32;
    var ex = extent(vals);
    var span = Math.max(0.0001, ex.hi - ex.lo);
    var d = vals.map(function (v, i) {
      var x = (i / (vals.length - 1)) * (W - 4) + 2;
      var y = H - 3 - ((v - ex.lo) / span) * (H - 6);
