        el.setAttribute('placeholder', i18n.t(el.getAttribute('data-i18n-ph')));
      });
    },

    restore() {
      var saved = null;
      try { saved = localStorage.getItem('cn.lang'); } catch (e) { /* ignore */ }
      i18n.setLang(saved || 'en');
    }
  };

  CN.i18n = i18n;
  CN.t = i18n.t;
})();

/* ==========================================================================
   NutriClinic Pro — kb.js
   Knowledge base: document ingestion, chunking and retrieval.

   HONEST CAPABILITY BOUNDARY
   A static build with no bundled libraries can read TEXT formats and nothing
   else. So this module:

     - genuinely ingests .txt .md .csv .tsv .json (parsed here, searchable now);
     - recognises .pdf .docx .xlsx as reference documents, stores the file for
       the clinician's own use, and states plainly that its TEXT cannot be
       extracted without a backend — it does not pretend otherwise;
     - exposes a documented remote adapter so a server can supply extraction and
       retrieval later, with no change to callers.

   No upload control here is decorative: every accepted format either produces
   searchable text or says exactly why it could not.
   ========================================================================== */
(function () {
  'use strict';
  var CN = window.CN = window.CN || {};
  var U = CN.util;

  var MAX_TEXT_BYTES = 5 * 1024 * 1024;   // refuse to freeze the tab
  var CHUNK_CHARS = 1200;
  var CHUNK_OVERLAP = 120;

  /* -------------------------------------------------------- parser registry */
  /**
   * spec: { label, native: true, parse(file) -> Promise<string> }
   * A parser marked `native: false` is recognised but cannot run here; the
   * backend is expected to supply it.
   */
  var PARSERS = {
    txt:  { label: 'Plain text',  native: true,  parse: readAsText },
    md:   { label: 'Markdown',    native: true,  parse: readAsText },
    csv:  { label: 'CSV',         native: true,  parse: readAsText },
    tsv:  { label: 'Tab-separated', native: true, parse: readAsText },
    json: { label: 'JSON',        native: true,  parse: readAsJsonText },
    pdf:  { label: 'PDF',         native: false, needs: 'server-side text extraction' },
    docx: { label: 'Word document', native: false, needs: 'server-side text extraction' },
    xlsx: { label: 'Excel workbook', native: false, needs: 'server-side text extraction' }
  };

  function readAsText(file) {
    return U.readFile(file);
  }

  /** JSON is re-serialised readably so numeric tables stay searchable. */
  function readAsJsonText(file) {
    return U.readFile(file).then(function (txt) {
      try { return JSON.stringify(JSON.parse(txt), null, 1); }
      catch (e) { return txt; }   // not valid JSON: keep the literal text
    });
  }

  function extOf(name) {
    var m = /\.([a-z0-9]+)$/i.exec(String(name || ''));
    return m ? m[1].toLowerCase() : '';
  }

  function registerParser(ext, spec) {
    PARSERS[String(ext).toLowerCase().replace(/^\./, '')] = spec;
  }

  function supportedExtensions() {
    return Object.keys(PARSERS).filter(function (k) { return PARSERS[k].native; });
  }
  function deferredExtensions() {
    return Object.keys(PARSERS).filter(function (k) { return !PARSERS[k].native; });
  }
  function isSupported(name) {
    var p = PARSERS[extOf(name)];
    return !!(p && p.native);
  }

  /* ------------------------------------------------------------- chunking -- */
  /**
   * Split on paragraph boundaries, then hard-wrap anything still oversized.
   * Overlap keeps a sentence that straddles a boundary retrievable.
   */
  function chunkText(text) {
    var clean = String(text || '').replace(/\r\n/g, '\n').replace(/\n{3,}/g, '\n\n').trim();
    if (!clean) return [];

    var parts = clean.split(/\n{2,}/);
    var chunks = [];
    var buf = '';

    function flush() {
      var t = buf.trim();
      if (t) chunks.push(t);
      buf = '';
    }

    parts.forEach(function (p) {
      if (p.length > CHUNK_CHARS) {
        flush();
        for (var i = 0; i < p.length; i += (CHUNK_CHARS - CHUNK_OVERLAP)) {
          chunks.push(p.slice(i, i + CHUNK_CHARS));
        }
        return;
      }
      if ((buf + '\n\n' + p).length > CHUNK_CHARS) flush();
      buf = buf ? (buf + '\n\n' + p) : p;
    });
    flush();

    return chunks.map(function (t, i) { return { i: i, text: t }; });
  }

  /* ------------------------------------------------------------ retrieval -- */
  function terms(q) {
    return String(q || '').toLowerCase().split(/[^\p{L}\p{N}]+/u)
      .filter(function (t) { return t.length > 1; });
  }

  function scoreChunk(text, ts) {
    var lower = text.toLowerCase();
    var score = 0;
    ts.forEach(function (t) {
      var idx = lower.indexOf(t);
      if (idx === -1) return;
      score += 1;
      // A second occurrence, or a match near the start, is a stronger signal.
      if (lower.indexOf(t, idx + 1) !== -1) score += 0.5;
      if (idx < 120) score += 0.25;
    });
    return score;
  }

  function snippet(text, ts) {
    var lower = text.toLowerCase();
    var at = -1;
    for (var i = 0; i < ts.length && at === -1; i++) at = lower.indexOf(ts[i]);
    if (at === -1) at = 0;
    var start = Math.max(0, at - 90);
    var s = text.slice(start, start + 300).replace(/\s+/g, ' ').trim();
    return (start > 0 ? '…' : '') + s + (start + 300 < text.length ? '…' : '');
  }

  /* ---------------------------------------------------------- remote layer -- */
  /**
   * Backend adapter contract. A server implementation should expose:
   *
   *   POST {base}/documents            multipart file  -> { id, title, chunks }
   *   GET  {base}/search?q=&limit=     -> [{ docId, title, snippet, page }]
   *   DELETE {base}/documents/{id}     -> 204
   *
   * Until a base URL is configured the local index is the only source, and the
   * interface says so.
   */
  var remote = {
    endpoint: null,
    setEndpoint(url) { remote.endpoint = url || null; return remote; },
    configured() { return !!remote.endpoint; },
    search(q, limit) {
      if (!remote.configured()) return Promise.resolve([]);
      return fetch(remote.endpoint.replace(/\/$/, '') + '/search?q=' +
          encodeURIComponent(q) + '&limit=' + (limit || 6),
          { credentials: 'omit' })
        .then(function (r) { return r.ok ? r.json() : []; })
        .catch(function () { return []; });   // offline: local results still stand
    }
  };

  /* ------------------------------------------------------------- ingestion - */
  /**
   * ingest(file) -> Promise of one of:
   *   { status:'ingested', doc }
   *   { status:'deferred', ext, needs, note }   recognised, not extractable here
   *   { status:'rejected', reason }
   */
  function ingest(file) {
    if (!file) return Promise.resolve({ status: 'rejected', reason: 'No file.' });
    var ext = extOf(file.name);
    var parser = PARSERS[ext];

    if (!parser) {
      return Promise.resolve({
        status: 'rejected',
        reason: 'Unrecognised file type "' + (ext || '?') +
          '". Supported here: ' + supportedExtensions().join(', ') + '.'
      });
    }

    if (!parser.native) {
      // Say precisely what is missing rather than appearing to succeed.
      return Promise.resolve({
        status: 'deferred', ext: ext, needs: parser.needs,
        note: parser.label + ' files can be stored for reference, but their text cannot be ' +
          'extracted in this build (' + parser.needs + ' is required). Configure the knowledge-base ' +
          'endpoint in Settings to have a server index them.'
      });
    }

    if (file.size > MAX_TEXT_BYTES) {
      return Promise.resolve({
        status: 'rejected',
        reason: 'File is larger than ' + Math.round(MAX_TEXT_BYTES / 1024 / 1024) +
          ' MB and was not indexed.'
      });
    }

    return parser.parse(file).then(function (text) {
      var chunks = chunkText(text);
      if (!chunks.length) {
        return { status: 'rejected', reason: 'No readable text was found in that file.' };
      }
      var doc = {
        id: U.uid('kbd'),
        title: file.name,
        ext: ext,
        mime: file.type || '',
        byteSize: file.size,
        addedAt: new Date().toISOString(),
        source: 'upload',
        chunks: chunks,
        textChars: String(text).length
      };
      return CN.store.put('kb', doc).then(function () {
        CN.bus.emit('kb', { action: 'ingest', id: doc.id });
        return { status: 'ingested', doc: doc };
      });
    }).catch(function (e) {
      return { status: 'rejected', reason: (e && e.message) || 'The file could not be read.' };
    });
  }

  /** Search the local index, merged with the remote adapter when configured. */
  function search(q, limit) {
    var ts = terms(q);
    var lim = limit || 8;

    var local = (!ts.length ? Promise.resolve([]) : CN.store.all('kb').then(function (docs) {
      var hits = [];
      docs.forEach(function (doc) {
        (doc.chunks || []).forEach(function (c) {
          var s = scoreChunk(c.text, ts);
          if (s > 0) {
            hits.push({
              docId: doc.id, title: doc.title, chunk: c.i,
              score: s, snippet: snippet(c.text, ts), source: 'local'
            });
          }
        });
      });
      return U.sortBy(hits, 'score', 'desc').slice(0, lim);
    }));

    return local.then(function (localHits) {
      return remote.search(q, lim).then(function (remoteHits) {
        var merged = localHits.concat((remoteHits || []).map(function (h) {
          return { docId: h.docId, title: h.title, snippet: h.snippet,
            source: 'remote', score: 1, page: h.page };
        }));
        return merged.slice(0, lim);
      });
    });
  }

  function list() {
    return CN.store.all('kb').then(function (docs) {
      return U.sortBy(docs, 'addedAt', 'desc').map(function (d) {
        return {
          id: d.id, title: d.title, ext: d.ext, byteSize: d.byteSize,
          addedAt: d.addedAt, chunks: (d.chunks || []).length,
          textChars: d.textChars || 0, source: d.source
        };
      });
    });
  }

  function remove(id) {
    return CN.store.del('kb', id).then(function () {
      CN.bus.emit('kb', { action: 'remove', id: id });
      return true;
    });
  }

  function stats() {
    return CN.store.all('kb').then(function (docs) {
      var chunks = 0, chars = 0;
      docs.forEach(function (d) {
        chunks += (d.chunks || []).length;
        chars += d.textChars || 0;
      });
      return { documents: docs.length, chunks: chunks, characters: chars };
    });
  }

  CN.kb = {
    parsers: PARSERS,
    registerParser: registerParser,
    supportedExtensions: supportedExtensions,
    deferredExtensions: deferredExtensions,
    isSupported: isSupported,
    extOf: extOf,
    chunkText: chunkText,
    ingest: ingest,
    search: search,
    list: list,
    remove: remove,
    stats: stats,
    remote: remote,
    MAX_TEXT_BYTES: MAX_TEXT_BYTES
  };
})();

/* ==========================================================================
   NutriClinic Pro — pdf.js
   Report construction and the print pipeline.

   PDF export is the browser's own print-to-PDF. No external rendering library
   is loaded — that would violate the strict CSP, and a bundled renderer would
   need a build step. The application therefore builds a print-ready A4
   document into #print-root and invokes window.print(); css/print.css carries
   the layout. This is stated plainly in the interface rather than presented
   as a bespoke PDF engine.
   ========================================================================== */
(function () {
  'use strict';
  var CN = window.CN = window.CN || {};
  var U = CN.util;

  var BRAND_MARK =
    '<svg class="rpt-logo" viewBox="0 0 64 64" aria-hidden="true">' +
    '<rect width="64" height="64" rx="14" fill="#14213D"/>' +
    '<path d="M14 42h10l6-16 6 22 5-14h9" fill="none" stroke="#C6A667" stroke-width="4" ' +
    'stroke-linecap="round" stroke-linejoin="round"/></svg>';

  function n(v, dp) { return U.nf(v, dp); }
  function esc(v) { return U.esc(v); }

  /** Household-portion string for a gram weight, where one is available. */
  function portionText(food, grams, lang) {
    if (!food) return '';
    var h = CN.foods.household(food, grams);
    if (!h) return '';
    return lang === 'ar' ? h.labelAr : h.labelEn;
  }

  /** Resolve a food or a clinic recipe by id, through the planner's index. */
  function foodFor(id) {
    return CN.planner.resolveFood ? CN.planner.resolveFood(id) : CN.foods.byId(id);
  }

  /* ------------------------------------------------------------- sections -- */
  function head(settings, mode, lang) {
    if (mode === 'plain') {
      return '<header class="rpt-head"><div class="brand">' +
        '<h1>' + esc(settings.reportHeading || (lang === 'ar' ? 'خطة غذائية' : 'Diet Plan')) + '</h1>' +
        '<div class="sub">' + esc(U.fmtDate(U.todayISO())) + '</div>' +
        '</div></header>';
    }
    var contact = [settings.clinicPhone, settings.clinicEmail, settings.clinicAddress]
      .filter(Boolean).map(esc).join(' · ');
    return '<header class="rpt-head"><div class="brand">' +
      '<h1>' + esc(settings.clinicName || 'NutriClinic Pro') + '</h1>' +
      '<div class="sub">' +
        esc([settings.physicianName, settings.physicianTitle].filter(Boolean).join(' · ')) +
        (contact ? '<br>' + contact : '') +
      '</div></div>' + BRAND_MARK + '</header>';
  }

  function metaBlock(patient, lang) {
    var age = U.ageFrom(patient.dob);
    var sexLabel = patient.sex ? CN.t('sex.' + patient.sex) : '—';
    function cell(k, v) {
      return '<div><div class="k">' + esc(k) + '</div><div class="v">' + esc(v) + '</div></div>';
    }
    return '<div class="rpt-meta">' +
      cell(lang === 'ar' ? 'المريض' : 'Patient', patient.name || '—') +
      cell(lang === 'ar' ? 'رقم المريض' : 'Patient ID', patient.code || '—') +
      cell(lang === 'ar' ? 'العمر' : 'Age', age === null ? '—' : age + ' ' + (lang === 'ar' ? 'سنة' : 'years')) +
      cell(lang === 'ar' ? 'النوع' : 'Sex', sexLabel) +
      cell(lang === 'ar' ? 'تاريخ التقرير' : 'Report date', U.fmtDate(U.todayISO())) +
      cell(lang === 'ar' ? 'الهاتف' : 'Phone', patient.phone || '—') +
      cell(lang === 'ar' ? 'الهدف' : 'Goal', patient.goal ? CN.t('goal.' + patient.goal) : '—') +
      cell(lang === 'ar' ? 'الطبيب' : 'Clinician', (CN.pdfSettings && CN.pdfSettings.physicianName) || '—') +
      '</div>';
  }

  function measurementsTable(measurements, lang) {
    var pts = (measurements || []).slice().sort(function (a, b) {
      return String(a.measuredAt).localeCompare(String(b.measuredAt));
    });
    if (!pts.length) return '';
    var first = pts[0], last = pts[pts.length - 1];
    var h = last.heightCm || first.heightCm;
    var rows = [
      [lang === 'ar' ? 'الوزن' : 'Weight', first.weightKg, last.weightKg, 'kg'],
      [lang === 'ar' ? 'الطول' : 'Height', h, h, 'cm'],
      [lang === 'ar' ? 'كتلة الجسم' : 'BMI', CN.engine.bmi(h, first.weightKg), CN.engine.bmi(h, last.weightKg), ''],
      [lang === 'ar' ? 'محيط الخصر' : 'Waist', first.waistCm, last.waistCm, 'cm'],
      [lang === 'ar' ? 'نسبة الدهون' : 'Body fat', first.bodyFatPct, last.bodyFatPct, '%'],
      // Blood pressure is recorded alongside the measurements taken at the visit.
      [lang === 'ar' ? 'ضغط الدم' : 'Blood pressure',
        (first.systolic && first.diastolic) ? first.systolic + '/' + first.diastolic : null,
        (last.systolic && last.diastolic) ? last.systolic + '/' + last.diastolic : null, 'mmHg']
    ].filter(function (r) {
      return (r[1] !== undefined && r[1] !== null) || (r[2] !== undefined && r[2] !== null);
    });

    function fmtCell(v) {
      if (v === null || v === undefined) return '—';
      return typeof v === 'number' ? n(v, 1) : String(v);
    }

    return '<h2>' + esc(lang === 'ar' ? 'القياسات' : 'Measurements') + '</h2>' +
      '<table><thead><tr><th>' + esc(lang === 'ar' ? 'المقياس' : 'Measure') + '</th>' +
      '<th class="num">' + esc(U.fmtDate(first.measuredAt)) + '</th>' +
      '<th class="num">' + esc(U.fmtDate(last.measuredAt)) + '</th>' +
      '<th class="num">' + esc(lang === 'ar' ? 'التغير' : 'Change') + '</th></tr></thead><tbody>' +
      rows.map(function (r) {
        var a = r[1], b = r[2];
        var d = (typeof a === 'number' && typeof b === 'number') ? U.round(b - a, 1) : null;
        return '<tr><td>' + esc(r[0]) + '</td><td class="num">' + fmtCell(a) +
          (a === null || a === undefined ? '' : ' ' + r[3]) +
          '</td><td class="num">' + fmtCell(b) +
          (b === null || b === undefined ? '' : ' ' + r[3]) +
          '</td><td class="num">' + (d === null ? '—' : (d > 0 ? '+' : '') + n(d, 1)) + '</td></tr>';
      }).join('') + '</tbody></table>';
  }

  function energyTable(assessment, macros, lang) {
    if (!assessment) return '';
    var rows = [
      [lang === 'ar' ? 'معدل الأيض الأساسي' : 'Basal metabolic rate', n(assessment.bmr, 0) + ' kcal',
        assessment.bmrFormulaLabel || ''],
      [lang === 'ar' ? 'إجمالي الاستهلاك' : 'Total daily expenditure', n(assessment.tdee, 0) + ' kcal',
        (lang === 'ar' ? 'معامل النشاط ' : 'factor ') + n(assessment.activityFactor, 2)],
      [lang === 'ar' ? 'العجز/الفائض' : 'Deficit / surplus',
        (assessment.deltaKcal > 0 ? '+' : '') + n(assessment.deltaKcal, 0) + ' kcal', ''],
      [lang === 'ar' ? 'هدف السعرات' : 'Daily energy target', n(assessment.targetKcal, 0) + ' kcal',
        assessment.approvedAt ? (lang === 'ar' ? 'معتمد' : 'approved') : (lang === 'ar' ? 'غير معتمد' : 'not approved')]
    ];
    var out = '<h2>' + esc(lang === 'ar' ? 'أهداف الطاقة' : 'Energy targets') + '</h2>' +
      '<table><thead><tr><th>' + esc(lang === 'ar' ? 'البند' : 'Item') + '</th><th class="num">' +
      esc(lang === 'ar' ? 'القيمة' : 'Value') + '</th><th>' + esc(lang === 'ar' ? 'ملاحظة' : 'Note') +
      '</th></tr></thead><tbody>' +
      rows.map(function (r) {
        return '<tr><td>' + esc(r[0]) + '</td><td class="num">' + esc(r[1]) + '</td><td>' + esc(r[2]) + '</td></tr>';
      }).join('') + '</tbody></table>';

    if (macros) {
      out += '<h3>' + esc(lang === 'ar' ? 'العناصر الكبرى' : 'Macronutrients') + '</h3>' +
        '<table><thead><tr><th>' + esc(lang === 'ar' ? 'العنصر' : 'Nutrient') + '</th>' +
        '<th class="num">' + esc(lang === 'ar' ? 'الجرامات' : 'Grams') + '</th>' +
        '<th class="num">' + esc(lang === 'ar' ? 'النسبة' : 'Share') + '</th></tr></thead><tbody>' +
        '<tr><td>' + esc(lang === 'ar' ? 'بروتين' : 'Protein') + '</td><td class="num">' + n(macros.proteinG, 0) +
          ' g</td><td class="num">' + n(macros.proteinPct, 0) + '%</td></tr>' +
        '<tr><td>' + esc(lang === 'ar' ? 'كربوهيدرات' : 'Carbohydrate') + '</td><td class="num">' + n(macros.carbG, 0) +
          ' g</td><td class="num">' + n(macros.carbPct, 0) + '%</td></tr>' +
        '<tr><td>' + esc(lang === 'ar' ? 'دهون' : 'Fat') + '</td><td class="num">' + n(macros.fatG, 0) +
          ' g</td><td class="num">' + n(macros.fatPct, 0) + '%</td></tr>' +
        '<tr><td>' + esc(lang === 'ar' ? 'ألياف' : 'Fibre') + '</td><td class="num">' + n(macros.fiberG, 0) +
          ' g</td><td class="num">—</td></tr>' +
        (macros.sodiumMaxMg ? '<tr><td>' + esc(lang === 'ar' ? 'الحد الأقصى للصوديوم' : 'Sodium ceiling') +
          '</td><td class="num">' + n(macros.sodiumMaxMg, 0) + ' mg</td><td class="num">—</td></tr>' : '') +
        '</tbody></table>';
    }
    return out;
  }

  function planTable(version, lang, showNutrients) {
    if (!version || !version.days) return '';
    var out = '<h2>' + esc(lang === 'ar' ? 'الخطة الغذائية' : 'Diet plan') + '</h2>';

    if (version.approachCodes && version.approachCodes.length) {
      out += '<p><strong>' + esc(lang === 'ar' ? 'الأنظمة' : 'Approaches') + ':</strong> ' +
        esc(version.approachCodes.map(function (c) {
          var a = CN.approaches.byCode(c);
          return a ? (lang === 'ar' ? a.nameAr : a.nameEn) : c;
        }).join(' · ')) + '</p>';
    }

    version.days.forEach(function (day) {
      out += '<h3>' + esc((lang === 'ar' ? 'اليوم ' : 'Day ') + (day.dayIndex + 1)) +
        (day.date ? ' — ' + esc(U.fmtDate(day.date)) : '') +
        (showNutrients ? ' · ' + n(day.totals.kcal, 0) + ' kcal' : '') + '</h3>';

      day.meals.forEach(function (meal) {
        out += '<div class="meal"><h3>' + esc(lang === 'ar' ? (meal.labelAr || meal.labelEn) : meal.labelEn);
        if (meal.time) out += ' <span style="font-weight:400;color:#6B7280">' + esc(meal.time) + '</span>';
        out += '</h3>';

        if (showNutrients) {
          out += '<table><thead><tr><th>' + esc(lang === 'ar' ? 'الصنف' : 'Food') + '</th>' +
            '<th class="num">' + esc(lang === 'ar' ? 'الكمية' : 'Amount') + '</th>' +
            '<th class="num">' + esc(lang === 'ar' ? 'ك.ح' : 'kcal') + '</th>' +
            '<th class="num">' + esc(lang === 'ar' ? 'بروتين' : 'P') + '</th>' +
            '<th class="num">' + esc(lang === 'ar' ? 'كارب' : 'C') + '</th>' +
            '<th class="num">' + esc(lang === 'ar' ? 'دهون' : 'F') + '</th></tr></thead><tbody>';
        } else {
          out += '<table><tbody>';
        }

        meal.items.forEach(function (it) {
          var food = CN.planner.resolveFood(it.foodId);
          var name = CN.planner.itemName(it, lang);
          var portion = portionText(food, it.grams, lang);
          var amount = it.grams + ' g' + (portion ? ' (' + portion + ')' : '');
          var recipeMark = it.isRecipe
            ? ' <em style="color:#14213D">(' + esc(CN.t('rc.title')) + ')</em>' : '';
          if (showNutrients) {
            out += '<tr><td>' + esc(name) + recipeMark +
              (it.needsVerify ? ' <em style="color:#800020">(' + esc(lang === 'ar' ? 'يتطلب تحققًا' : 'verify') + ')</em>' : '') +
              '</td><td class="num">' + esc(amount) + '</td>' +
              '<td class="num">' + n(it.kcal, 0) + '</td><td class="num">' + n(it.protein, 1) + '</td>' +
              '<td class="num">' + n(it.carb, 1) + '</td><td class="num">' + n(it.fat, 1) + '</td></tr>';
          } else {
            out += '<tr><td>' + esc(name) + '</td><td class="num">' + esc(amount) + '</td></tr>';
          }
        });
        out += '</tbody></table>';

        if (showNutrients) {
          out += '<div class="totals"><span>' + esc(lang === 'ar' ? 'إجمالي الوجبة' : 'Meal total') +
            ': <b>' + n(meal.totals.kcal, 0) + ' kcal</b></span>' +
            '<span>P <b>' + n(meal.totals.protein, 1) + ' g</b></span>' +
            '<span>C <b>' + n(meal.totals.carb, 1) + ' g</b></span>' +
            '<span>F <b>' + n(meal.totals.fat, 1) + ' g</b></span></div>';
        }
        if (meal.instructions) {
          out += '<p style="font-size:9pt;color:#6B7280;margin:4pt 0 0">' + esc(meal.instructions) + '</p>';
        }
        out += '</div>';
      });
    });

    return out;
  }

  function notices(assessment, version, lang) {
    var out = '';
    var flags = (assessment && assessment.flags) || [];
    if (flags.length) {
      out += '<h2>' + esc(lang === 'ar' ? 'اعتبارات إكلينيكية' : 'Clinical considerations') + '</h2>';
      flags.forEach(function (f) {
        out += '<div class="notice">' + esc(lang === 'ar' ? (f.ar || f.en) : f.en) + '</div>';
      });
    }
    if (version && version.warnings && version.warnings.length) {
      out += '<h2>' + esc(lang === 'ar' ? 'ملاحظات على الخطة' : 'Plan notes') + '</h2>';
      version.warnings.forEach(function (w) { out += '<div class="notice">' + esc(w) + '</div>'; });
    }
    return out;
  }

  /* --------------------------------------------------------------- build --- */
  /**
   * buildReport({ patient, measurements, assessment, macros, plan, settings, mode })
   * `mode` is 'branded' or 'plain'. Returns an HTML string for #print-root.
   */
  function buildReport(ctx) {
    ctx = ctx || {};
    var lang = (CN.i18n && CN.i18n.lang === 'ar') ? 'ar' : 'en';
    var settings = ctx.settings || {};
    var mode = ctx.mode || settings.reportMode || 'branded';
    var showNutrients = ctx.showNutrients === undefined ? settings.reportShowNutrients !== false : !!ctx.showNutrients;
    var showSignature = ctx.showSignature === undefined ? settings.reportShowSignature !== false : !!ctx.showSignature;
    var patient = ctx.patient || {};

    // Editable template tokens: accent colour and a type scale. A single inline
    // font-size rescales the whole report because css/print.css is em-based.
    var accent = ctx.accent || settings.reportAccent || '#14213D';
    var scale = Number(ctx.fontScale || settings.reportFontScale) || 1;
    var articleStyle = ' style="--rpt-accent:' + accent + ';font-size:' +
      U.round(10.5 * scale, 1) + 'pt"';

    CN.pdfSettings = settings;

    var body = '';
    body += '<h2>' + esc(lang === 'ar' ? 'ملخص المريض' : 'Patient summary') + '</h2>' +
      '<table><tbody>' +
      '<tr><td>' + esc(lang === 'ar' ? 'الاسم' : 'Name') + '</td><td>' + esc(patient.name || '—') + '</td></tr>' +
      '<tr><td>' + esc(lang === 'ar' ? 'رقم المريض' : 'Patient ID') + '</td><td>' + esc(patient.code || '—') + '</td></tr>' +
      (patient.conditions && patient.conditions.length
        ? '<tr><td>' + esc(lang === 'ar' ? 'الأمراض' : 'Conditions') + '</td><td>' + esc(patient.conditions.join(' · ')) + '</td></tr>' : '') +
      (patient.restrictions && patient.restrictions.length
        ? '<tr><td>' + esc(lang === 'ar' ? 'القيود الغذائية' : 'Dietary restrictions') + '</td><td>' +
          esc(patient.restrictions.map(function (r) {
            return CN.foods.allergenLabel(r.substance, lang) + ' (' + CN.t('rest.' + r.kind) + ')';
          }).join(' · ')) + '</td></tr>' : '') +
      (patient.medications ? '<tr><td>' + esc(lang === 'ar' ? 'الأدوية' : 'Medications') + '</td><td>' +
        esc(patient.medications) + '</td></tr>' : '') +
      '</tbody></table>';

    body += measurementsTable(ctx.measurements, lang);
    body += energyTable(ctx.assessment, ctx.macros, lang);
    body += planTable(ctx.plan, lang, showNutrients);
    body += notices(ctx.assessment, ctx.plan, lang);

    var sig = '';
    if (showSignature) {
      sig = '<div class="sig">' +
        '<div class="line">' + esc(settings.physicianName || (lang === 'ar' ? 'الطبيب المعالج' : 'Treating clinician')) + '</div>' +
        '<div class="line">' + esc(lang === 'ar' ? 'التاريخ' : 'Date') + '</div>' +
        '</div>';
    }

    return '<article class="rpt' + (mode === 'plain' ? ' plain' : '') + '"' + articleStyle + '>' +
      head(settings, mode, lang) +
      metaBlock(patient, lang) +
      body +
      '<div class="notice">' + esc(CN.t('rp.disclaimer')) + '</div>' +
      sig +
      '<footer class="rpt-foot"><span>' +
        esc(mode === 'plain' ? '' : (settings.clinicName || 'NutriClinic Pro')) +
      '</span><span>' + esc(U.fmtDate(U.todayISO())) + '</span></footer>' +
      '</article>';
  }

  /* ---------------------------------------------------------------- print -- */
  function printHtml(html) {
    var root = document.getElementById('print-root');
    if (!root) return;
    root.innerHTML = html;
    root.removeAttribute('aria-hidden');

    var cleanup = function () {
      root.innerHTML = '';
      root.setAttribute('aria-hidden', 'true');
      window.removeEventListener('afterprint', cleanup);
    };
    window.addEventListener('afterprint', cleanup);
    // Some browsers never fire afterprint; do not leave stale content forever.
    setTimeout(function () {
      window.print();
      setTimeout(cleanup, 1500);
    }, 60);
  }

  /** Render a report from a context object. */
  function print(ctx) {
    printHtml(buildReport(ctx));
  }

  /** Modal preview with a print action. */
  function preview(ctx) {
    var html = buildReport(ctx);
    CN.modal({
      title: CN.t('rp.previewBtn'),
      wide: true,
      body: '<div style="background:#F4F5F7;padding:1rem;border-radius:8px;max-height:66vh;overflow:auto">' +
        '<div style="background:#fff;padding:14mm;box-shadow:0 1px 4px rgba(20,33,61,.14);' +
        'max-width:210mm;margin:0 auto">' + html + '</div></div>' +
        '<p class="muted" style="margin-top:.6rem;font-size:.82rem">' + esc(CN.t('rp.previewHint')) + '</p>',
      actions: [
        { label: CN.t('common.close'), kind: 'ghost' },
        { label: CN.t('rp.printBtn'), kind: 'primary', onClick() { printHtml(html); } }
      ]
    });
  }

  CN.pdf = {
    buildReport: buildReport,
    print: print,
    preview: preview,
    printHtml: printHtml,
    portionText: portionText
  };
})();

/* ==========================================================================
   NutriClinic Pro — planner.js
   Diet plan generation, editing operations, smart exchange, version diffing
   and templates.

   Generation is DETERMINISTIC: the same patient, targets, approaches and
   duration always produce the same plan. Food choice rotates by day index so
   a seven-day plan has variety without randomness — which also makes the
   output reproducible and testable.

   Hard rule (brief §8): a food excluded by a patient restriction is never
   placed in a plan. Soft restrictions are avoided where alternatives exist.
   ========================================================================== */
(function () {
  'use strict';
  var CN = window.CN = window.CN || {};
  var U = CN.util;

  var MEAL_TIMES = ['08:00', '11:00', '14:00', '17:00', '20:00'];
  var IF_WINDOW = { start: '12:00', end: '20:00' };

  /* -------------------------------------------------------- restrictions --- */
  /**
   * Build predicate functions from a patient's restriction list.
   * Returns { hard: [fn], soft: [fn] }
   *   hard — allergy, medical, religious: must never appear
   *   soft — intolerance, preference: avoided where an alternative exists
   */
  function buildRestrictions(restrictions) {
    var keys = CN.foods.allergens.map(function (a) { return a[0]; });
    var hard = [], soft = [];

    (restrictions || []).forEach(function (r) {
      if (!r || !r.substance) return;
      var s = String(r.substance).trim().toLowerCase();
      var fn;

      if (keys.indexOf(s) !== -1) {
        fn = function (f) { return (f.allergens || []).indexOf(s) !== -1; };
      } else if (/red meat|لحم أحمر/.test(s)) {
        fn = function (f) { return f.category === 'meat'; };
      } else if (/dairy|milk|ألبان|حليب/.test(s)) {
        fn = function (f) { return (f.allergens || []).indexOf('milk') !== -1 || (f.allergens || []).indexOf('lactose') !== -1; };
      } else if (/seafood|fish|أسماك|سمك/.test(s)) {
        fn = function (f) { return f.category === 'fish'; };
      } else if (/meat|لحوم/.test(s)) {
        fn = function (f) { return f.category === 'meat' || f.category === 'poultry'; };
      } else if (/egg|بيض/.test(s)) {
        fn = function (f) { return (f.allergens || []).indexOf('egg') !== -1; };
      } else if (/sugar|سكر/.test(s)) {
        fn = function (f) { return f.category === 'sweets'; };
      } else if (/fried|مقلي/.test(s)) {
        fn = function (f) { return /fried/.test(f.id); };
      } else {
        fn = function (f) {
          return f.nameEn.toLowerCase().indexOf(s) !== -1 || String(f.nameAr || '').indexOf(r.substance) !== -1;
        };
      }

      var kind = String(r.kind || '').toLowerCase();
      if (kind === 'allergy' || kind === 'medical' || kind === 'religious') hard.push(fn);
      else soft.push(fn);
    });

    return { hard: hard, soft: soft };
  }

  function violates(food, preds) {
    return (preds || []).some(function (fn) { return fn(food); });
  }

  /* ------------------------------------------------- approach constraints --- */
  /**
   * Approach-specific food admissibility and slot weighting.
   * Returns { allow(food), dropCategories:[], fatScale:number }
   */
  function approachRules(codes) {
    var set = codes || [];
    var dropCats = [];
    var fatScale = 1;

    if (set.indexOf('ketogenic') !== -1) {
      // Ketogenic: starches, most fruit and sweets are excluded.
      dropCats = dropCats.concat(['grains', 'bread', 'sweets', 'beverages']);
      fatScale = 1.25;
    }
    if (set.indexOf('vegan') !== -1) {
      dropCats = dropCats.concat(['meat', 'poultry', 'fish', 'eggs', 'dairy']);
    }
    if (set.indexOf('vegetarian') !== -1 && set.indexOf('vegan') === -1) {
      dropCats = dropCats.concat(['meat', 'poultry', 'fish']);
    }
    if (set.indexOf('dairy_free') !== -1 || set.indexOf('lactose_free') !== -1) {
      dropCats = dropCats.concat(['dairy']);
    }
    if (set.indexOf('low_fat') !== -1) fatScale = 0.6;
    if (set.indexOf('low_sodium') !== -1 || set.indexOf('dash') !== -1) fatScale *= 0.95;
    if (set.indexOf('gluten_free') !== -1) {
      // handled through allergen predicates below
    }

    var requiresExclusions = CN.approaches.requiredExclusions(set);

    return {
      dropCategories: dropCats,
      requiresExclusions: requiresExclusions,
      fatScale: fatScale,
      allow(food) {
        if (dropCats.indexOf(food.category) !== -1) return false;
        // Gluten-free must exclude gluten-bearing foods outright.
        if (set.indexOf('gluten_free') !== -1 && (food.allergens || []).indexOf('gluten') !== -1) return false;
        if (set.indexOf('vegan') !== -1) {
          if ((food.allergens || []).indexOf('milk') !== -1) return false;
          if ((food.allergens || []).indexOf('egg') !== -1) return false;
        }
        if (set.indexOf('low_sodium') !== -1 && food.sodium > 600 && food.category !== 'vegetables') return false;
        if (set.indexOf('dash') !== -1 && food.sodium > 700) return false;
        return true;
      }
    };
  }

  /* ------------------------------------------------------- food selection --- */
  /** Practical portion rounding: 5 g steps for solids, 10 ml for liquids. */
  function roundPortion(grams, food) {
    var g = Math.max(0, Number(grams) || 0);
    if (!food) return U.round(g, 0);
    if (['beverages', 'dairy'].indexOf(food.category) !== -1) {
      return Math.max(50, Math.round(g / 10) * 10);
    }
    if (g < 15) return Math.max(5, Math.round(g / 5) * 5);
    return Math.max(5, Math.round(g / 5) * 5);
  }

  /** Candidates for a slot: admissible, not hard-excluded, preferences avoided. */
  function slotCandidates(cats, ctx) {
    var base = CN.foods.items.filter(function (f) {
      if (cats.indexOf(f.category) === -1) return false;
      if (!ctx.rules.allow(f)) return false;
      if (ctx.approachExclusions.length &&
        CN.foods.conflicts(f, ctx.approachExclusions).length) return false;
      if (violates(f, ctx.restr.hard)) return false;
      return true;
    });
    if (!base.length) return [];
    var preferred = base.filter(function (f) { return !violates(f, ctx.restr.soft); });
    return preferred.length ? preferred : base;
  }

  function makeItem(food, grams, note) {
    var n = CN.foods.nutrientsFor(food, grams);
    return {
      id: U.uid('itm'),
      foodId: food.id,
      // Snapshot of the display name. A stored plan must stay readable even if
      // the underlying food is later renamed or removed from the database.
      label: food.nameEn || '',
      labelAr: food.nameAr || '',
      grams: grams,
      kcal: n.kcal,
      protein: n.protein,
      carb: n.carb,
      fat: n.fat,
      fiber: n.fiber,
      sodium: n.sodium,
      approximate: !!note,
      note: note || '',
      needsVerify: !!food.needsVerify,
      // Recipes travel with the plan so the item remains explainable later.
      recipeId: food.isRecipe ? food.recipeId : null,
      isRecipe: !!food.isRecipe
    };
  }

  function sumItems(items) {
    return {
      kcal: U.round(U.sum(items.map(function (i) { return i.kcal; })), 0),
      protein: U.round(U.sum(items.map(function (i) { return i.protein; })), 1),
      carb: U.round(U.sum(items.map(function (i) { return i.carb; })), 1),
      fat: U.round(U.sum(items.map(function (i) { return i.fat; })), 1),
      fiber: U.round(U.sum(items.map(function (i) { return i.fiber; })), 1),
      sodium: U.round(U.sum(items.map(function (i) { return i.sodium; })), 0)
    };
  }

  /* ------------------------------------------------------------- generate --- */
  /**
   * generate({ patient, targetKcal, macros, approachCodes, durationDays,
   *            startDate, patternKey, assessments })
   * Returns a plan version object (status 'draft').
   */
  function generate(input) {
    input = input || {};
    var target = Number(input.targetKcal);
    if (!(target > 0)) return { ok: false, reason: 'no_target' };

    var codes = input.approachCodes || [];
    var pattern = CN.approaches.patterns[input.patternKey] ||
      CN.approaches.patterns[(CN.approaches.byCode(codes[0]) || {}).pattern || '3_meals_1_snack'];
    var duration = U.clamp(Number(input.durationDays) || 7, 1, 28);

    var ctx = {
      rules: approachRules(codes),
      approachExclusions: CN.approaches.requiredExclusions(codes),
      restr: buildRestrictions(input.patient ? input.patient.restrictions : []),
      targetKcal: target,
      macros: input.macros || null,
      fatScale: 1
    };
    ctx.fatScale = ctx.rules.fatScale;

    var labels = CN.approaches.mealLabelsFor(pattern);
    var startDate = input.startDate || U.todayISO();
    var days = [];
    var warnings = [];
    var excludedCount = 0;
    var verifyCount = 0;

    // Count what the restrictions removed, for the plan's provenance note.
    CN.foods.items.forEach(function (f) {
      if (violates(f, ctx.restr.hard)) excludedCount++;
    });

    for (var d = 0; d < duration; d++) {
      var meals = [];
      for (var mi = 0; mi < pattern.shares.length; mi++) {
        var share = pattern.shares[mi];
        var mealKcal = target * share;
        var occasion = CN.approaches.occasionFor(pattern, mi);
        var recipe = CN.approaches.occasionRecipes[occasion] || CN.approaches.occasionRecipes.lunch;
        var items = [];

        recipe.forEach(function (slot, si) {
          var cats = slot.cats;
          var pool = slotCandidates(cats, ctx);
          if (!pool.length) {
            // Fall back to a broader pool rather than leaving the slot empty.
            pool = slotCandidates(['vegetables', 'legumes', 'grains'], ctx);
          }
          if (!pool.length) return;

          // Deterministic rotation: varies by day, occasion and slot.
          var idx = (d * 31 + mi * 7 + si * 3) % pool.length;
          var food = pool[idx];

          var slotKcal = mealKcal * slot.share;
          if (slot.slot === 'fat') slotKcal *= ctx.fatScale;
          if (slot.slot === 'starch' && codes.indexOf('ketogenic') !== -1) slotKcal *= 0.4;

          var grams = roundPortion(slotKcal / (food.kcal / 100 || 1), food);
          // Do not propose implausible portions.
          if (grams < 5) return;
          if (food.category === 'fats' && grams > 40) grams = 40;
          if (food.category === 'nuts' && grams > 60) grams = 60;

          var item = makeItem(food, grams);
          if (food.needsVerify) {
            item.note = 'Composite dish — ingredient list incomplete.';
            verifyCount++;
          }
          items.push(item);
        });

        var totals = sumItems(items);
        meals.push({
          id: U.uid('mel'),
          labelEn: labels[mi] ? labels[mi].en : ('Meal ' + (mi + 1)),
          labelAr: labels[mi] ? labels[mi].ar : ('وجبة ' + (mi + 1)),
          time: (pattern.key === '2_meals_if' || pattern.key === '3_meals_if')
            ? null
            : MEAL_TIMES[mi] || null,
          instructions: '',
          items: items,
          totals: totals
        });
      }

      // Fasting-window guidance and hydration belong on the plan, not in code.
      if (pattern.key === '2_meals_if' || pattern.key === '3_meals_if') {
        meals[0].instructions = 'Eating window ' + IF_WINDOW.start + '–' + IF_WINDOW.end +
          '. Water, and unsweetened tea or coffee, are permitted outside the window.';
      }

      days.push({
        dayIndex: d,
        date: addDays(startDate, d),
        meals: meals,
        totals: sumItems(meals.reduce(function (acc, m) { return acc.concat(m.items); }, []))
      });
    }

    if (excludedCount) {
      warnings.push(excludedCount + ' food(s) were excluded by the patient\u2019s restrictions.');
    }
    if (verifyCount) {
      warnings.push(verifyCount + ' composite item(s) carry an incomplete ingredient list and are flagged for verification.');
    }
    if (ctx.approachExclusions.length) {
      warnings.push('The selected approaches themselves require excluding: ' +
        ctx.approachExclusions.map(function (a) { return CN.foods.allergenLabel(a); }).join(', ') + '.');
    }

    return {
      ok: true,
      id: U.uid('ver'),
      versionNo: 1,
      status: 'draft',
      createdAt: new Date().toISOString(),
      approachCodes: codes,
      patternKey: pattern.key,
      durationDays: duration,
      startDate: startDate,
      targetKcal: target,
      macros: input.macros || null,
      assessmentId: input.assessmentId || null,
      generatedBy: input.generatedBy || 'engine',
      days: days,
      warnings: warnings,
      excludedCount: excludedCount,
      parentVersionId: null
    };
  }

  function addDays(iso, n) {
    var d = U.parseDate(iso) || new Date();
    d.setDate(d.getDate() + n);
    return d.toISOString().slice(0, 10);
  }

  /* ------------------------------------------------------------- recalc ----- */
  /** Recompute an item's nutrients from its gram weight. */
  function recalcItem(item) {
    var food = resolveFood(item.foodId);
    // Unresolvable source (a recipe not yet loaded, for instance): keep the
    // stored values rather than zeroing a clinical record.
    if (!food) return item;
    var n = CN.foods.nutrientsFor(food, item.grams);
    item.kcal = n.kcal; item.protein = n.protein; item.carb = n.carb;
    item.fat = n.fat; item.fiber = n.fiber; item.sodium = n.sodium;
    return item;
  }

  /** Recompute every meal and day total in place. Returns the version. */
  function recalc(version) {
    (version.days || []).forEach(function (day) {
      (day.meals || []).forEach(function (meal) {
        meal.items.forEach(function (it) { recalcItem(it); });
        meal.totals = sumItems(meal.items);
      });
      day.totals = sumItems((day.meals || []).reduce(function (a, m) { return a.concat(m.items); }, []));
    });
    return version;
  }

  /** Where a day or the average day sits against the approved target. */
  function adherenceToTarget(version) {
    var m = version.macros || {};
    var days = version.days || [];
    if (!days.length) return null;
    var avg = {
      kcal: U.round(U.mean(days.map(function (d) { return d.totals.kcal; })), 0),
      protein: U.round(U.mean(days.map(function (d) { return d.totals.protein; })), 0),
      carb: U.round(U.mean(days.map(function (d) { return d.totals.carb; })), 0),
      fat: U.round(U.mean(days.map(function (d) { return d.totals.fat; })), 0),
      fiber: U.round(U.mean(days.map(function (d) { return d.totals.fiber; })), 0),
      sodium: U.round(U.mean(days.map(function (d) { return d.totals.sodium; })), 0)
    };
    var dev = {
      kcal: avg.kcal - version.targetKcal,
      protein: m.proteinG ? avg.protein - m.proteinG : null,
      carb: m.carbG ? avg.carb - m.carbG : null,
      fat: m.fatG ? avg.fat - m.fatG : null
    };
    function band(delta, target, tol) {
      if (delta === null || !target) return 'na';
      var f = Math.abs(delta) / target;
      if (f <= (tol || 0.05)) return 'on';
      return delta > 0 ? 'over' : 'under';
    }
    return {
      average: avg,
      deviation: dev,
      kcalStatus: band(dev.kcal, version.targetKcal, 0.05),
      proteinStatus: band(dev.protein, m.proteinG, 0.10),
      carbStatus: band(dev.carb, m.carbG, 0.10),
      fatStatus: band(dev.fat, m.fatG, 0.10),
      sodiumOver: (m.sodiumMaxMg && avg.sodium > m.sodiumMaxMg) ? avg.sodium - m.sodiumMaxMg : 0
    };
  }

  /* ---------------------------------------------------------- smart swap ---- */
  /**
   * suggestSwaps(item, { patient, approachCodes, objective, limit })
   * Ranked alternatives matched on the chosen objective. Approximate matches
   * are labelled as such (brief §10) rather than presented as equivalent.
   */
  function suggestSwaps(item, opts) {
    opts = opts || {};
    var food = resolveFood(item.foodId);
    if (!food) return [];

    var ctx = {
      rules: approachRules(opts.approachCodes || []),
      approachExclusions: CN.approaches.requiredExclusions(opts.approachCodes || []),
      restr: buildRestrictions(opts.patient ? opts.patient.restrictions : [])
    };

    var objective = opts.objective || 'kcal';
    var baseGrams = Number(item.grams) || 100;

    // Compare at the exchange-portion level so portions stay realistic.
    var refGrams = 100;

    // Recipes compete on exactly the same terms as foods, so a clinician can
    // swap a composite dish in or out of a meal.
    var candidates = CN.foods.items.slice();
    recipes().forEach(function (r) {
      var rf = recipeAsFood(r);
      if (rf) candidates.push(rf);
    });

    var pool = candidates.filter(function (f) {
      if (f.id === food.id) return false;
      if (!ctx.rules.allow(f)) return false;
      if (ctx.approachExclusions.length && CN.foods.conflicts(f, ctx.approachExclusions).length) return false;
      if (violates(f, ctx.restr.hard)) return false;
      return true;
    });

    var scored = pool.map(function (f) {
      // Grams of `f` that match the objective quantity of the original.
      var grams;
      var orig = CN.foods.nutrientsFor(food, baseGrams);
      var value;
      if (objective === 'kcal') {
        grams = roundPortion(orig.kcal / (f.kcal / 100 || 1), f);
        value = CN.foods.nutrientsFor(f, grams).kcal;
        value = Math.abs(value - orig.kcal);
      } else {
        var per100 = objective === 'protein' ? f.protein : (objective === 'carb' ? f.carb : f.fat);
        var origPer = objective === 'protein' ? orig.protein : (objective === 'carb' ? orig.carb : orig.fat);
        grams = roundPortion(origPer / (per100 / 100 || 1), f);
        var got = CN.foods.nutrientsFor(f, grams);
        value = Math.abs((objective === 'protein' ? got.protein : (objective === 'carb' ? got.carb : got.fat)) - origPer);
      }
      if (grams < 5 || grams > 600) return null;

      var got2 = CN.foods.nutrientsFor(f, grams);
      // Distance across all four macro dimensions, normalised.
      var dKcal = Math.abs(got2.kcal - orig.kcal) / Math.max(1, orig.kcal);
      var dP = Math.abs(got2.protein - orig.protein) / Math.max(1, orig.protein);
      var dC = Math.abs(got2.carb - orig.carb) / Math.max(1, orig.carb);
      var dF = Math.abs(got2.fat - orig.fat) / Math.max(1, orig.fat);
      var distance = (dKcal * 1.2 + dP + dC + dF) / 4.2;
      var penalties = [];
      if (violates(f, ctx.restr.soft)) penalties.push('preference');
      if (f.needsVerify) penalties.push('verify');

      return {
        food: f,
        grams: grams,
        nutrients: got2,
        deltaKcal: U.round(got2.kcal - orig.kcal, 0),
        deltaProtein: U.round(got2.protein - orig.protein, 1),
        similarity: U.round(U.clamp(1 - distance, 0, 1), 3),
        approximate: distance > 0.22,
        penalty: penalties.join(', ')
      };
    }).filter(Boolean);

    // Soft-restricted and unverified options rank below clean matches.
    scored.sort(function (a, b) {
      if (!!a.penalty !== !!b.penalty) return a.penalty ? 1 : -1;
      return b.similarity - a.similarity;
    });

    return scored.slice(0, opts.limit || 8);
  }

  /** Apply a swap in place and recalculate the affected meal and day. */
  function applySwap(version, dayIndex, mealIndex, itemId, newFoodId, grams, markApproximate) {
    var day = version.days[dayIndex];
    if (!day) return { ok: false, reason: 'no_day' };
    var meal = day.meals[mealIndex];
    if (!meal) return { ok: false, reason: 'no_meal' };
    var item = meal.items.filter(function (i) { return i.id === itemId; })[0];
    if (!item) return { ok: false, reason: 'no_item' };

    var newFood = resolveFood(newFoodId);
    if (!newFood) return { ok: false, reason: 'no_food' };

    var old = resolveFood(item.foodId);
    var oldName = old ? old.nameEn : (item.label || item.foodId);

    item.foodId = newFoodId;
    // Refresh the snapshots so the stored plan stays readable and honest.
    item.label = newFood.nameEn || '';
    item.labelAr = newFood.nameAr || '';
    item.recipeId = newFood.isRecipe ? newFood.recipeId : null;
    item.isRecipe = !!newFood.isRecipe;
    item.needsVerify = !!newFood.needsVerify;
    item.grams = Number(grams) || item.grams;
    item.approximate = !!markApproximate;
    recalcItem(item);
    item.note = (item.note ? item.note + ' ' : '') + 'Replaced ' + oldName + '.';

    meal.totals = sumItems(meal.items);
    day.totals = sumItems(day.meals.reduce(function (a, m) { return a.concat(m.items); }, []));

    return { ok: true, item: item, meal: meal, day: day };
  }

  /* ----------------------------------------------------- edit operations ---- */
  function addMeal(version, dayIndex, labelEn, labelAr) {
    var day = version.days[dayIndex];
    if (!day) return null;
    var meal = {
      id: U.uid('mel'),
      labelEn: labelEn || ('Additional meal ' + (day.meals.length + 1)),
      labelAr: labelAr || 'وجبة إضافية',
      time: null, instructions: '', items: [], totals: sumItems([])
    };
    day.meals.push(meal);
    return meal;
  }

  function removeMeal(version, dayIndex, mealIndex) {
    var day = version.days[dayIndex];
    if (!day) return false;
    day.meals.splice(mealIndex, 1);
    day.totals = sumItems(day.meals.reduce(function (a, m) { return a.concat(m.items); }, []));
    return true;
  }

  function addItem(version, dayIndex, mealIndex, foodId, grams) {
    // resolveFood, not byId: a recipe must be addable as an item too.
    var food = resolveFood(foodId);
    if (!food) return null;
    var meal = version.days[dayIndex] && version.days[dayIndex].meals[mealIndex];
    if (!meal) return null;
    // A recipe defaults to one serving — which is how it is actually
    // prescribed — while a food defaults to a weighed 100 g.
    var defaultG = (food.isRecipe && food.servingG) ? food.servingG : 100;
    var item = makeItem(food, roundPortion(grams || defaultG, food));
    meal.items.push(item);
    recalc(version);
    return item;
  }

  function removeItem(version, dayIndex, mealIndex, itemId) {
    var meal = version.days[dayIndex] && version.days[dayIndex].meals[mealIndex];
    if (!meal) return false;
    meal.items = meal.items.filter(function (i) { return i.id !== itemId; });
    recalc(version);
    return true;
  }

  function setItemGrams(version, dayIndex, mealIndex, itemId, grams) {
    var meal = version.days[dayIndex] && version.days[dayIndex].meals[mealIndex];
    if (!meal) return false;
    var it = meal.items.filter(function (i) { return i.id === itemId; })[0];
    if (!it) return false;
    it.grams = Math.max(0, Number(grams) || 0);
    recalc(version);
    return true;
  }

  /** Does the version contain anything excluded by a hard restriction? */
  function restrictionViolations(version, patient) {
    var preds = buildRestrictions(patient ? patient.restrictions : []);
    var out = [];
    (version.days || []).forEach(function (day) {
      day.meals.forEach(function (meal) {
        meal.items.forEach(function (it) {
          // Resolve through the planner so recipe items are checked against their
          // INHERITED allergens, not treated as unknown and skipped.
          var f = resolveFood(it.foodId);
          if (f && violates(f, preds.hard)) {
            out.push({ day: day.dayIndex, meal: meal.labelEn, food: f.nameEn, itemId: it.id });
          }
        });
      });
    });
    return out;
  }

  /* ----------------------------------------------------------------- diff --- */
  /**
   * Structural comparison of two plan versions.
   * Returns { totals, added, removed, changed, unchangedCount, identical }
   */
  function diff(a, b) {
    if (!a || !b) return null;
    var added = [], removed = [], changed = [];
    var maxDays = Math.max(a.days.length, b.days.length);

    for (var d = 0; d < maxDays; d++) {
      var da = a.days[d], db = b.days[d];
      var maxMeals = Math.max(da ? da.meals.length : 0, db ? db.meals.length : 0);
      for (var m = 0; m < maxMeals; m++) {
        var ma = da && da.meals[m], mb = db && db.meals[m];
        var ia = (ma ? ma.items : []).slice();
        var ib = (mb ? mb.items : []).slice();

        var usedB = {};
        ia.forEach(function (x) {
          var matchIdx = -1;
          for (var k = 0; k < ib.length; k++) {
            if (usedB[k]) continue;
            if (ib[k].foodId === x.foodId) { matchIdx = k; break; }
          }
          if (matchIdx === -1) {
            removed.push({ day: d, meal: (ma ? ma.labelEn : ''), food: x.foodId, grams: x.grams });
          } else {
            usedB[matchIdx] = true;
            var y = ib[matchIdx];
            if (Math.abs(y.grams - x.grams) > 4) {
              changed.push({
                day: d, meal: (mb ? mb.labelEn : ma.labelEn), food: x.foodId,
                from: x.grams, to: y.grams, deltaKcal: U.round(y.kcal - x.kcal, 0)
              });
            }
          }
        });
        ib.forEach(function (y, k) {
          if (!usedB[k]) added.push({ day: d, meal: (mb ? mb.labelEn : ''), food: y.foodId, grams: y.grams });
        });
      }
    }

    var avgA = U.round(U.mean((a.days || []).map(function (x) { return x.totals.kcal; })), 0);
    var avgB = U.round(U.mean((b.days || []).map(function (x) { return x.totals.kcal; })), 0);

    return {
      added: added, removed: removed, changed: changed,
      totals: {
        avgKcalA: avgA, avgKcalB: avgB, deltaKcal: (avgB || 0) - (avgA || 0),
        targetA: a.targetKcal, targetB: b.targetKcal
      },
      identical: !added.length && !removed.length && !changed.length
    };
  }

  /* ------------------------------------------------------------ templates --- */
  /** Capture a portable skeleton from a version. */
  function toTemplate(version, name) {
    return {
      id: U.uid('tpl'),
      name: name || 'Template',
      approachCodes: (version.approachCodes || []).slice(),
      durationDays: version.durationDays,
      patternKey: version.patternKey,
      structure: (version.days || []).map(function (d) {
        return d.meals.map(function (m) {
          return { labelEn: m.labelEn, labelAr: m.labelAr, time: m.time, foodIds: m.items.map(function (i) { return i.foodId; }) };
        });
      }),
      createdAt: new Date().toISOString()
    };
  }

  /** Rebuild a plan from a template against new targets, honouring exclusions. */
  function fromTemplate(template, input) {
    input = input || {};
    var ctx = {
      rules: approachRules(template.approachCodes || []),
      approachExclusions: CN.approaches.requiredExclusions(template.approachCodes || []),
      restr: buildRestrictions(input.patient ? input.patient.restrictions : [])
    };
    var labels = CN.approaches.mealLabelsFor(CN.approaches.patterns[template.patternKey] ||
      CN.approaches.patterns['3_meals_1_snack']);
    var target = Number(input.targetKcal) || 1800;
    var duration = U.clamp(Number(input.durationDays) || template.durationDays || 7, 1, 28);
    var days = [], substitutions = 0;

    for (var d = 0; d < duration; d++) {
      var skeleton = template.structure[d % template.structure.length] || [];
      var meals = skeleton.map(function (ms, mi) {
        var items = ms.foodIds.map(function (fid) {
          var food = CN.foods.byId(fid);
          // Substitute anything now excluded rather than silently keeping it.
          if (!food || !ctx.rules.allow(food) || violates(food, ctx.restr.hard)) {
            var alt = slotCandidates([food ? food.category : 'vegetables'], ctx)[0];
            if (!alt) return null;
            substitutions++;
            food = alt;
          }
          return makeItem(food, 100);
        }).filter(Boolean);

        var mealShare = 1 / Math.max(1, skeleton.length);
        var mealKcal = target * mealShare;
        // Scale portions so the rebuilt day lands on the new target.
        var rawKcal = U.sum(items.map(function (i) { return i.kcal; })) || 1;
        var scale = mealKcal / rawKcal;
        items.forEach(function (i) {
          var f = CN.foods.byId(i.foodId);
          i.grams = roundPortion(i.grams * scale, f);
          recalcItem(i);
        });

        return {
          id: U.uid('mel'),
          labelEn: ms.labelEn || (labels[mi] ? labels[mi].en : 'Meal'),
          labelAr: ms.labelAr || (labels[mi] ? labels[mi].ar : 'وجبة'),
          time: ms.time || null, instructions: '',
          items: items, totals: sumItems(items)
        };
      });

      days.push({
        dayIndex: d,
        date: addDays(input.startDate || U.todayISO(), d),
        meals: meals,
        totals: sumItems(meals.reduce(function (a, m) { return a.concat(m.items); }, []))
      });
    }

    return {
      ok: true, id: U.uid('ver'), versionNo: 1, status: 'draft',
      createdAt: new Date().toISOString(),
      approachCodes: (template.approachCodes || []).slice(),
      patternKey: template.patternKey, durationDays: duration,
      startDate: input.startDate || U.todayISO(),
      targetKcal: target, macros: input.macros || null,
      assessmentId: input.assessmentId || null,
      templateId: template.id, generatedBy: 'template',
      days: days,
      warnings: substitutions ? [substitutions + ' item(s) were substituted to honour current exclusions.'] : [],
      excludedCount: substitutions, parentVersionId: null
    };
  }

  /* ------------------------------------------------------------- recipes --- */
  /**
   * Nutrition of a clinic recipe, computed from its ingredients.
   * `yieldG` is the weight of the finished dish (cooking changes mass), and
   * `servings` divides that into portions — both are required for the figure
   * to mean anything, so both are surfaced rather than assumed silently.
   */
  function recipeNutrition(recipe) {
    recipe = recipe || {};
    var items = recipe.items || [];
    var total = { kcal: 0, protein: 0, carb: 0, fat: 0, fiber: 0, sodium: 0 };
    var missing = [];
    var ingredientWeight = 0;

    items.forEach(function (it) {
      var f = CN.foods.byId(it.foodId);
      ingredientWeight += Number(it.grams) || 0;
      if (!f) { missing.push(it.foodId); return; }
      var n = CN.foods.nutrientsFor(f, it.grams);
      total.kcal += n.kcal; total.protein += n.protein; total.carb += n.carb;
      total.fat += n.fat; total.fiber += n.fiber; total.sodium += n.sodium;
    });

    var servings = Number(recipe.servings) || 1;
    var declaredYield = Number(recipe.yieldG) || 0;
    // Cooking changes mass. When the clinician has not weighed the finished
    // dish, fall back to the raw ingredient weight and SAY SO, rather than
    // inventing a shrinkage factor.
    var yieldAssumed = !(declaredYield > 0);
    var yieldG = yieldAssumed ? ingredientWeight : declaredYield;

    var perServing = {
      kcal: U.round(total.kcal / servings, 1),
      protein: U.round(total.protein / servings, 1),
      carb: U.round(total.carb / servings, 1),
      fat: U.round(total.fat / servings, 1),
      fiber: U.round(total.fiber / servings, 1),
      sodium: U.round(total.sodium / servings, 1)
    };
    var round = function (v) { return U.round(v, 1); };
    Object.keys(total).forEach(function (k) { total[k] = round(total[k]); });

    return {
      total: total,
      perServing: perServing,
      servings: servings,
      yieldG: yieldG,
      declaredYield: declaredYield,
      yieldAssumed: yieldAssumed,
      ingredientWeight: U.round(ingredientWeight, 1),
      servingG: yieldG > 0 ? U.round(yieldG / servings, 1) : null,
      missingFoodIds: missing
    };
  }

  /** Nutritional contribution of one ingredient, for the recipe editor table. */
  function ingredientNutrition(foodId, grams) {
    var f = CN.foods.byId(foodId);
    if (!f) return null;
    return CN.foods.nutrientsFor(f, grams);
  }

  /* ---------------------------------------------------- recipe as a food ---
     Recipes are presented to the rest of the application through exactly the
     same shape as a food record, so the plan builder, the exchange engine and
     the report writer need no special case for them. */
  var recipeIndex = {};

  /** Register the loaded recipes so they resolve synchronously everywhere. */
  function setRecipeIndex(list) {
    recipeIndex = {};
    (list || []).forEach(function (r) { if (r && r.id) recipeIndex[r.id] = r; });
    return recipeIndex;
  }

  function getRecipe(id) { return recipeIndex[id] || null; }
  function recipes() { return Object.keys(recipeIndex).map(function (k) { return recipeIndex[k]; }); }

  /**
   * A recipe expressed as a food record.
   * Nutrient values are per 100 g of the FINISHED dish, so gram-based portion
   * maths is identical to any other food. One serving is offered as its own
   * household measure, which is how a clinician actually prescribes it.
   */
  function recipeAsFood(recipe) {
    if (!recipe) return null;
    var n = recipeNutrition(recipe);
    if (!(n.yieldG > 0)) return null;   // no basis for a portion
    var per100 = function (v) { return U.round(v / n.yieldG * 100, 2); };
    var servingG = n.servingG || n.yieldG;

    // Allergens are INHERITED from the ingredients. A composite dish is exactly
    // where a hidden allergen hides (brief §8), so a recipe must never look
    // allergen-free merely because its own list is empty.
    var allergenSet = {};
    (recipe.items || []).forEach(function (it) {
      var f = CN.foods.byId(it.foodId);
      if (!f) return;
      (f.allergens || []).forEach(function (a) { allergenSet[a] = true; });
    });
    (recipe.allergens || []).forEach(function (a) { allergenSet[a] = true; });
    var allergens = Object.keys(allergenSet);

    return {
      id: 'recipe:' + recipe.id,
      isRecipe: true,
      recipeId: recipe.id,
      nameEn: recipe.nameEn || 'Recipe',
      nameAr: recipe.nameAr || '',
      category: 'dishes',
      categoryAr: CN.foods.categoryLabel('dishes'),
      isEgyptian: false,
      // An assumed yield, or an ingredient that could not be resolved, makes the
      // figure uncertain — so it is flagged rather than presented as exact.
      needsVerify: n.yieldAssumed || n.missingFoodIds.length > 0,
      allergens: allergens,
      kcal: per100(n.total.kcal),
      protein: per100(n.total.protein),
      carb: per100(n.total.carb),
      fat: per100(n.total.fat),
      fiber: per100(n.total.fiber),
      sodium: per100(n.total.sodium),
      sugar: 0,
      source: 'Clinic recipe',
      yieldG: n.yieldG,
      yieldAssumed: n.yieldAssumed,
      servings: n.servings,
      servingG: servingG,
      portions: [
        { measure: 'serving', measureAr: 'حصة', grams: servingG,
          labelEn: 'One serving', labelAr: 'حصة واحدة',
          assumptionNote: 'One serving = ' + servingG + ' g of the finished dish.' },
        { measure: 'g', measureAr: 'جرام', grams: 100, labelEn: 'Weighed (100 g)',
          assumptionNote: 'Grams of the finished dish.' }
      ]
    };
  }

  /** Resolve a food OR a recipe by id. Recipes carry a `recipe:` prefix. */
  function resolveFood(id) {
    if (!id) return null;
    var s = String(id);
    if (s.indexOf('recipe:') === 0) {
      var r = getRecipe(s.slice(7));
      return r ? recipeAsFood(r) : null;
    }
    return CN.foods.byId(s);
  }

  /**
   * Resolve a plan item's display name. Food is looked up live, falling back to
   * the name snapshot taken when the item was created.
   */
  function itemName(item, lang) {
    var food = item && item.foodId ? resolveFood(item.foodId) : null;
    if (food) return lang === 'ar' ? (food.nameAr || food.nameEn) : food.nameEn;
    if (!item) return '';
    return lang === 'ar' ? (item.labelAr || item.label || item.foodId)
                         : (item.label || item.foodId);
  }

  CN.planner = {
    buildRestrictions: buildRestrictions,
    recipeNutrition: recipeNutrition,
    ingredientNutrition: ingredientNutrition,
    setRecipeIndex: setRecipeIndex,
    getRecipe: getRecipe,
    recipes: recipes,
    recipeAsFood: recipeAsFood,
    resolveFood: resolveFood,
    itemName: itemName,
    approachRules: approachRules,
    roundPortion: roundPortion,
    sumItems: sumItems,
    generate: generate,
    recalc: recalc,
    recalcItem: recalcItem,
    adherenceToTarget: adherenceToTarget,
    suggestSwaps: suggestSwaps,
    applySwap: applySwap,
    addMeal: addMeal,
    removeMeal: removeMeal,
    addItem: addItem,
    removeItem: removeItem,
    setItemGrams: setItemGrams,
    restrictionViolations: restrictionViolations,
    diff: diff,
    toTemplate: toTemplate,
    fromTemplate: fromTemplate
  };
})();

/* ==========================================================================
   NutriClinic Pro — store.js
   Persistence with two interchangeable adapters:

     indexedDB  — persistent, the normal case when served over http(s)
     memory     — automatic fallback, e.g. when opened from file:// where
                  Chromium blocks IndexedDB on opaque origins

   The rest of the application is unaware of which adapter is active. The
   Settings screen surfaces the active engine and warns when data is
   session-only, because silently losing records would be unacceptable in a
   clinical context.
   ========================================================================== */
(function () {
  'use strict';
  var CN = window.CN = window.CN || {};
  var U = CN.util;

  var DB_NAME = 'nutriclinic_pro';
  var DB_VERSION = 2;
  var STORES = ['patients', 'measurements', 'labs', 'assessments', 'plans', 'followups',
    'templates', 'settings', 'attachments', 'recipes', 'kb'];

  var localBackend = null;     // browser storage: indexeddb | localstorage | memory
  var remoteBackend = null;    // optional Supabase adapter (clinical data only)
  var engineName = 'memory';   // 'indexeddb' | 'localstorage' | 'memory'
  var readyPromise = null;

  /**
   * Which adapter serves a given store.
   *
   * Settings stay LOCAL even when a backend is connected: they are device
   * preferences — language, report template, storage overrides — and silently
   * sharing them across a clinic would be surprising.
   */
  function backendFor(name) {
    if (remoteBackend && name !== 'settings') return remoteBackend;
    return localBackend;
  }

  /* ------------------------------------------------------ binary helpers --- */
  /**
   * Attachment binaries are encoded for the backup. A backup that quietly drops
   * the documents is not a backup, so the payload travels with the record; the
   * encoder is explicit and reversible rather than lossy.
   */
  function blobToDataUrl(blob) {
    return new Promise(function (res, rej) {
      var r = new FileReader();
      r.onload = function () { res(String(r.result)); };
      r.onerror = function () { rej(r.error); };
      r.readAsDataURL(blob);
    });
  }

  /** Exact inverse of blobToDataUrl. Returns null on malformed input. */
  function dataUrlToBlob(dataUrl) {
    var m = /^data:([^;,]*);base64,(.*)$/.exec(String(dataUrl || ''));
    if (!m) return null;
    try {
      var bin = atob(m[2]);
      var bytes = new Uint8Array(bin.length);
      for (var i = 0; i < bin.length; i++) bytes[i] = bin.charCodeAt(i);
      return new Blob([bytes], { type: m[1] || 'application/octet-stream' });
    } catch (e) {
      return null;
    }
  }

  /* ------------------------------------------------- localstorage adapter ---
     Used when IndexedDB is unavailable — notably on file:// origins in
     Chromium, which is exactly what happens when index.html is double-clicked.
     Records then survive a reload, which is what makes the delivered file
     genuinely usable without a server.

     localStorage is capped at a few megabytes, so attachment binaries are
     encoded only while they fit a budget. Past that the record is kept WITHOUT
     its content and marked as such, rather than failing silently. */
  function LocalStorageAdapter() {
    var PREFIX = 'cn.store.';
    var BLOB_BUDGET_BYTES = 3 * 1024 * 1024;

    function read(s) {
      try {
        var raw = localStorage.getItem(PREFIX + s);
        if (!raw) return [];
        var v = JSON.parse(raw);
        return Array.isArray(v) ? v : [];
      } catch (e) { return []; }
    }

    function write(s, rows) {
      try { localStorage.setItem(PREFIX + s, JSON.stringify(rows)); return true; }
      catch (e) { return false; }
    }

    function encode(s, rows) {
      if (s !== 'attachments') return Promise.resolve(rows);
      var used = 0;
      return Promise.all(rows.map(function (r) {
        if (!r.blob) return r;
        var est = Math.ceil((r.blob.size || 0) * 4 / 3);
        if (used + est > BLOB_BUDGET_BYTES) {
          var dropped = Object.assign({}, r);
          delete dropped.blob;
          dropped.contentIncluded = false;
          return dropped;
        }
        used += est;
        return blobToDataUrl(r.blob).then(function (d) {
          var copy = Object.assign({}, r);
          delete copy.blob;
          copy.dataUrl = d;
          copy.contentIncluded = true;
          return copy;
        }).catch(function () {
          var meta = Object.assign({}, r);
          delete meta.blob;
          meta.contentIncluded = false;
          return meta;
        });
      }));
    }

    function decode(s, rows) {
      if (s !== 'attachments') return rows;
      return rows.map(function (r) {
        if (!r.dataUrl) return r;
        var copy = Object.assign({}, r);
        copy.blob = dataUrlToBlob(r.dataUrl);
        delete copy.dataUrl;
        return copy;
      });
    }

    return {
      name: 'localstorage',
      all(s) { return Promise.resolve(decode(s, read(s))); },
      get(s, id) {
        var row = read(s).filter(function (r) { return r.id === id; })[0];
        return Promise.resolve(row ? decode(s, [row])[0] : null);
      },
      put(s, obj) {
        var rows = read(s);
        var i = rows.findIndex(function (r) { return r.id === obj.id; });
        var next = rows.slice();
        if (i === -1) next.push(obj); else next[i] = obj;
        return encode(s, next).then(function (encoded) {
          if (write(s, encoded)) return obj;
          // Quota exhausted: retry with every attachment payload stripped.
          var stripped = encoded.map(function (r) {
            if (s !== 'attachments' || !r.dataUrl) return r;
            var m = Object.assign({}, r);
            delete m.dataUrl;
            m.contentIncluded = false;
            return m;
          });
          if (write(s, stripped)) return obj;
          return Promise.reject(new Error(
            'Browser storage is full, so this record could not be saved. ' +
            'Launch NutriClinic Pro with the included start script for unrestricted storage.'));
        });
      },
      del(s, id) {
        write(s, read(s).filter(function (r) { return r.id !== id; }));
        return Promise.resolve(true);
      },
      clear(s) { write(s, []); return Promise.resolve(true); },
      wipe() { STORES.forEach(function (s) { write(s, []); }); return Promise.resolve(true); },
      raw() {
        var out = {};
        STORES.forEach(function (s) { out[s] = decode(s, read(s)); });
        return Promise.resolve(out);
      },
      load(snapshot) {
        return Promise.all(STORES.map(function (s) {
          return encode(s, snapshot[s] || []).then(function (rows) { write(s, rows); });
        })).then(function () { return true; });
      }
    };
  }

  /* ------------------------------------------------------ memory adapter --- */
  /**
   * Clone that PRESERVES binary payloads.
   * JSON-based cloning silently reduces a File/Blob to {} — which would look
   * like a successful write while destroying the document. Blobs are therefore
   * carried by reference and everything else is deep-copied.
   */
  function cloneValue(v) {
    if (v === null || typeof v !== 'object') return v;
    if (typeof Blob !== 'undefined' && v instanceof Blob) return v;   // File extends Blob
    if (Array.isArray(v)) return v.map(cloneValue);
    var out = {};
    Object.keys(v).forEach(function (k) { out[k] = cloneValue(v[k]); });
    return out;
  }

  function MemoryAdapter() {
    var data = {};
    STORES.forEach(function (s) { data[s] = []; });
    return {
      name: 'memory',
      all(s) { return Promise.resolve(cloneValue(data[s] || [])); },
      get(s, id) {
        var row = (data[s] || []).filter(function (r) { return r.id === id; })[0];
        return Promise.resolve(row ? cloneValue(row) : null);
      },
      put(s, obj) {
        data[s] = data[s] || [];
        var i = data[s].findIndex(function (r) { return r.id === obj.id; });
        if (i === -1) data[s].push(cloneValue(obj));
        else data[s][i] = cloneValue(obj);
        return Promise.resolve(obj);
      },
      del(s, id) {
        data[s] = (data[s] || []).filter(function (r) { return r.id !== id; });
        return Promise.resolve(true);
      },
      clear(s) { data[s] = []; return Promise.resolve(true); },
      wipe() { STORES.forEach(function (s) { data[s] = []; }); return Promise.resolve(true); },
      raw() { return cloneValue(data); },
      load(snapshot) {
        STORES.forEach(function (s) { data[s] = (snapshot[s] || []).slice(); });
        return Promise.resolve(true);
      }
    };
  }

  /* --------------------------------------------------- indexeddb adapter --- */
  function openIDB() {
    return new Promise(function (resolve, reject) {
      var settled = false;
      function fail(e) { if (!settled) { settled = true; reject(e); } }
      try {
        if (!window.indexedDB) return fail(new Error('IndexedDB unavailable'));
        var req = indexedDB.open(DB_NAME, DB_VERSION);
        req.onupgradeneeded = function (ev) {
          var db = ev.target.result;
          STORES.forEach(function (s) {
            if (db.objectStoreNames.contains(s)) return;
            var os = db.createObjectStore(s, { keyPath: 'id' });
            if (s !== 'settings' && s !== 'templates') {
              try { os.createIndex('patientId', 'patientId', { unique: false }); } catch (e) { /* optional */ }
            }
          });
        };
        req.onsuccess = function (ev) { if (!settled) { settled = true; resolve(ev.target.result); } };
        req.onerror = function (ev) { fail((ev.target && ev.target.error) || new Error('open failed')); };
        req.onblocked = function () { fail(new Error('blocked by another tab')); };
        // Some environments neither succeed nor error; do not hang the app.
        setTimeout(function () { fail(new Error('IndexedDB open timed out')); }, 2500);
      } catch (e) { fail(e); }
    });
  }

  function tx(db, store, mode) {
    return db.transaction(store, mode).objectStore(store);
  }

  function wrap(req) {
    return new Promise(function (res, rej) {
      req.onsuccess = function () { res(req.result); };
      req.onerror = function () { rej(req.error); };
    });
  }

  function IndexedDbAdapter(db) {
    return {
      name: 'indexeddb',
      all(s) { return wrap(tx(db, s, 'readonly').getAll()); },
      get(s, id) { return wrap(tx(db, s, 'readonly').get(id)); },
      put(s, obj) { return wrap(tx(db, s, 'readwrite').put(obj)).then(function () { return obj; }); },
      del(s, id) { return wrap(tx(db, s, 'readwrite').delete(id)); },
      clear(s) { return wrap(tx(db, s, 'readwrite').clear()); },
      wipe() {
        return Promise.all(STORES.map(function (s) {
          return wrap(tx(db, s, 'readwrite').clear());
        }));
      },
      raw() {
        var out = {};
        return STORES.reduce(function (p, s) {
          return p.then(function () {
            return wrap(tx(db, s, 'readonly').getAll()).then(function (rows) { out[s] = rows; });
          });
        }, Promise.resolve()).then(function () { return out; });
      },
      load(snapshot) {
        return Promise.all(STORES.map(function (s) {
          var os = tx(db, s, 'readwrite');
          return wrap(os.clear()).then(function () {
            return Promise.all((snapshot[s] || []).map(function (row) {
              return wrap(os.put(row));
            }));
          });
        }));
      }
    };
  }

