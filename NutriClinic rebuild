      updateBmi();

      /* ---- save ---- */
      U.on(host, 'click', '#p-save', function () {
        var name = (U.$('#p-name').value || '').trim();
        if (!name) { CN.toast(L('new.needName'), 'alert'); U.$('#p-name').focus(); return; }

        CN.store.all('patients').then(function (all) {
          var code = (U.$('#p-code').value || '').trim() ||
            (existing && existing.code) || NewPatient.nextCode(all);

          var record = Object.assign({}, existing || {}, {
            id: existing ? existing.id : U.uid('pat'),
            name: name,
            code: code,
            sex: U.$('#p-sex').value,
            dob: U.$('#p-dob').value,
            phone: U.$('#p-phone').value,
            email: U.$('#p-email').value,
            occupation: U.$('#p-occupation').value,
            goal: U.$('#p-goal').value,
            registeredAt: (existing && existing.registeredAt) || U.todayISO(),
            conditions: (U.$('#p-conditions').value || '').split(';').map(function (s) { return s.trim(); }).filter(Boolean),
            medications: U.$('#p-medications').value,
            supplements: U.$('#p-supplements').value,
            surgeries: U.$('#p-surgeries').value,
            familyHistory: U.$('#p-familyHistory').value,
            giNotes: U.$('#p-giNotes').value,
            pregnancy: U.$('#p-pregnancy').value,
            notes: U.$('#p-notes').value,
            restrictions: restrictions,
            custom: (function () {
              // Values for whatever fields the clinic defined in Settings.
              var out = {};
              U.$$('[data-cf]', host).forEach(function (el) {
                var v = el.value;
                if (v !== '' && v !== null && v !== undefined) out[el.getAttribute('data-cf')] = v;
              });
              return out;
            })(),
            lifestyle: {
              activity: U.$('#l-activity').value, exercise: U.$('#l-exercise').value,
              sleep: U.$('#l-sleep').value, smoking: U.$('#l-smoking').value,
              water: U.$('#l-water').value, meals: U.$('#l-meals').value,
              preferences: U.$('#l-preferences').value, disliked: U.$('#l-disliked').value,
              cultural: U.$('#l-cultural').value, budget: U.$('#l-budget').value,
              cooking: U.$('#l-cooking').value, eatingHabits: U.$('#l-eatingHabits').value
            }
          });

          CN.store.put('patients', record).then(function () {
            var height = U.parseNum(U.$('#m-heightCm').value);
            var weight = U.parseNum(U.$('#m-weightKg').value);
            var chain = Promise.resolve();
            // Only write a measurement when there is something to record.
            if (height || weight) {
              var m = {
                id: U.uid('mea'), patientId: record.id, measuredAt: U.todayISO(),
                heightCm: height, weightKg: weight,
                targetWeightKg: U.parseNum(U.$('#m-targetWeightKg').value),
                waistCm: U.parseNum(U.$('#m-waistCm').value),
                hipCm: U.parseNum(U.$('#m-hipCm').value),
                bodyFatPct: U.parseNum(U.$('#m-bodyFatPct').value),
                muscleMassKg: U.parseNum(U.$('#m-muscleMassKg').value),
                visceralFat: U.parseNum(U.$('#m-visceralFat').value),
                totalBodyWaterPct: U.parseNum(U.$('#m-totalBodyWaterPct').value),
                source: 'clinic_scale', notes: existing ? 'Updated from patient record.' : 'Baseline.'
              };
              chain = CN.store.put('measurements', m);
            }
            return chain;
          }).then(function () {
            CN.toast(L('new.created'));
            CN.bus.emit('data', { action: 'patient-saved' });
            CN.app.openPatient(record.id, 'assessment');
          });
        });
      });

      U.on(host, 'click', '[data-go]', function (e, el) { CN.app.go(el.getAttribute('data-go')); });
    }
