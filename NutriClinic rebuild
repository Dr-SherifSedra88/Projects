          ' L' + attr(x3) + ' ' + attr(y3) +
          ' A' + r + ' ' + r + ' 0 ' + large + ' 0 ' + attr(x4) + ' ' + attr(y4) + ' Z">' +
          '<title>' + esc(s.label + ': ' + s.value) + '</title></path>');
      }
      angle = a2;
    });

    if (cfg.centerValue !== undefined) {
      out.push('<text x="' + cx + '" y="' + (cy - 2) + '" text-anchor="middle" ' +
        'style="font:600 20px var(--sans);fill:#14213D">' + esc(cfg.centerValue) + '</text>');
    }
    if (cfg.centerLabel) {
      out.push('<text x="' + cx + '" y="' + (cy + 16) + '" text-anchor="middle" ' +
        'style="font:400 11px var(--sans);fill:#6B7280">' + esc(cfg.centerLabel) + '</text>');
